{
  "servers": {
    "context-alt-text": {
      "command": "agent-handoff-mcp",
      "args": [
        "--workspace-root",
        "${workspaceFolder}",
        "serve-stdio"
      ],
      "env": {
        "PATH": "${env:PYENV_ROOT}/bin:${env:PYENV_ROOT}/shims:/usr/local/bin:${env:PATH}",
        "PYENV_ROOT": "${env:PYENV_ROOT}"
      }
    }
  }
}
