classDiagram
    %% Face Clustering Domain Layer
    %% Implementation: subfeature/face-clustering-poc branch
    %% Status: Complete - Local clustering with 512-dim embeddings

    class ClusteringEngine {
        <<interface>>
        +clusterUnknownFaces(faceIds: int[]): array
        +getClusterDetail(clusterId: string): array
        +getClusterSuggestions(clusterId: string): array
        +confirmCluster(clusterId: string, rosterId: string, faceIds: array): array
    }

    class ClusteringService {
        -unknownFaceRepository: UnknownFaceRepository
        -recognitionClient: RecognitionClient
        -rosterClient: RosterClient
        +__construct(repository, recognitionClient, rosterClient)
        +clusterUnknownFaces(faceIds: int[]): array
        +getClusterDetail(clusterId: string): array
        +getClusterSuggestions(clusterId: string): array
        +confirmCluster(clusterId: string, rosterId: string, faceIds: array): array
        -buildLocalResponse(faces: UnknownFace[]): array
        -clusterEmbeddingsLocally(faces: UnknownFace[]): array~string,string[]~
        -normalizeVector(vector: float[]): float[]
        -cosineSimilarity(vec1: float[], vec2: float[]): float
        -resolveEmbeddingVector(face: UnknownFace): float[]
    }

    class UnknownFace {
        <<entity>>
        -id: int|null
        -attachmentId: int
        -bbox: array~x,y,width,height~
        -embeddingId: string|null
        -embeddingVector: float[]|null
        -clusterId: string|null
        -detectedAt: DateTimeInterface
        -resolvedAt: DateTimeInterface|null
        -rosterId: string|null
        +__construct(...)
        +id(): int|null
        +attachmentId(): int
        +bbox(): array
        +embeddingId(): string|null
        +embeddingVector(): float[]|null
        +clusterId(): string|null
        +detectedAt(): DateTimeInterface
        +resolvedAt(): DateTimeInterface|null
        +rosterId(): string|null
    }

    class UnknownFaceRepository {
        -wpdb: wpdb
        -tableName: string
        +__construct(wpdb)
        +saveUnknownFace(attachmentId: int, bbox: array, embeddingId: string, embeddingVector: float[]): int
        +findUnknownFaces(limit: int, offset: int): UnknownFace[]
        +findById(id: int): UnknownFace|null
        +findByClusterId(clusterId: string): UnknownFace[]
        +findUnresolvedWithEmbeddings(minConfidence: float): UnknownFace[]
        +updateClusterId(faceId: int, clusterId: string): bool
        +markAsResolved(faceId: int, rosterId: string): bool
        +countUnresolved(): int
        +countClustered(): int
        +countWithEmbeddings(): int
        -hydrate(row: object): UnknownFace
        -encodeEmbeddingVector(vector: float[]): string
        -decodeEmbeddingVector(json: string): float[]|null
    }

    class UnknownFaceTableInstaller {
        -wpdb: wpdb
        -tableName: string
        +__construct(wpdb)
        +install(): void
        -tableExists(): bool
        -hasEmbeddingVectorColumn(): bool
        -addEmbeddingVectorColumn(): void
    }

    class FaceDetectionJob {
        -recognitionPipeline: FaceDetectionPipeline
        -unknownFaceRepository: UnknownFaceRepository
        -iouThreshold: float
        +__construct(pipeline, repository)
        +execute(attachmentId: int): void
        -hasSimilarFace(existingFaces: UnknownFace[], bbox: array): bool
        -calculateIoU(bbox1: array, bbox2: array): float
    }

    class FaceDetectionPipeline {
        <<interface>>
        +detectFaces(attachmentId: int): array
    }

    class RecognitionServiceFaceDetectionPipeline {
        -recognitionClient: RecognitionClient
        +__construct(client)
        +detectFaces(attachmentId: int): array
    }

    class FaceDetectionQueue {
        <<interface>>
        +enqueueBatch(attachmentIds: int[], priority: string): array
    }

    class SynchronousFaceDetectionQueue {
        -job: FaceDetectionJob
        -clusteringEngine: ClusteringEngine
        +__construct(job, clusteringEngine)
        +enqueueBatch(attachmentIds: int[], priority: string): array
    }

    class ScanController {
        -faceDetectionQueue: FaceDetectionQueue
        +__construct(queue)
        +scan(WP_REST_Request): WP_REST_Response
        -validateRequest(request): void
    }

    class ClusterController {
        -clusteringEngine: ClusteringEngine
        -faceThumbnailProvider: FaceThumbnailProvider
        +__construct(engine, thumbnailProvider)
        +listClusters(WP_REST_Request): WP_REST_Response
        +getClusterDetail(WP_REST_Request): WP_REST_Response
        +getClusterSuggestions(WP_REST_Request): WP_REST_Response
        +confirmCluster(WP_REST_Request): WP_REST_Response
    }

    class FaceThumbnailProvider {
        <<interface>>
        +getThumbnail(attachmentId: int, bbox: array): string|null
    }

    class CachedFaceThumbnailProvider {
        -cacheDir: string
        -targetWidth: int
        -targetHeight: int
        +__construct(cacheDir, width, height)
        +getThumbnail(attachmentId: int, bbox: array): string|null
        -getCacheKey(attachmentId: int, bbox: array): string
        -generateThumbnail(attachmentId: int, bbox: array): string|null
        -cropAndResize(imagePath: string, bbox: array): resource|false
    }

    ClusteringEngine <|.. ClusteringService : implements
    ClusteringService --> UnknownFaceRepository : uses
    ClusteringService --> RecognitionClient : uses
    ClusteringService --> RosterClient : uses
    UnknownFaceRepository --> UnknownFace : creates
    FaceDetectionPipeline <|.. RecognitionServiceFaceDetectionPipeline : implements
    FaceDetectionQueue <|.. SynchronousFaceDetectionQueue : implements
    SynchronousFaceDetectionQueue --> FaceDetectionJob : executes
    SynchronousFaceDetectionQueue --> ClusteringEngine : triggers
    FaceDetectionJob --> FaceDetectionPipeline : uses
    FaceDetectionJob --> UnknownFaceRepository : persists
    ScanController --> FaceDetectionQueue : uses
    ClusterController --> ClusteringEngine : uses
    ClusterController --> FaceThumbnailProvider : uses
    FaceThumbnailProvider <|.. CachedFaceThumbnailProvider : implements

    note for ClusteringService "Algorithm: Single-linkage hierarchical clustering\nSimilarity: Cosine similarity on L2-normalized vectors\nThreshold: 0.45 for merging clusters\nLocal: Handles up to 1000 faces"

    note for UnknownFace "Embedding: 512-dimensional float array\nStorage: JSON in MEDIUMTEXT column (~5KB)\nSource: InsightFace via recognition service"

    note for FaceDetectionJob "IoU threshold: 0.8 for duplicate detection\nExtract embedding from recognition response\nPersist bbox + embedding_vector + embedding_id"

    note for SynchronousFaceDetectionQueue "Triggers clustering after batch completes\nSynchronous execution (no background jobs)\nReturns job_id + queued_count"
