---
title: Recognition Backend - Unified Architecture (InsightFace)
---
flowchart TB
    %% Clients
    subgraph clients["Client Integrations"]
        wp_plugin["Context Alt Text Plugin\nREST client"]
        ops_cli["Ops / CLI scripts"]
        hf_space["Hugging Face Space ingress"]
    end

    %% API Layer
    subgraph api["FastAPI Surface"]
        fastapi_app["FastAPI application\n- lifespan\n- dependency wiring"]
        analyze_route["/api/v0/analyze-scene"]
        embeddings_route["/api/v0/embeddings"]
        roster_route["/api/v0/roster"]
        health_route["/api/v0/service/info\n/api/v0/health\n/api/v0/service/reload-embeddings"]
    end

    %% Domain Services
    subgraph domain["Domain Services"]
        scene_service["SceneAnalysisService"]
        recognition_service["RecognitionService\n(InsightFace adapter)"]
        roster_service["RosterService"]
        startup_manager["StartupManager\n- warmup\n- embedding preload"]
    end

    %% Adapters
    subgraph adapters["Adapters"]
        yolo_adapter["YOLOAdapter"]
        caption_adapter["Phi3CaptionAdapter"]
        recognition_adapter["InsightFaceAdapter\nimplements RecognitionModelPort"]
        embedding_adapter["EmbeddingRouterAdapter"]
        roster_storage["FileRosterStorageAdapter"]
        embedding_storage["EmbeddingStorageAdapter"]
    end

    %% External
    subgraph external["External Dependencies"]
        insightface_weights["InsightFace model weights"]
        yolo_weights["YOLO weights"]
        phi3_weights["Phi-3 weights"]
        roster_files["Embeddings + roster JSON"]
        settings_store["settings.yaml + env vars"]
        gpu_hardware["GPU / CPU runtime"]
    end

    %% Connections
    clients --> fastapi_app
    fastapi_app --> analyze_route
    fastapi_app --> embeddings_route
    fastapi_app --> roster_route
    fastapi_app --> health_route

    analyze_route --> scene_service
    embeddings_route --> recognition_service
    roster_route --> roster_service
    health_route --> recognition_service
    health_route --> startup_manager

    scene_service --> yolo_adapter
    scene_service --> caption_adapter
    scene_service --> recognition_service

    recognition_service --> recognition_adapter
    recognition_service --> embedding_adapter

    startup_manager --> recognition_adapter
    startup_manager --> embedding_adapter

    roster_service --> roster_storage
    roster_service --> embedding_storage

    recognition_adapter --> insightface_weights
    embedding_adapter --> roster_files
    yolo_adapter --> yolo_weights
    caption_adapter --> phi3_weights
    roster_storage --> roster_files
    embedding_storage --> roster_files

    startup_manager --> settings_store
    recognition_service --> settings_store
    scene_service --> settings_store
    roster_service --> settings_store
    recognition_adapter --> gpu_hardware

    classDef clientsClass fill:#e8eaf6,stroke:#3949ab,color:#000,stroke-width:2px
    classDef apiClass fill:#e3f2fd,stroke:#1565c0,color:#000,stroke-width:2px
    classDef domainClass fill:#e8f5e9,stroke:#2e7d32,color:#000,stroke-width:2px
    classDef adapterClass fill:#fff3e0,stroke:#ef6c00,color:#000,stroke-width:2px
    classDef externalClass fill:#fce4ec,stroke:#ad1457,color:#000,stroke-width:2px

    class clients,wp_plugin,ops_cli,hf_space clientsClass
    class api,fastapi_app,analyze_route,embeddings_route,roster_route,health_route apiClass
    class domain,scene_service,recognition_service,roster_service,startup_manager domainClass
    class adapters,yolo_adapter,caption_adapter,recognition_adapter,embedding_adapter,roster_storage,embedding_storage adapterClass
    class external,insightface_weights,yolo_weights,phi3_weights,roster_files,settings_store,gpu_hardware externalClass
