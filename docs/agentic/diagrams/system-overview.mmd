    style Database fill:#fff3e0,stroke:#f57c00,stroke-width:2px,color:#e65100
    style Discovery fill:#f3e5f5,stroke:#6a1b9a,color:#4a148c
    style Assignment fill:#fce4ec,stroke:#ad1457,color:#880e4f
