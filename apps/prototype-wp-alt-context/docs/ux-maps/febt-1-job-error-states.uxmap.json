    { "id": "reload", "verb": "Reload page", "target": "reload-page", "hierarchy": "primary", "costly": false, "irreversible": false, "preview_required": false, "screen_id": "request-error-banner" },
    { "id": "wait-cooldown", "verb": "Wait (countdown)", "target": "request-error-banner", "hierarchy": "secondary", "costly": false, "irreversible": false, "preview_required": false, "screen_id": "request-error-banner" }
