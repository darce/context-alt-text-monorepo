---
title: Recognition Pipeline Components
---
flowchart LR
    subgraph ingestion["Ingestion"]
        analyze_endpoint["/recognition/analyze\nchunked BackgroundTasks"]
        scan["IdentityScanService\nscan_identities()"]
        embed["FaceEmbeddingProvider\nInsightFace 1024D"]
        thumb["ThumbnailService\noptional crops"]
        persist_identity["MediaIdentity + IdentityScanJob\nrows persisted"]
    end

    subgraph orchestrator["Clustering Orchestration"]
        cluster["IdentityClusteringService\ncluster_unclustered_identities()"]
        context_mgr["TenantContextManager\nSET LOCAL app.current_tenant\nrefresh MV"]
        repo["ClusterRepository\nunclustered ids + centroids\njob records"]
        rep_matcher["RepresentativeMatcher\ncomplete-link guard + suggestions"]
        validator["ClusterValidator\nmember/threshold checks"]
        rep_manager["RepresentativeManager\nstores representative embeddings"]
        factory["ClusterFactory\ncreates clusters + centroids"]
        assigner["ClusterAssigner\nwrites IdentityMember"]
        suggestions["SuggestionService\npending queue + priority"]
        batch["BatchClusteringProcessor\ncentroid match + graph/HDBSCAN"]
        jobs["ClusteringJobService\nsync vs async jobs"]
    end

    note top of rep_matcher
        Complete-Link Guard:
        1. Query ALL cluster reps
        2. min_sim >= 0.80 (Floor)
        3. avg_sim >= 0.88 (Avg)
        Prevents lookalike snowballing
    end note

    subgraph algorithms["Graph/Density Algorithms"]
        rep_only["RepresentativeOnlyClustering\ncold-start chunk"]
        hdbscan["HDBSCANClustering\n<= hdbscan_max_batch_size"]
        chinese_whispers["ChineseWhispersClustering\nlarge batches"]
    end

    subgraph persistence["Persistence"]
        pg["PostgreSQL + pgvector\nidentities, clusters, reps, members,\nsuggestions, jobs, centroids MV"]
    end

    analyze_endpoint --> scan
    scan --> embed
    embed --> scan
    scan --> thumb
    scan --> persist_identity
    persist_identity --> pg

    cluster --> context_mgr
    cluster --> repo
    cluster --> factory
    cluster --> rep_matcher
    cluster --> batch
    cluster --> jobs
    cluster --> suggestions

    rep_matcher --> validator
    rep_matcher --> rep_manager
    rep_matcher --> assigner
    rep_matcher --> suggestions

    batch --> assigner
    batch --> rep_manager
    batch --> validator
    batch --> factory
    batch --> repo
    batch --> rep_only
    batch --> hdbscan
    batch --> chinese_whispers

    assigner --> pg
    rep_manager --> pg
    repo --> pg
    suggestions --> pg
    jobs --> repo
    context_mgr --> pg
