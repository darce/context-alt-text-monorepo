{
  "name": "darce/alt-context",
  "description": "A WordPress plugin that generates contextually relevant alt text for images using AI-powered recognition services.",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=8.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "AltContext\\": "src/"
    },
    "classmap": [
      "src/"
    ]
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "^6.8",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload-dev": {
    "psr-4": {
      "AltContext\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test:unit": "vendor/bin/phpunit --testsuite Unit",
    "cs-check": "vendor/bin/phpcs --standard=WordPress src tests alt-context.php",
    "cs-fix": "vendor/bin/phpcbf --standard=WordPress src tests alt-context.php"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
