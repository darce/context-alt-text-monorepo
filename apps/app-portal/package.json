{
  "name": "app-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AltContext customer account SPA (Clerk person session; tenant from GET /portal/me)",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.json\" \"*.ts\" \"*.html\" \"README.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.json\" \"*.ts\" \"*.html\" \"README.md\""
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=11"
  },
  "dependencies": {
    "@clerk/react": "^6.16.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
