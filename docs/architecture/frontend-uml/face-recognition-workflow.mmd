flowchart TD
%% Remote Face Recognition Workflow (Oct 2025)
%% Frontend consumes server-side detection, clustering, and suggestions

subgraph Frontend
	A[FaceScanActions<br/>Editor clicks 'Scan for Faces']
	B[UnknownPeoplePanel<br/>useUnknownClusters]
	C[ClusterDetailView<br/>useClusterDetail]
	D[useClusterSuggestions]
	E[ClusterConfirmationModal]
end

subgraph WordPress
	F[/POST /cat/v1/recognition/scan/]
	G[/GET /cat/v1/clusters/]
	H[/GET /cat/v1/clusters/&#123;id&#125;/]
	I[/GET /cat/v1/clusters/&#123;id&#125;/suggestions/]
	J[/POST /cat/v1/clusters/&#123;id&#125;/confirm/]
	K[ScanController<br/>enqueueBatch]
	L[ClusterController<br/>list/detail]
	M[SuggestionController]
	N[ConfirmController]
	O[UnknownFaceRepository]
end

subgraph RecognitionService
	P[Detect & Embed Faces]
	Q[Cluster Unknown Faces]
	R[Generate Roster Suggestions]
	S[Ingest Confirmed Embeddings]
end

A --> F
F --> K
K --> P
P --> Q
Q --> O
O --> L
L --> G
B --> G
G --> B

C --> H
