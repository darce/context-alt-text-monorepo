%% Context Alt Text Admin SPA Module Map (MVP + Planned)
graph TD
	entry[main.tsx] --> app[App.tsx]
	app --> providers["Providers<br/>(QueryClientProvider + RouterProvider)"]
	providers --> layout[ApplicationLayout]

	subgraph Routes
		dashboardRoute["/dashboard"]
		workbenchRoute["/workbench"]
		rosterRoute["/roster"]
	end

	layout --> dashboardRoute
	layout --> workbenchRoute
	layout --> rosterRoute

	subgraph Dashboard
		hero[HeroStatusSection]
		coverage[CoverageCard]
		activity[ActivityCard]
		recognitionWidget[RecognitionInsightsCard]
		automationWidget[AutomationPipelineCard]
		actions[ActionFooter]
	end

	dashboardRoute --> hero
	dashboardRoute --> coverage
	dashboardRoute --> activity
	dashboardRoute --> recognitionWidget
	dashboardRoute --> automationWidget
	dashboardRoute --> actions

	subgraph Workbench
		queueHook[useWorkbenchMedia]
		selection[SelectionToolbar]
		recognitionActions[RecognitionActionsPanel]
		bulk[BulkAltTextPanel]
	end

	workbenchRoute --> queueHook
	workbenchRoute --> selection
	workbenchRoute --> recognitionActions
	workbenchRoute --> bulk

	subgraph RosterManager
		rosterHook[useRoster]
		observationsHook[useRecognitionObservations]
		observationPanel[RosterObservationsPanel]
		rosterDialogs[RosterForm + Dialogs]
	end

	rosterRoute --> rosterHook
	rosterRoute --> observationsHook
	rosterRoute --> observationPanel
	rosterRoute --> rosterDialogs

	subgraph DataLayer
		queryClient[QueryClient]
		coverageHook[useCoverageMetrics]
		workbenchHook[useWorkbenchMedia]
		observationsHook2[useRecognitionObservations]
		rosterClient[RosterRestClient]
	end

	providers --> queryClient
	coverageHook --> queryClient
	workbenchHook --> queryClient
	observationsHook2 --> queryClient
	rosterHook --> rosterClient
	observationsHook --> observationsHook2

	subgraph REST
		dashboardApi["context-alt-text/v1/dashboard/*"]
		recognitionApi["context-alt-text/v1/recognition/*"]
		rosterApi["context-alt-text/v1/roster/*"]
		observationApi["cat/v1/observations"]
	end

	coverageHook --> dashboardApi
	workbenchHook --> dashboardApi
	observationsHook2 --> observationApi
	recognitionActions --> recognitionApi
	rosterClient --> rosterApi
	observationPanel --> observationApi

	note["Keyboard accessibility helpers wrap ApplicationLayout; analytics hooks live with widgets."]
	layout -. "focus+analytics" .-> note
