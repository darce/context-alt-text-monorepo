        { "id": "error-action", "label": "Recovery action", "role": "action", "states": ["http", "parse", "auth_expired", "nonce_refresh", "transport", "unknown"] }
      ]
    },
    {
      "id": "reload-page",
      "kind": "exit",
      "title": "Reload page (session expired)",
