classDiagram
    class AltTextService {
      +composePrompt(SceneAnalysisResult, Policy): Prompt
      +generateDraft(AttachmentId): AltTextDraft
    }

    class RecognitionClient {
      +analyzeScene(AnalyzeSceneRequest): SceneAnalysisResult
      +embeddings(EmbeddingsRequest): EmbeddingsResponse
      +reloadEmbeddings(): Status
      +serviceInfo(): ServiceInfo
    }

    class RosterService {
      +syncFromRemote(): SyncReport
      +createOrUpdateEntry(RosterEntry): RemoteId
      +addReferenceImage(RemoteId, AttachmentId): EmbeddingId
      +exists(label, type, excludeId): bool
      +createAndSync(data, options): RosterEntry
    }

    class RecognitionJobService {
      +analyzeAttachment(AttachmentId): RecognitionJob
      +getJobStatus(JobId): JobStatus
      +persistObservations(AttachmentId, SceneAnalysisResult): void
      +handleRecognitionResult(JobId, Result): void
    }

    class RosterObservationManager {
      +recordObservation(AttachmentId, FaceDetection): ObservationId
      +autoAssignPending(RemoteId): int
      +assignObservation(ObservationId, RemoteId): bool
      +dismissObservation(ObservationId): bool
      +listPendingObservations(filters): Observation[]
    }

    class ObservationRepository {
      +recordMatch(AttachmentId, RemoteId, Confidence): void
      +listForAttachment(AttachmentId): Observation[]
      +updateObservation(ObservationId, payload): bool
      +queryObservations(filters): Observation[]
      +persistObservations(AttachmentId, observations): void
    }

    class SettingsRepository {
      +getRecognitionConfig(): RecognitionConfig
      +saveRecognitionConfig(RecognitionConfig): void
    }

    AltTextService --> RecognitionClient : uses
    AltTextService --> RecognitionJobService : delegates
    RecognitionJobService --> RecognitionClient : invokes API
    RecognitionJobService --> ObservationRepository : persists results
    RecognitionJobService --> RosterObservationManager : creates observations
    RosterService --> RecognitionClient : HTTP sync
    RosterService --> ObservationRepository : queries matches
    RosterObservationManager --> ObservationRepository : CRUD operations
    RosterObservationManager --> RosterService : links roster entries
    RecognitionClient --> SettingsRepository : reads config
