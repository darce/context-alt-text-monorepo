---
title: Shared Infrastructure Components
---
classDiagram
    class ConfigService {
        <<singleton>>
        -Dict~str,Any~ _config
        -Dict~str,Any~ _cache
        -threading.RLock _lock
        +get(key: str, default: Any) Any
        +get_section(name: str) Dict~str,Any~
        +reload() None
    }

    class SettingsLoader {
        <<module>>
        +load(path: str) Dict~str,Any~
        +env_override(data: Dict~str,Any~) Dict~str,Any~
    }

    class GPUInfo {
        +str name
        +Tuple~int,int~ compute_capability
        +float memory_gb
        +bool cuda_available
        +bool mps_available
    }

    class DeviceInfo {
        +str best_device
        +bool cuda_available
        +bool mps_available
        +Optional~GPUInfo~ gpu
    }

    class GPUManager {
        <<singleton>>
        +get_device_info() DeviceInfo
        +clear_gpu_memory_cache()
    }

    class StartupMetrics {
        +float total_time
        +float adapter_creation_time
        +Dict~str,float~ phase_durations
    }

    class StartupConfig {
        +bool background_initialization
        +bool warmup_enabled
        +bool auto_reload_embeddings
        +int timeout_seconds
    }

    class StartupManager {
        -StartupPhase current_phase
        -StartupConfig config
        -StartupMetrics metrics
        +initialize()
        +get_metrics() StartupMetrics
        +is_complete() bool
    }

    class StartupPhase {
        <<enumeration>>
        IDLE
        ENVIRONMENT_SETUP
        MODEL_WARMUP
        ADAPTER_CREATION
        COMPLETED
        FAILED
    }

    ConfigService --> SettingsLoader : loads
    GPUManager *-- DeviceInfo
    DeviceInfo *-- GPUInfo
    StartupManager *-- StartupConfig
    StartupManager *-- StartupMetrics
    StartupManager *-- StartupPhase
    StartupManager --> ConfigService : uses
    StartupManager --> GPUManager : uses

    note for ConfigService "Thread-safe configuration cache (settings.yaml + env)"
    note for StartupManager "Coordinates warmup for InsightFace + embeddings"
