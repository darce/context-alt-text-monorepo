+            return
+        except DBAPIError as exc:
+            code = getattr(exc.orig, "sqlstate", None) or getattr(exc.orig, "pgcode", None)
+            if code != "55P03" or attempt + 1 == _MATVIEW_LOCK_ATTEMPTS:
+                raise
+            time.sleep(0.25 * (2**attempt) + random.uniform(0, 0.25))
+
