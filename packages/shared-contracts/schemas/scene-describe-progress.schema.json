{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://context-alt-text.dev/schemas/scene-describe-progress.schema.json",
  "title": "Scene Describe Progress Event",
  "description": "SSE progress payload for async scene describe runs.",
  "type": "object",
  "required": [
    "type",
    "run_id",
    "tenant_id",
    "status",
    "completed",
    "total",
    "phase",
    "desc",
    "gpu_state"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "describe_progress"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "running", "completed", "completed_with_errors", "failed", "cancelled"]
    },
    "completed": {
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "type": "string",
      "enum": ["queued", "describing", "complete", "failed", "cancelled"]
    },
    "desc": {
      "type": ["string", "null"]
    },
    "gpu_state": {
      "type": "null",
      "description": "Reserved for future self-hosted GPU execution state."
    }
  },
  "additionalProperties": false
}
