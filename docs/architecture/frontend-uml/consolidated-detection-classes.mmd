classDiagram
%% v2 Consolidated Face Detection - Frontend Classes
%% Aligns with CONSOLIDATED_FACE_DETECTION_PLAN.md Section 3.4

class DetectedFaceFE {
  +faceId: string
  +bbox: BoundingBox
  +attachmentId: number
  +clusterId: string | null
  +suggestions: Suggestion[]
  +labelDraft: Label | null
  +confidence: number
}

class BoundingBox {
  +x: number
  +y: number
  +width: number
  +height: number
}

class Label {
  +rosterId?: string
  +newName?: string
}

class Suggestion {
  +rosterId: string
  +display: string
  +score: number
  +avatarUrl?: string
}

class PeopleOverlay {
  +faces: DetectedFaceFE[]
  +selectedFaceIndex: number | null
  +onFaceClick: function
  +onLabelSubmit: function
  +showConfidence: boolean
  +renderFaceChip()
  +openPeoplePicker()
}

class PeopleDrawer {
  +clusters: FaceCluster[]
  +suggestions: SuggestionStack[]
  +onBulkConfirm: function
  +onReassign: function
  +renderClusterStack()
  +renderSuggestionStack()
}

class FaceCluster {
  +clusterId: string
  +faces: DetectedFaceFE[]
  +representativeFace: DetectedFaceFE
  +count: number
}

class SuggestionStack {
  +rosterId: string
  +display: string
  +faces: DetectedFaceFE[]
  +count: number
  +avgScore: number
}

class PeoplePicker {
  +searchQuery: string
  +rosterResults: RosterPerson[]
  +onSelect: function
  +onCreateNew: function
  +renderTypeahead()
}

class FaceObservation {
  +id: bigint
  +attachmentId: bigint
  +bboxX: number
  +bboxY: number
  +bboxW: number
  +bboxH: number
  +clusterGroupId: string | null
  +suggestedRosterId: string | null
  +suggestedScore: number | null
  +labelStatus: enum
  +createdAt: datetime
}

class RosterPerson {
  +id: string
  +displayName: string
  +aliases: string[]
  +avatarUrl: string | null
  +meta: object
  +createdAt: datetime
}

class ObservationEmbedding {
  +observationId: bigint
  +model: string
  +vec: blob
  +createdAt: datetime
}

DetectedFaceFE --> BoundingBox
DetectedFaceFE --> Label
DetectedFaceFE --> Suggestion
PeopleOverlay --> DetectedFaceFE
PeopleOverlay --> PeoplePicker
PeopleDrawer --> FaceCluster
PeopleDrawer --> SuggestionStack
FaceCluster --> DetectedFaceFE
SuggestionStack --> DetectedFaceFE
PeoplePicker --> RosterPerson
FaceObservation --> ObservationEmbedding
FaceObservation --> RosterPerson : confirmed_roster_id
