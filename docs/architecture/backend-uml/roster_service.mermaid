---
title: Roster Service Domain (File-backed Storage)
---
classDiagram
    class RosterImage {
        +List~float~ embedding
        +Dict~str,Any~ metadata
        +Optional~str~ image_path
        +to_dict()
        +from_dict(data)
    }

    class RosterEntry {
        +str unique_id
        +str label
        +str type
        +List~RosterImage~ reference_images
        +Optional~List~float~~ aggregate_embedding
        +Dict~str,Any~ metadata
        +datetime created_at
        +datetime updated_at
        +add_reference_image(image: RosterImage)
        +image_count() int
        +to_dict()
        +from_dict(data)
    }

    class RosterMatch {
        +RosterEntry entry
        +float similarity
        +float threshold
        +bool meets_threshold()
        +to_dict()
    }

    class RosterStoragePort {
        <<interface>>
        +save_entry(entry: RosterEntry) bool
        +load_entries() List~RosterEntry~
        +get_entry(unique_id: str) Optional~RosterEntry~
        +delete_entry(unique_id: str) bool
        +get_stats() Dict~str,Any~
    }

    class EmbeddingStorePort {
        <<interface>>
        +save_embeddings(entries: List~RosterEntry~)
        +load_embeddings() List~Dict~str,Any~~
        +watch(callback) bool
    }

    class DataValidationPort {
        <<interface>>
        +validate_entry(data: Dict~str,Any~) List~str~
        +validate_embedding(embedding: List~float~) List~str~
    }

    class FileRosterStorageAdapter {
        -Path data_dir
        +save_entry(entry: RosterEntry) bool
        +load_entries() List~RosterEntry~
        +get_entry(unique_id: str)
        +delete_entry(unique_id: str)
        +get_stats()
        -_load_file() List~Dict~str,Any~~
        -_write_file(entries: List~RosterEntry~)
    }

    class EmbeddingStorageAdapter {
        -Path embeddings_path
        +save_embeddings(entries: List~RosterEntry~)
        +load_embeddings()
        +watch(callback)
    }

    class DataValidationAdapter {
        +validate_entry(data)
        +validate_embedding(embedding)
    }

    class RosterService {
        -RosterStoragePort roster_storage
        -EmbeddingStorePort embedding_storage
        -DataValidationPort validator
        +add_entry(label: str, type: str, embedding: List~float~, metadata) RosterEntry
        +list_entries() List~RosterEntry~
        +find_matches(embedding: List~float~, threshold: float) List~RosterMatch~
        +update_entry(unique_id: str, **updates) Optional~RosterEntry~
        +delete_entry(unique_id: str) bool
        +stats() Dict~str,Any~
    }

    class RosterRouter {
        +create_entry(request)
        +list_entries()
        +get_entry(unique_id: str)
        +update_entry(unique_id: str, request)
        +delete_entry(unique_id: str)
        +list_stats()
    }

    RosterEntry "1" *-- "*" RosterImage : contains
    RosterMatch *-- RosterEntry : references

    RosterStoragePort <|.. FileRosterStorageAdapter
    EmbeddingStorePort <|.. EmbeddingStorageAdapter
    DataValidationPort <|.. DataValidationAdapter

    RosterService --> RosterStoragePort
    RosterService --> EmbeddingStorePort
    RosterService --> DataValidationPort
    RosterService ..> RosterEntry
    RosterService ..> RosterMatch

    RosterRouter --> RosterService
    RosterRouter ..> RosterEntry
    RosterRouter ..> RosterMatch
