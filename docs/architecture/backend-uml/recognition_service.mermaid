title: InsightFace Recognition Service (Current)
---
flowchart LR
    subgraph ports["Ports"]
        recognition_port["RecognitionServicePort\nrecognize_faces(image, threshold)"]
        model_port["RecognitionModelPort\nanalyze(image)\nmodel_info()"]
        embedding_port["EmbeddingRouterPort\nload_embeddings()\nfind_matches(vector, threshold)\nreload_if_needed()"]
    end

    subgraph domain["Domain Layer"]
        recognition_service["FaceRecognitionService\n- orchestrates detection → embedding → matches\n- handles threshold overrides\n- reports processing_time_ms"]
        recognition_entities["Domain Entities\nFaceDetection\nFaceEmbedding (512-dim)\nMatchResult\nRecognitionResult"]
        recognition_settings["Settings (Pydantic)\ninsightface, recognition, embedding_router, cache"]
    end

    subgraph adapters["Adapters"]
        insightface_adapter["InsightFaceAdapter\nimplements RecognitionModelPort"]
        embedding_router_adapter["EmbeddingRouterAdapter\nimplements EmbeddingRouterPort\n(JSON roster cache)"]
    end

    subgraph external["External Dependencies"]
        insightface_weights["InsightFace weights / ONNX runtime"]
        embeddings_file["Embeddings JSON\n(synced by RosterService)"]
        recognition_config["recognition_core/config/settings.yaml"]
        cache_dirs["HF_HOME / TORCH_HOME"]
    end

    recognition_port --> recognition_service
    recognition_service --> recognition_entities
    recognition_service --> recognition_settings
    recognition_service --> model_port
    recognition_service --> embedding_port

    model_port --> insightface_adapter
    embedding_port --> embedding_router_adapter

    insightface_adapter --> insightface_weights
    embedding_router_adapter --> embeddings_file
    recognition_settings --> recognition_config
    recognition_settings --> cache_dirs

    classDef portsClass fill:#e3f2fd,stroke:#1565c0,color:#000,stroke-width:2px
    classDef domainClass fill:#e8f5e9,stroke:#2e7d32,color:#000,stroke-width:2px
    classDef adapterClass fill:#fff3e0,stroke:#ef6c00,color:#000,stroke-width:2px
    classDef externalClass fill:#fce4ec,stroke:#ad1457,color:#000,stroke-width:2px

    class ports,recognition_port,model_port,embedding_port portsClass
    class domain,recognition_service,recognition_entities,recognition_settings domainClass
    class adapters,insightface_adapter,embedding_router_adapter adapterClass
    class external,insightface_weights,embeddings_file,recognition_config,cache_dirs externalClass
