{
  "mcpServers": {
    "workbay-handoff-mcp": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "root=\"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\"; exec python3 \"$root/scripts/hooks/mcp_launch.py\" \"$@\"",
        "sh",
        "workbay-handoff-mcp"
      ]
    },
    "workbay-orchestrator-mcp": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "root=\"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\"; exec python3 \"$root/scripts/hooks/mcp_launch.py\" \"$@\"",
        "sh",
        "workbay-orchestrator-mcp"
      ]
    },
    "codebase-graph-mcp": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "scripts/hooks/mcp_launch.py",
        "codebase-graph-mcp"
      ]
    }
  }
}
