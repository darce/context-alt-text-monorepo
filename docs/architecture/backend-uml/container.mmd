---
title: Prototype Description Service Containers (v4.2.4)
---
flowchart TB
    subgraph api["FastAPI Surface (api/main.py)"]
        app_factory["create_app()<br/>logging + middleware"]
        analyze_router["AnalyzeRouter<br/>/recognition/analyze"]
        cluster_router["ClusterRouter<br/>/recognition/clusters"]
        suggestion_router["SuggestionRouter<br/>/recognition/suggestions"]
        media_router["MediaRouter<br/>/recognition/media"]
        health_routers["/health + subsystem health"]
    end

    subgraph orchestration["Orchestration Layer"]
        scan_service["ScanService<br/>face detection + embedding"]
        cluster_service["ClusterService<br/>cluster_unclustered_identities()<br/>merge_cluster()"]
        job_service["JobService<br/>scan + clustering jobs"]
    end

    subgraph discovery["Discovery Layer"]
        rep_discovery["RepresentativeDiscovery<br/>match against reps"]
        centroid_discovery["CentroidDiscovery<br/>match against centroids"]
        graph_discovery["GraphDiscovery<br/>HDBSCAN / Chinese Whispers"]
    end

    subgraph assignment["Assignment Layer"]
        gate["AssignmentGate<br/>evaluate candidates"]
        checks["Checks: CompleteLinkCheck<br/>MaturityCheck, ConfidenceCheck"]
        writer["AssignmentWriter<br/>persist assignments"]
        suggestion_service["SuggestionService<br/>manage suggestions"]
    end

    subgraph infra["Infrastructure & Adapters"]
        embedding_service["EmbeddingService<br/>to_media_identities() seam"]
        insightface["InsightFaceAdapter<br/>FaceDetector + Generator"]
        cluster_repo["SqlAlchemyClusterRepository"]
        member_repo["SqlAlchemyMemberRepository"]
        suggestion_repo["SqlAlchemySuggestionRepository"]
        async_session["AsyncSession"]
        postgres["PostgreSQL + pgvector<br/>RLS policies"]
        settings["ClusteringSettings<br/>thresholds + config"]
    end

    %% API connections
    app_factory --> analyze_router
    app_factory --> cluster_router
    app_factory --> suggestion_router
    app_factory --> media_router
    app_factory --> health_routers

    %% Router to service
    analyze_router --> scan_service
    analyze_router --> job_service
    cluster_router --> cluster_service
    cluster_router --> job_service
    suggestion_router --> suggestion_service
    media_router --> cluster_service

    %% Scan flow
    scan_service --> embedding_service
    embedding_service --> insightface
    scan_service --> async_session

    %% Cluster service orchestration
    cluster_service --> rep_discovery
    cluster_service --> centroid_discovery
    cluster_service --> graph_discovery
    cluster_service --> gate
    cluster_service --> writer
    cluster_service --> suggestion_service

    %% Discovery produces candidates for gate
    rep_discovery --> gate
    centroid_discovery --> gate
    graph_discovery --> gate

    %% Gate validation and outcomes
    gate --> checks
    gate --> writer
    gate --> suggestion_service
    gate --> cluster_repo
    gate -.-> settings

    %% Writer persistence
    writer --> cluster_repo
    writer --> member_repo

    %% Suggestion persistence
    suggestion_service --> suggestion_repo

    %% Repository to database
    cluster_repo --> async_session
    member_repo --> async_session
    suggestion_repo --> async_session
    async_session --> postgres

    %% Settings injection
    settings --> gate
    settings --> cluster_service
    settings --> writer
