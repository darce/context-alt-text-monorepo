classDiagram
%% Admin SPA modules (React + WP REST config)

class AltContextAdminConfig {
  <<window.AltContextAdmin>>
  +nonce: string
  +endpoints: map
  +tenant_id?: string
  +devMode?: boolean | string | number
}

class ApiConfig {
  +getConfig(): ApiConfig
  +getEndpoint(primary, ...fallbacks): string
  +isDevMode(): boolean
}

class HttpClient {
  +fetchApi<T>(url, opts): Promise<T>
  +stripTrailingSlash(url): string
}

class WorkbenchPage {
  +tabs: ["scan","batch","confirm"]
  +useRecognitionJobHistory()
  +useMediaSelectionState()
  +useWorkbenchMedia()
  +useRecognitionHooks()
}

class WorkbenchHooks {
  +useWorkbenchMedia(params)
  +useMediaSelectionState()
  +useWorkbenchFilters()
  +useRecognitionJobHistory()
}

class RecognitionHooks {
  +useScanIdentities()
  +useScanStatus()
  +useMultiScanStatus()
  +useClusterIdentities()
  +useRecognitionClusters()
  +useRecognitionCluster()
  +useTrainingStage()
}

class ClusterEditingHooks {
  +useClusterEditState()
  +useClusterMutations()
  +useClusterSuggestions()
}

class WorkbenchComponents {
  +MediaSelection
  +TrainingStageBanner
  +BatchPanel
  +ConfirmPanel
  +IdentityClusterList
  +SuggestionReviewPanel
  +MergeUndoBanner
}

class RosterPage {
  +tabs: ["entries","clusters"]
  +useRosterEntries()
  +useRecognitionClusters()
  +useRecognitionCluster()
}

class RosterComponents {
  +ClusterGrid
  +ClusterDrawerPanel
  +useClusterMediaMap()
  +useClusterDragDrop()
  +useClusterActions()
}

AltContextAdminConfig --> ApiConfig : localized
ApiConfig --> HttpClient : supplies endpoints/nonce
WorkbenchPage --> WorkbenchHooks
WorkbenchPage --> RecognitionHooks
WorkbenchPage --> ClusterEditingHooks
WorkbenchPage --> WorkbenchComponents
WorkbenchComponents --> ClusterEditingHooks
RosterPage --> RosterComponents
RosterPage --> RecognitionHooks
RosterComponents --> RecognitionHooks
RosterComponents --> HttpClient
