+    rotate: vi.fn(async () => issue({ id: KEY_B, raw_key: SECRET_B })),
+    revoke: vi.fn(async () => ({ id: KEY_A, tenant_id: TENANT_A, revoked: true })),
+    ...overrides,
+  };
