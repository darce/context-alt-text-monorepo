# AuraFace 512d isolated stack template for the OCI VM (three labels: dev-auraface, staging-auraface, prod-auraface).
#
# Install one runtime file per label, owner ubuntu:ubuntu, mode 0600:
#   /opt/acx-backend/<label>/.env
# Each label has its own compose project, network, PGDATA, model root, database and role. No value is shared with the generic dev, staging or prod stacks or with the dev-fir SFace 128d stack.
#
# Mandatory: PGVECTOR_DIM=512 and RECOGNITION_FACE_PIPELINE_PROFILE=auraface. RECOGNITION_FACE_PIPELINE_MODELS_DIR and RECOGNITION_AURAFACE_MODELS_DIR both point under the compose mount (${ACX_MODELS_PATH}:/data/cache).
# Auth stays enabled and the /admin surface stays disabled. Replace each host-supplied Postgres value with one fresh value per label; never reuse another label's DSN or password.
#
# The runtime refuses AuraFace activation until artifact provenance and preprocessing are verified (ADR-016). This template does not clear that gate.
#
# Do NOT commit secrets.

# == Compose ==
# domain: infra | source: OCI deploy | consumer: docker-compose.env.yml project identity
COMPOSE_PROJECT_NAME=acx-dev-auraface
# domain: infra | source: OCI deploy | consumer: compose / deploy scripts (environment label)
ACX_ENV=dev-auraface
# domain: infra | source: OCI deploy | consumer: compose image tag selection
ACX_IMAGE_TAG=dev-auraface
# domain: infra | source: OCI deploy | consumer: compose volume mount for Postgres data
ACX_PGDATA_PATH=/opt/acx-backend/data/dev-auraface-pgdata
# domain: infra | source: OCI deploy | consumer: compose volume mount for model cache
ACX_MODELS_PATH=/opt/acx-backend/data/dev-auraface-models
# domain: infra | source: OCI deploy | consumer: compose network name
ACX_NETWORK_NAME=acx-dev-auraface-net

# == Runtime mode ==
# domain: infra | source: OCI deploy | consumer: application logging config
LOG_LEVEL=INFO
# domain: infra | source: OCI deploy | consumer: runtime default tenant context (deploy bootstrap)
TENANT_ID=00000000-0000-7000-8000-000000000003
# domain: infra (backend selector) | source: service operator | consumer: shared/secrets.py:get_secret_provider. auraface labels use env: every Postgres and admin secret is a host-supplied line in that label's remote .env, and no Vault refs are declared for auraface.
RECOGNITION_SECRET_BACKEND=env
# domain: service root-of-trust (mode flag) | source: service operator | consumer: SecuritySettings / runtime mode gates; validate_required_secrets
RECOGNITION_RUNTIME_MODE=production

# == Secret backend ==
# Derived JSON map of Vault refs. auraface labels use backend env and declare no Vault refs, so the map renders as {}. domain: infra (OCID map) | source: OCI deploy | consumer: shared/secrets.py:OciVaultSecretProvider.from_env
# RECOGNITION_VAULT_SECRET_MAP='{}'

# == Postgres ==
# domain: infra | source: OCI deploy | consumer: docker-compose Postgres bootstrap. One role per auraface label (acx_<label with underscores>).
POSTGRES_USER=acx_dev_auraface
# domain: infra | source: operator host .env (host ref, one value per auraface label) | consumer: docker-compose Postgres bootstrap
POSTGRES_PASSWORD=REPLACE_ME_AURAFACE_PG
# domain: infra | source: OCI deploy | consumer: docker-compose Postgres bootstrap (POSTGRES_DB)
POSTGRES_DB=alt_context_dev_auraface

# == Database DSNs ==
# domain: infra | source: operator host .env (host ref, one DSN per auraface label) | consumer: db/settings.py:get_database_settings
POSTGRES_DSN=postgresql+asyncpg://REPLACE_ME_ROLE:REPLACE_ME_PASSWORD@postgres:5432/REPLACE_ME_DB
# domain: infra | source: operator host .env (host ref, one DSN per auraface label) | consumer: db/settings.py:get_database_settings
POSTGRES_SYNC_DSN=postgresql+psycopg://REPLACE_ME_ROLE:REPLACE_ME_PASSWORD@postgres:5432/REPLACE_ME_DB

# == Face pipeline ==
# Sole dimension root for the AuraFace 512d store (ADR-016): must match the auraface model and this label's isolated store; never point at a 128d SFace store. domain: infra | source: description-service / DB ops | consumer: db/settings.py pool/vector settings
PGVECTOR_DIM=512
# Both profile + dim are required for the three-way guard
# (face_pipeline_adapter.py:318-329). Models dir must sit under the
# ACX_MODELS_PATH -> /data/cache volume mount.
# domain: recognition | source: OCI deploy | consumer: face_pipeline profile selection
RECOGNITION_FACE_PIPELINE_PROFILE=auraface
# domain: recognition | source: OCI deploy | consumer: face_pipeline settings.resolved_models_dir
RECOGNITION_FACE_PIPELINE_MODELS_DIR=/data/cache/face_pipeline
# AuraFace ONNX root read by settings.auraface_models_dir on the auraface profile path; must sit under the ACX_MODELS_PATH -> /data/cache volume mount.
# domain: recognition | source: OCI deploy | consumer: runtime_factory AuraFace embedder root
RECOGNITION_AURAFACE_MODELS_DIR=/data/cache/face_pipeline

# == Cache directories ==
# domain: infra | source: OCI deploy | consumer: runtime cache path resolution
CACHE_BASE=/data/cache
# domain: infra | source: OCI deploy | consumer: HuggingFace hub cache
HF_HOME=/data/cache/huggingface_cache
# domain: infra | source: OCI deploy | consumer: HuggingFace hub cache
HF_HUB_CACHE=/data/cache/huggingface_cache
# domain: infra | source: OCI deploy | consumer: InsightFace model cache path kept on the per-label volume for parity with the FIR stack; the auraface profile does not load InsightFace runtime or buffalo weights (ADR-016)
INSIGHTFACE_CACHE_DIR=/data/cache/insightface
# domain: infra | source: OCI deploy | consumer: InsightFace home path kept on the per-label volume for parity with the FIR stack; the auraface profile does not load InsightFace runtime or buffalo weights (ADR-016)
INSIGHTFACE_HOME=/data/cache/insightface

