+	private function is_validated_warming_response( int $status, mixed $decoded, mixed $response_headers ): bool {
+		if ( 503 !== $status || ! is_array( $decoded ) ) {
+			return false;
+		}
+
+		$detail = $decoded['detail'] ?? null;
+		if ( ! is_array( $detail ) ) {
+			return false;
+		}
+
+		if ( self::TYPED_CODE_STARTING !== ( $detail['code'] ?? null ) ) {
