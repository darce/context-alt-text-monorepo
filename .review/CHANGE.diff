+                    _CURSOR.lease_owner.is_(None),
+                    _CURSOR.lease_until.is_(None),
+                    _CURSOR.lease_until <= now,
+                ),
+            )
+            .values(
+                lease_owner=owner,
+                lease_until=until,
+                fence=_CURSOR.fence + 1,
