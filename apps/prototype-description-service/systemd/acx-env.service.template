# Systemd unit template for an ACX environment stack.
# Replace {{ENV}} with prod/staging/dev and {{COMPOSE_FILES}} with the
# environment's complete compose-file list.
#
# Install (canonical path: scripts/deploy-env.sh renders + installs this unit):
#   sudo cp acx-env.service.template /etc/systemd/system/acx-{{ENV}}.service
#   sed -i -e 's/{{ENV}}/prod/g' \
#     -e 's|{{COMPOSE_FILES}}|-f docker-compose.env.yml -f docker-compose.admin.yml|g' \
#     /etc/systemd/system/acx-prod.service
#   (dev/staging: use -e 's|{{COMPOSE_FILES}}|-f docker-compose.env.yml|g')
#   sudo systemctl daemon-reload && sudo systemctl enable acx-prod.service

[Unit]
Description=ACX Backend - {{ENV}}
Requires=docker.service
After=docker.service

[Service]
Type=exec
WorkingDirectory=/opt/acx-backend/{{ENV}}
# Under RECOGNITION_SECRET_BACKEND=oci_vault, uncomment the ExecStartPre below to
# fetch the postgres-container bootstrap password (POSTGRES_PASSWORD) from OCI
# Vault via this VM's instance principal into the runtime .env BEFORE compose up.
# The app services (api/worker) fetch their own secrets from Vault at boot and
# do NOT need this hook. The fetch script is operator-provided per the runbook:
# infra/oci/vault-instance-principal-runbook.md.
# ExecStartPre=/opt/acx-backend/{{ENV}}/fetch-vault-bootstrap.sh
ExecStart=/usr/bin/docker compose {{COMPOSE_FILES}} up --remove-orphans
ExecStop=/usr/bin/docker compose {{COMPOSE_FILES}} stop
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
