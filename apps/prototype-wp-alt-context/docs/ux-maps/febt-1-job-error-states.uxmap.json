        { "id": "progress-meter", "label": "Progress + ETA", "role": "status", "states": ["running", "stalled"] },
        { "id": "job-actions", "label": "Start / cancel / retry", "role": "action", "states": ["idle", "running", "failed", "completed_with_errors"] }
