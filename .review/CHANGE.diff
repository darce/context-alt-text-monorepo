+# App-host deploy inputs for scripts/deploy/app-portal.sh.
+# No Clerk or Polar credentials belong here. Default is dry-run.
+
+APP_HOSTNAME=app.altcontext.com
+APP_UPSTREAM=prod-api:8000
+APP_ROOT=/opt/acx-backend/app
+APP_WWW=/opt/acx-backend/app/www
+APP_FRONTEND_ROOT=/srv/app-portal
+CADDYFILE=/opt/acx-backend/Caddyfile
+
+# Required for --apply: a real built SPA (index.html + assets/), not a generated placeholder.
+# FRONTEND_DIST=/absolute/path/to/app-portal/dist
+
+# Backend portal flag and Clerk/Polar values stay in /opt/acx-backend/prod/.env
+# (operator-owned; RECOGNITION_PORTAL_ENABLED=1). Frontend VITE_CLERK_* is baked
+# at build time by configure_clerk_production.py, never by this deploy script.
