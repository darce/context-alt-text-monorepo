# Tests and dev tooling
tests/
recognition/tests/
roster/tests/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build artifacts
*.egg-info/
__pycache__/
*.pyc
build/
dist/

# Local data and caches
data/
logs/
*.log

# Environment and secrets
.env
.env.*
!.env.example
!.env.prod.example

# Docker compose files (not needed inside the image)
docker-compose*.yml
Caddyfile

# IDE and OS
.vscode/
.idea/
.DS_Store

# Documentation
README.md
Makefile

# Face-pipeline ONNX weights are operator-provisioned at deploy (not baked in).
# Keep LICENSE.* + README under recognition/infrastructure/face_pipeline/models/.
recognition/infrastructure/face_pipeline/models/*.onnx

# VLM / HuggingFace weight caches are operator-provisioned on a volume mount
# (/data/cache) for the runtime-vlm target — never bake multi-GB weights into
# the build context.
**/huggingface_cache/
**/.cache/huggingface/
