---
title: Recognition Domain Overview
---
classDiagram
    class IdentityDetection {
        +bbox : tuple[int,int,int,int]
        +confidence : float
        +landmarks : ndarray?
        +area() float
    }

    class IdentityEmbedding {
        +embedding : ndarray
        +detection : IdentityDetection
        +to_list() list[float]
    }

    class Tenant {
        +id : UUID
        +site_url : str
        +created_at : datetime
        +updated_at : datetime
    }

    class MediaIdentity {
        +id : UUID
        +tenant_id : UUID
        +media_id : int
        +media_url : str
        +bbox_x : int
        +bbox_y : int
        +bbox_width : int
        +bbox_height : int
        +confidence : float
        +embedding : Vector~1024~
        +thumbnail_url : str?
        +created_at : datetime
        +updated_at : datetime
        +created_by_user_id : int?
    }

    class IdentityCluster {
        +id : UUID
        +tenant_id : UUID
        +label : str?
        +representative_identity_id : UUID?
        +identity_count : int
        +similarity_threshold : float?
        +clustering_algorithm : str
        +user_confirmed : bool
        +confirmation_count : int
        +created_at : datetime
        +updated_at : datetime
    }

    class IdentityClusterRepresentative {
        +id : UUID
        +tenant_id : UUID
        +cluster_id : UUID
        +identity_id : UUID
        +embedding : Vector~1024~
        +quality_score : float
        +diversity_score : float?
        +created_at : datetime
    }

    class IdentityMember {
        +id : UUID
        +tenant_id : UUID
        +cluster_id : UUID
        +identity_id : UUID
        +similarity : float
        +assigned_at : datetime
        +created_at : datetime
        +created_by_user_id : int?
    }

    class ClusterCentroid {
        <<Materialized View>>
        +cluster_id : UUID
        +tenant_id : UUID
        +member_count : int
        +centroid : Vector~1024~
        +refreshed_at : datetime
    }

    class IdentityScanJob {
        +id : UUID
        +tenant_id : UUID
        +status : str
        +media_ids : list[int]
        +total_media : int
        +processed_media : int
        +identities_detected : int
        +error_message : str?
        +created_at : datetime
        +started_at : datetime?
        +completed_at : datetime?
    }

    class IdentityClusteringJob {
        +id : UUID
        +tenant_id : UUID
        +status : str
        +progress : float
        +total_identities : int?
        +processed_identities : int?
        +error_message : str?
        +created_at : datetime
        +started_at : datetime?
        +completed_at : datetime?
    }

    class IdentitySuggestion {
        +id : UUID
        +tenant_id : UUID
        +identity_id : UUID
        +suggested_cluster_id : UUID
        +representative_similarity : float
        +avg_member_similarity : float
        +confidence_score : float
        +priority : int
        +resolution : str
        +created_at : datetime
        +resolved_at : datetime?
    }

    Tenant "1" -- "*" MediaIdentity : owns
    Tenant "1" -- "*" IdentityCluster : owns
    Tenant "1" -- "*" IdentitySuggestion : owns
    IdentityCluster "1" -- "*" IdentityMember : members
    IdentityCluster "1" -- "*" IdentityClusterRepresentative : representatives
    IdentityCluster "0..1" -- "1" MediaIdentity : representative_identity
    IdentityCluster "1" -- "0..1" ClusterCentroid : centroid
    MediaIdentity "1" -- "0..1" IdentityMember : membership
    MediaIdentity "1" -- "0..1" IdentityClusterRepresentative : rep_for
    MediaIdentity "1" -- "0..*" IdentitySuggestion : suggested
    IdentitySuggestion "1" -- "1" IdentityCluster : target_cluster
    IdentityScanJob "1" --> "1" Tenant
    IdentityClusteringJob "1" --> "1" Tenant
