flowchart TB
    %% =======================================================================
    %% RECOGNITION SERVICE V4.2.4 - FACE → IDENTITY BOUNDARY
    %% Architecture Decision: Infrastructure vs Domain Nomenclature
    %% Updated: December 6, 2025 - Reflects actual implementation
    %% See also: ../frontend/architecture-proxy-boundary.mmd for WP boundaries
    %% =======================================================================
    
    subgraph Infrastructure["Infrastructure Layer (Face Nomenclature) ✅"]
        direction TB
        
        subgraph InsightFace["InsightFace Adapter ✅"]
            FD["FaceDetectorProtocol<br/>InsightFaceFaceDetector"]
            FaceDetection["DetectedFace<br/>dataclass"]
        end
        
        subgraph Embedding["Embedding Generator ✅"]
            EG["EmbeddingGeneratorProtocol<br/>InsightFaceEmbeddingGenerator"]
            EmbeddingResult["EmbeddingResult<br/>1024D extended vectors"]
        end
        
        subgraph Layout["Embedding Layout ✅"]
            Layout1024["1024D Extended Embedding<br/>┌─────────────────────┐<br/>│ 0-511: Face Identity │<br/>│ 512-767: Pose │<br/>│ 768-895: Age/Gender │<br/>│ 896-1023: Quality │<br/>└─────────────────────┘"]
        end
        
        FD -->|"detect(bytes)"| FaceDetection
        FaceDetection -->|"bbox, landmarks, score"| EG
        EG -->|"build_extended_embedding()"| EmbeddingResult
        
        style Infrastructure fill:#fce4ec,stroke:#ad1457,stroke-width:2px,color:#880e4f
    end
    
    SEAM[/"═══════ to_media_identities() ═══════<br/>EmbeddingService transformation method<br/>recognition/application/embedding/service.py ✅"/]
    
    subgraph Domain["Domain Layer (Identity Nomenclature) ✅"]
        direction TB
        
        subgraph Models["Domain Models ✅"]
            MI["MediaIdentity<br/>clusterable entity"]
            IC["IdentityCluster<br/>group of identities"]
            CR["ClusterRepresentative<br/>exemplar"]
            AS["AssignmentSuggestion<br/>pending decision"]
        end
        
        subgraph Pipeline["Assignment Pipeline ✅"]
            Discovery["Discovery Layer<br/>RepresentativeDiscovery<br/>CentroidDiscovery<br/>GraphDiscovery"]
            Gate["AssignmentGate<br/>MaturityCheck<br/>CompleteLinkCheck<br/>MemberDistributionCheck<br/>ConfidenceCheck"]
            Writer["AssignmentWriter<br/>persist outcomes"]
        end
        
        subgraph FaceOnly["Face-Only Enforcement ✅"]
            Extract["extract_face_embedding()<br/>Takes 1024D → Returns 512D<br/>Strips metadata for similarity"]
        end
        
        MI --> Discovery
        Discovery --> Gate
        Discovery --> Extract
        Gate --> Extract
        Gate --> IC
        Gate --> AS
        
        style Domain fill:#e3f2fd,stroke:#0d47a1,stroke-width:2px,color:#0d47a1
    end
    
    EmbeddingResult --> SEAM
    SEAM --> MI
    
    style SEAM fill:#fff3e0,stroke:#bf360c,stroke-width:3px,color:#bf360c

    %% -----------------------------------------------------------------------
    %% DATA FLOW ANNOTATIONS
    %% -----------------------------------------------------------------------
    
    subgraph Legend["Architecture Decisions"]
        direction LR
        L1["<b>Face*</b> = InsightFace-specific<br/>Bound to detection technology<br/>✅ InsightFaceAdapter implemented"]
        L2["<b>*Identity</b> = Technology-agnostic<br/>Could swap to YOLO, MediaPipe, etc.<br/>✅ Domain models complete"]
        L3["<b>Seam</b> = Transformation point<br/>Infrastructure → Domain translation<br/>✅ to_media_identities() working"]
        L4["<b>Face-Only Similarity</b><br/>512D extraction for clustering<br/>✅ Prevents metadata dilution"]
        
        style Legend fill:#f5f5f5,stroke:#9e9e9e,color:#424242
    end
