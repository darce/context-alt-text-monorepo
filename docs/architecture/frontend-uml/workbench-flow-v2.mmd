%% Workbench recognition + clustering flow (React Query + WP REST)

flowchart TD
    user([Admin]) --> workbench[WorkbenchPage]

    subgraph UI["Workbench UI"]
        workbench --> mediaSelection[MediaSelection]
        workbench --> scanPanel[ScanActionPanel]
        workbench --> batchPanel[BatchPanel]
        workbench --> confirmPanel[ConfirmPanel\nIdentityClusterList + SuggestionReviewPanel]
    end

    subgraph Hooks["React Query hooks"]
        scanPanel --> useScan[useScanIdentities]
        scanPanel --> useStatus[useScanStatus/useMultiScanStatus]
        batchPanel --> useClusterMutation[useClusterIdentities]
        confirmPanel --> useClusters[useRecognitionClusters]
        confirmPanel --> useClusterSuggestions[useClusterSuggestions]
    end

    subgraph Cache["React Query Cache"]
        queryClient[(QueryClient)]
    end

    subgraph WPAPI["WP REST (proxy endpoints)"]
        postAnalyze["POST /recognition/analyze"]
        getJobs["GET /recognition/jobs/{id}"]
        postCluster["POST /recognition/clustering/jobs"]
        getClusters["GET /recognition/clusters + /clusters/labels"]
        getIdSuggestions["GET /recognition/identities/{id}/suggestions"]
        postSuggestions["POST /recognition/suggestions/{id}/{action}"]
    end

    subgraph Remote["Recognition Service"]
        analyze["/recognition/analyze"]
        jobs["/recognition/jobs/{id}"]
        clustering["/recognition/clustering/jobs"]
        clusters["/recognition/clusters"]
        suggestions["/recognition/suggestions"]
    end

    %% Cache links
    useScan --> queryClient
    useStatus --> queryClient
    useClusterMutation --> queryClient
    useClusters --> queryClient
    useClusterSuggestions --> queryClient

    %% API links
    useScan --> postAnalyze
    useStatus --> getJobs
    useClusterMutation --> postCluster
    useClusters --> getClusters
    useClusterSuggestions --> getIdSuggestions
    confirmPanel --> postSuggestions

    %% Proxy links
    postAnalyze --> analyze
    getJobs --> jobs
    postCluster --> clustering
    getClusters --> clusters
    getIdSuggestions --> suggestions
    postSuggestions --> suggestions

    %% Styling
    classDef ui fill:#ffffff,stroke:#000000,color:#000000,stroke-width:2px
    classDef hook fill:#f5f5f5,stroke:#000000,color:#000000,stroke-width:1px
    classDef cache fill:#e0e0e0,stroke:#000000,color:#000000,stroke-width:1px
    classDef api fill:#cccccc,stroke:#000000,color:#000000,stroke-width:1px
    classDef remote fill:#999999,stroke:#000000,color:#000000,stroke-width:1px

    class workbench,mediaSelection,scanPanel,batchPanel,confirmPanel ui
    class useScan,useStatus,useClusterMutation,useClusters,useClusterSuggestions hook
    class queryClient cache
    class postAnalyze,getJobs,postCluster,getClusters,getIdSuggestions,postSuggestions api
    class analyze,jobs,clustering,clusters,suggestions remote
