---
title: Context Alt Text - System Architecture Overview
---
flowchart TB
    %% =======================================================================
    %% HIGH-LEVEL SYSTEM ARCHITECTURE
    %% Shows interaction between WordPress Plugin and Recognition Service
    %% Updated: 2025-06-15
    %% =======================================================================

    subgraph WordPress["WordPress Plugin (prototype-wp-alt-context)"]
        subgraph ReactUI["React Admin UI"]
            Dashboard["DashboardPage"]
            Workbench["WorkbenchPage<br/>Media + Clustering"]
            Roster["RosterPage<br/>Identity Management"]
            ConflictInbox["ConflictInbox"]
            DeadLetterPanel["DeadLetterPanel"]
            SyncHealth["SyncStatusIndicator"]
        end

        subgraph Hooks["React Hooks"]
            useRecognition["useRecognitionHooks"]
            useJobHistory["useJobProgressStream"]
            useMediaIdentities["useMediaIdentities"]
            useJobCoord["useJobCoordination"]
            useSyncHealth["useSyncHealth"]
        end

        subgraph ApiClient["TypeScript API Client"]
            scanApi["scanApi"]
            clusterApi["clusterApi"]
            identityApi["identityApi"]
            syncApi["syncApi"]
            conflictApi["conflictApi"]
        end

        subgraph PHPLayer["PHP REST Layer"]
            ApiClass["Api (class-api.php)<br/>Route Registration"]
            RecognitionCtrl["RecognitionController<br/>Recognition proxy"]
            ConflictCtrl["ConflictController<br/>Conflict resolution"]
            SyncCtrl["SyncController<br/>Health + dead-letter"]
        end

        subgraph SovereignSync["Sovereign Sync Layer"]
            Projector["SnapshotProjector"]
            OutboxDrain["OutboxDrain +<br/>OutboxDispatcher"]
            ConflictSvc["ConflictResolutionService"]
            Sequencer["CrossPlaneSequencer"]
            SyncStateRepo["SyncStateRepository"]
        end

        subgraph WPData["WP Database Tables"]
            WPCluster["wp_acx_clusters"]
            WPMembers["wp_acx_identity_members"]
            WPOutbox["wp_acx_sync_outbox"]
            WPConflicts["wp_acx_sync_conflicts"]
            WPSyncState["wp_acx_sync_state"]
        end
    end

    subgraph Backend["Recognition Service (prototype-description-service)"]
        subgraph API["FastAPI Routers"]
            AnalyzeRouter["POST /analyze<br/>GET /jobs/{id}"]
            ClusterRouter["POST /clustering/jobs<br/>GET /clusters<br/>PATCH /clusters/{id}<br/>POST /merge, /split"]
            SuggestionRouter["GET /suggestions<br/>POST accept/reject"]
            SnapshotRouter["GET /snapshot/{tenant}"]
            CurationRouter["POST /curation/sync<br/>POST /topology/*"]
        end

        subgraph Orchestration["Orchestration"]
            ScanService["ScanService<br/>Detection + Embedding"]
            ClusterService["ClusterService<br/>Clustering Workflow"]
            JobService["JobService<br/>Job Tracking"]
        end

        subgraph Discovery["Discovery Layer"]
            RepDiscovery["RepresentativeDiscovery"]
            CentroidDiscovery["CentroidDiscovery"]
            GraphDiscovery["GraphDiscovery"]
        end

        subgraph Assignment["Assignment Layer"]
            Gate["AssignmentGate<br/>Quality Checks"]
            Writer["AssignmentWriter<br/>Persistence"]
            Suggestions["SuggestionService"]
        end

        subgraph Infra["Infrastructure"]
            EmbeddingService["InsightFaceAdapter<br/>Detector + Generator"]
            ClusterRepo["ClusterRepository"]
            MemberRepo["MemberRepository"]
        end
    end

    subgraph Database["PostgreSQL + pgvector"]
        IdentityTables["MediaIdentity<br/>IdentityCluster<br/>IdentityMember"]
        RepTable["ClusterRepresentative"]
        SuggestionTable["IdentitySuggestion"]
        JobTables["ScanJob<br/>ClusteringJob"]
        CentroidMV["mv_identity_cluster_centroids"]
    end

    %% WordPress internal flow (UI)
    ReactUI --> Hooks
    Hooks --> ApiClient
    ApiClient --> ApiClass
    ApiClass --> RecognitionCtrl
    ApiClass --> ConflictCtrl
    ApiClass --> SyncCtrl

    %% Cross-boundary: recognition proxy
    RecognitionCtrl -->|"HTTP + X-API-Key<br/>tenant_id (query/body)"| API

    %% Cross-boundary: snapshot pull (WP pulls from backend)
    SnapshotRouter -->|"JSON snapshot"| Projector
    Projector -->|"Atomic projection"| WPCluster
    Projector -->|"Atomic projection"| WPMembers
    Projector -->|"Conflict detection"| WPConflicts
    Projector -->|"Update metrics"| WPSyncState

    %% Cross-boundary: outbox push (WP pushes to backend)
    OutboxDrain -->|"Curation ops"| CurationRouter
    OutboxDrain -->|"Topology ops"| CurationRouter
    WPOutbox -->|"Drain cycle"| OutboxDrain
    OutboxDrain -->|"Update metrics"| SyncStateRepo
    SyncStateRepo --> WPSyncState

    %% Conflict resolution
    ConflictCtrl --> ConflictSvc
    ConflictSvc --> WPCluster
    ConflictSvc --> WPConflicts
    ConflictSvc -->|"Re-enqueue"| WPOutbox

    %% Sync health
    SyncCtrl --> SyncStateRepo
    SyncHealth --> useSyncHealth
    ConflictInbox --> conflictApi
    DeadLetterPanel --> syncApi

    %% Sequencing
    Sequencer --> OutboxDrain

    %% Backend flow
    API --> Orchestration
    Orchestration --> Discovery
    Discovery --> Gate
    Gate --> Writer
    Gate --> Suggestions

    Orchestration --> Infra
    Writer --> ClusterRepo
    Writer --> MemberRepo
    Suggestions --> ClusterRepo

    %% Database connections
    ClusterRepo --> IdentityTables
    ClusterRepo --> RepTable
    ClusterRepo --> CentroidMV
    MemberRepo --> IdentityTables
    Suggestions --> SuggestionTable
    JobService --> JobTables

