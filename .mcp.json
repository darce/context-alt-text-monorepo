{
  "mcpServers": {
    "mcp-agent-handoff": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-agent-handoff==0.11.2",
        "--workspace-root",
        ".",
        "serve-stdio"
      ],
      "env": {
        "PYENV_VERSION": "description-service",
        "AGENT_HANDOFF_ENFORCE_BRANCH": "1"
      }
    },
    "mcp-agent-orchestrator": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-agent-orchestrator==0.4.6",
        "--workspace-root",
        ".",
        "serve-stdio"
      ],
      "env": {
        "PYENV_VERSION": "description-service",
        "AGENT_HANDOFF_ENFORCE_BRANCH": "1"
      }
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@2.1.4"
      ]
    }
  }
}
