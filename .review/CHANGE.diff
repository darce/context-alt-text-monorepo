+        stmt = inserter(_CURSOR).values(
+            provider=key.provider,
+            environment=key.environment,
+            seller_account=key.seller_account,
+            kind=key.kind.value,
+            fence=0,
+            exhausted=False,
+            failure_count=0,
+            updated_at=now,
