---
title: Recognition Service Containers
---
flowchart TB
    subgraph api["FastAPI Surface"]
        main_router["api/routes/main.py\nScene + service endpoints"]
        roster_router["api/routes/roster.py\nRoster + augmentation endpoints"]
        dependency_layer["api/dependencies.py\nDepends wiring + singletons"]
    end

    subgraph domain["Domain Layer"]
        roster_service["RosterService\nCRUD + progressive learning"]
        recognition_service["FaceRecognitionService\nOrchestrates recognition pipeline"]
        metrics["shared/metrics.py\nstructured logging + timers"]
    end

    subgraph adapters["Adapters"]
        pg_adapter["roster/adapters/postgresql_storage_adapter.py\npgvector persistence"]
        sqlite_adapter["roster/adapters/sqlite_storage_adapter.py\nlocal dev storage"]
        hybrid_index["recognition_core/services/hybrid_index_manager.py\npgvector ↔ FAISS sync"]
        embedding_router["recognition_core/adapters/embedding_router_adapter.py\nsimilarity search port"]
        insightface["recognition_core/adapters/insight_face_adapter.py\nmodel inference (ONNX)"]
    end

    subgraph infra["Infrastructure"]
        postgres["PostgreSQL + pgvector"]
        faiss["FAISS in-memory index"]
        settings["shared/config/settings.py\nPydantic settings"]
    end

    main_router --> dependency_layer
    roster_router --> dependency_layer
    dependency_layer --> roster_service
    dependency_layer --> recognition_service

    roster_service --> metrics
    recognition_service --> metrics

    roster_service --> pg_adapter
    roster_service --> sqlite_adapter

    recognition_service --> embedding_router
    embedding_router --> hybrid_index
    recognition_service --> insightface

    hybrid_index --> pg_adapter
    hybrid_index --> faiss
    pg_adapter --> postgres

    settings --> dependency_layer
    settings --> roster_service
    settings --> recognition_service
