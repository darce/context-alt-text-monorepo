flowchart TD
    %% Layer: application (recognition/application/assignment/*)
    subgraph Legend["Legend + Conventions"]
        direction TB
        LegendEntry["ENTRY: external entrypoint"]
        LegendOptional["Dashed arrow = optional wiring"]
    end

    subgraph Discovery["Discovery Phase (Find Candidates)"]
        RD[RepresentativeDiscovery]
        CD[CentroidDiscovery]
        GD[GraphDiscovery<br/>HDBSCAN]
    end
    
    RD --> Candidates
    CD --> Candidates
    GD --> Candidates
    
    Candidates[AssignmentCandidate<br/>identity, cluster, similarity]
    
    Candidates --> Gate
    
    subgraph Gate["AssignmentGate (Single Path)"]
        direction TB

        BC{BlockCheck<br/>identity blocked?}
        CON{ConstraintCheck<br/>CANNOT_LINK?}
        CONF{ConfidenceCheck<br/>settings: ClusteringSettings.similarity_threshold,<br/>ClusteringSettings.suggestion_floor, ClusteringSettings.suggestion_ceiling,<br/>ClusteringSettings.fatal_confidence_floor, ClusteringSettings.fatal_quality_floor,<br/>ClusteringSettings.early_stage_suggestion_enabled<br/>anchor_linked bypass}

        BC -->|Blocked| Reject[REJECT<br/>blocked by user]
        BC -->|OK| CON

        CON -->|Cannot link - fatal| Reject
        CON -->|OK| CONF

        CONF -->|Similarity >= threshold| Accept[ACCEPT]
        CONF -->|Within suggestion band| Suggest[SUGGEST]
        CONF -->|Below floor / fatal quality| Reject
    end

    Accept --> Writer[AssignmentWriter<br/>Persist to DB]
    Suggest --> Sugg[SuggestionService<br/>Create pending]
    Reject --> Pool[Unclustered Pool<br/>Form new clusters]
    
    Writer --> DB[(Database)]
    Sugg --> DB
    Pool --> NewClusters[Create New Clusters<br/>via HDBSCAN]
    NewClusters --> DB

    GateCode["Code anchors:\nrecognition/application/assignment/gate.py\nrecognition/application/assignment/checks/block.py\nrecognition/application/assignment/checks/constraint.py\nrecognition/application/assignment/checks/confidence.py\nrecognition/application/persistence/assignment_writer.py\nrecognition/application/suggestions/service.py"]
    Gate -.-> GateCode

    LayerNote["Layer: application (assignment + persistence)\nDomain types: recognition/domain/*"]
    Gate -.-> LayerNote
    
    %% Styling (WCAG AA compliant - 4.5:1 text contrast, 3:1 graphical contrast)
    style Gate fill:#fff3e0,stroke:#bf360c,color:#bf360c
    style Accept fill:#c8e6c9,stroke:#1b5e20,color:#1b5e20
    style Reject fill:#ffcdd2,stroke:#b71c1c,color:#b71c1c
    style Suggest fill:#fff8e1,stroke:#f57f17,color:#e65100
    style Discovery fill:#e3f2fd,stroke:#0d47a1,color:#0d47a1
