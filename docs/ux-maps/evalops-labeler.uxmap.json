      "route": "/#finding",
      "job_entry": false,
      "deep_link": false,
      "url_params": [],
      "primary_action_id": "save",
      "states": [
        "default",
        "loading",
        "empty",
        "error",
        "offline",
        "first_time",
        "edge_input",
        "degraded"
      ],
      "zones": [
        {
          "id": "claim",
          "label": "Finding claim and frozen source evidence",
          "role": "ai_review",
          "states": [
            "default",
            "loading",
            "empty",
            "error",
            "offline",
            "edge_input"
          ],
          "evidence_linked": true
        },
        {
          "id": "judgment",
          "label": "Defect validity: defect / not defect / uncertain",
          "role": "form",
          "states": [
            "default",
            "loading",
            "empty",
            "error",
            "offline",
            "edge_input"
          ]
        },
        {
          "id": "disposition",
          "label": "Action disposition: blocks / nonblocking / unknown; affected action and evidence/conditions",
          "role": "form",
          "states": [
            "default",
            "loading",
            "empty",
            "error",
            "offline",
            "edge_input"
          ]
        },
        {
          "id": "provenance",
          "label": "Annotation source, explicit exposure, attestation/original references, rubric and protocol versions",
          "role": "form",
          "states": [
            "default",
            "loading",
            "empty",
            "error",
            "offline",
            "edge_input"
          ]
        },
        {
          "id": "decision-error",
          "label": "Focused, announced validation and save errors; draft retained",
          "role": "status",
          "states": [
            "default",
            "error",
            "offline",
            "edge_input"
          ]
        },
        {
          "id": "notes",
          "label": "Notes (optional)",
          "role": "form",
          "states": [
            "default",
            "loading",
            "empty",
            "error",
            "offline",
            "edge_input"
