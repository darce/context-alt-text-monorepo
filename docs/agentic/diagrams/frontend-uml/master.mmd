
graph TB
    %% =======================================================================
    %% WORDPRESS PLUGIN FRONTEND V4.2.4 - MASTER OVERVIEW
    %% Updated: December 6, 2025
    %% Status: Core implementation complete
    %% =======================================================================

    subgraph Pages["React Pages ✅"]
        Dashboard["DashboardPage<br/>Overview & Stats"]
        Workbench["WorkbenchPage<br/>Media Selection & Clustering"]
        Roster["RosterPage<br/>Identity Management"]
    end

    subgraph WorkbenchComponents["Workbench Components ✅"]
        MediaSelection["MediaSelection<br/>Grid view, multi-select"]
        IdentityClusterList["IdentityClusterList<br/>Cluster cards with faces"]
        TrainingBanner["TrainingStageBanner<br/>Adaptive threshold display"]
        Panels["Panels<br/>Collapsible sections"]
    end

    subgraph APILayer["API Layer ✅"]
        ScanApi["scanApi<br/>POST /analyze<br/>GET /jobs/{id}"]
        ClusterApi["clusterApi<br/>POST /clustering/jobs<br/>GET /clusters<br/>PATCH /clusters/{id}"]
        IdentityApi["identityApi<br/>GET /media/identities<br/>GET /suggestions"]
        RosterApi["rosterApi<br/>Roster CRUD operations"]
    end

    subgraph Hooks["React Hooks ✅"]
        UseRecognition["useRecognitionHooks<br/>Scan & cluster mutations"]
        UseJobHistory["useRecognitionJobHistory<br/>Job polling & progress"]
        UseMediaIdentities["useMediaIdentities<br/>Identity fetching"]
        UseWorkbenchMedia["useWorkbenchMedia<br/>Media grid state"]
        UseFilters["useWorkbenchFilters<br/>Filter state management"]
        UseSelection["useMediaSelectionState<br/>Multi-select state"]
    end

    subgraph PHPProxy["WordPress PHP Proxy ✅"]
        RecognitionController["RecognitionController<br/>REST route registration"]
        ProxyController["RecognitionProxyController<br/>Forward to backend"]
        ApiClass["Api Class<br/>Auth & headers"]
    end

    subgraph Backend["Recognition Service Backend"]
        BackendAPI[("FastAPI<br/>/recognition/*")]
    end

    %% Page to Component connections
    Workbench --> MediaSelection
    Workbench --> IdentityClusterList
    Workbench --> TrainingBanner
    Workbench --> Panels

    %% Component to Hook connections
    MediaSelection --> UseWorkbenchMedia
    MediaSelection --> UseSelection
    IdentityClusterList --> UseMediaIdentities
    TrainingBanner --> UseRecognition

    %% Hook to API connections
    UseRecognition --> ScanApi
    UseRecognition --> ClusterApi
    UseJobHistory --> ScanApi
    UseMediaIdentities --> IdentityApi

    %% API to Proxy connections
    ScanApi --> RecognitionController
    ClusterApi --> RecognitionController
    IdentityApi --> RecognitionController
    RecognitionController --> ProxyController
    ProxyController --> ApiClass

    %% Proxy to Backend
    ApiClass --> BackendAPI

    %% Styling
    style Pages fill:#e3f2fd,stroke:#0d47a1,color:#0d47a1
    style WorkbenchComponents fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20
    style APILayer fill:#fff3e0,stroke:#f57c00,color:#e65100
    style Hooks fill:#f3e5f5,stroke:#6a1b9a,color:#4a148c
    style PHPProxy fill:#fce4ec,stroke:#ad1457,color:#880e4f
    style Backend fill:#e0e0e0,stroke:#616161,color:#424242