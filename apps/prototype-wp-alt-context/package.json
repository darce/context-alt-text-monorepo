{
  "name": "prototype-wp-alt-context",
  "version": "0.0.1",
  "description": "WordPress plugin configuration",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite",
    "build": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "arch": "node scripts/check-architecture-compliance.js",
    "arch:tips": "node scripts/check-architecture-compliance.js --tips",
    "arch:verbose": "node scripts/check-architecture-compliance.js --tips --verbose",
    "check:all": "npm run lint:fix && npm run format:fix && npm run typecheck && npm run arch:verbose && npm run test",
    "typecheck": "tsc --noEmit --project tsconfig.type-check.json",
    "nuke": "rm -rf node_modules public && npm install && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^22.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-curly": "^0.4.1",
    "sass": "^1.80.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "vitest-axe": "^0.1.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.90.7",
    "@wordpress/element": "^6.34.0",
    "@wordpress/i18n": "^6.7.0",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.554.0",
    "react-router-dom": "^7.9.5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
