  "actions": [
    {
      "id": "start",
      "verb": "Start review",
      "target": "finding",
      "hierarchy": "primary",
      "costly": false,
      "irreversible": false,
      "preview_required": false,
      "screen_id": "session"
    },
    {
      "id": "save",
      "verb": "Save & Next",
      "target": "finding",
      "hierarchy": "primary",
      "costly": false,
      "irreversible": false,
      "preview_required": false,
      "screen_id": "finding"
    },
    {
      "id": "export",
      "verb": "Export my judgments",
      "target": "local JSONL download",
      "hierarchy": "primary",
      "costly": false,
      "irreversible": false,
      "preview_required": false,
      "screen_id": "complete"
    },
    {
      "id": "previous",
      "verb": "Previous finding",
      "target": "finding",
      "hierarchy": "secondary",
      "screen_id": "finding"
    },
    {
      "id": "skip",
      "verb": "Skip this finding",
      "target": "finding",
      "hierarchy": "secondary",
      "screen_id": "finding"
    }
  ],
  "flows": [
    {
      "id": "label-findings",
      "job": "review",
      "label": "Start → inspect evidence → annotate validity, disposition and provenance → save → export",
      "steps": [
        {
          "screen_id": "session"
        },
        {
          "screen_id": "finding"
        },
        {
          "screen_id": "complete"
        }
      ]
    }
  ],
  "open_questions": [
    "Independent expert attestations and external QC require verification by actual humans; role, notes and agreement cannot certify gold.",
    "Human usability and assistive-technology acceptance remain external."
  ],
  "not_doing": [
    "Public publication",
    "Model-generated gold",
    "Quality approval without human QC",
    "Retrieval relevance labeling in this finding-labeling flow",
    "Rewrite legacy journal events or infer their disposition/exposure",
    "Adjudicate the 99 unlisted presentations",
    "Resolve UI19998 or capture19999 or reset their original identities/counters"
  ]
}
