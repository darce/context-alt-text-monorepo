classDiagram
%% Recognition Data Structures (Front-end) — current TS types

class BoundingBox {
  +x: number
  +y: number
  +width: number
  +height: number
}

class RepresentativeBounds {
  +media_id: number | null
  +bbox: BoundingBox
}

class ClusterIdentity {
  +id: string
  +media_id: number
  +similarity: number
  +confidence: number
  +bbox: BoundingBox
  +thumbnail_url: string?
  +debug_metrics: DebugMetrics?
}

class DetectedIdentity {
  +id: string
  +media_id: number
  +cluster_id: string | null
  +cluster_label: string | null
  +is_auto_label: boolean
  +bbox: BoundingBox
  +confidence: number
  +similarity: number | null
  +detected_at: string?
  +thumbnail_url: string?
  +debug_metrics: DebugMetrics?
}

class DebugMetrics {
  +pose: { pitch:number, yaw:number, roll:number }
  +age: number
  +gender: "female" | "male"
  +det_score: number
  +bbox_area: number
  +landmark_quality: number
  +clustering_method: string | null
  +clustering_algorithm: string | null
  +similarity_threshold: number | null
  +match_similarity: number | null
}

class ClusterSummary {
  +id: string
  +label: string
  +is_auto_label: boolean
  +identity_count: number
  +member_ids: string[]
  +representative_identity: RepresentativeBounds
  +sample_identities: ClusterIdentity[]
}

class ClusterSuggestion {
  +cluster_id: string
  +label: string
  +similarity: number
  +identity_count: number
}

class IdentitySuggestionsResponse {
  +matches: ClusterSuggestion[]
}

class MediaIdentitiesResponse {
  +identities_by_media: Map~string, DetectedIdentity[]~
}

class PendingSuggestion {
  +id: string
  +identity_id: string
  +suggested_cluster_id: string
  +representative_similarity: number
  +avg_member_similarity: number
  +confidence_score: number
  +priority: int
  +resolution: string
  +created_at: string
  +resolved_at: string?
  +cluster_label: string?
  +cluster_member_count: int?
  +identity_media_id: int?
}

class TrainingStageResponse {
  +stage: "early" | "developing" | "mature"
  +stage_label: string
  +cluster_count: number
  +identity_count: number
  +current_threshold: number
  +base_threshold: number
  +strict_threshold: number
  +maturity_point: number
  +progress_percent: number
}

ClusterSummary --> RepresentativeBounds
ClusterSummary --> ClusterIdentity : sample_identities
ClusterIdentity --> DebugMetrics
DetectedIdentity --> DebugMetrics
IdentitySuggestionsResponse --> ClusterSuggestion
MediaIdentitiesResponse --> DetectedIdentity
PendingSuggestion --> ClusterSummary : suggested_cluster_id
