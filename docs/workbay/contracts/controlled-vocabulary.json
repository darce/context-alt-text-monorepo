{
  "schema_version": 1,
  "gate_mode": "baseline",
  "target_audience": "Non-expert WordPress site administrators managing media, face grouping, and accessible descriptions.",
  "terms": [
    {
      "banned": "cluster",
      "forms": [
        "cluster",
        "clusters",
        "clustered",
        "clustering"
      ],
      "say": {
        "noun": "face group",
        "verb": "group faces"
      },
      "definition": "A face group is a set of faces the system has placed together because they appear to show the same person.",
      "rationale": "The shipped Workbench and Roster organize this task around faces, groups, and people; these words name what an administrator sees and does without requiring machine-learning vocabulary."
    },
    {
      "banned": "embedding",
      "forms": [
        "embedding",
        "embeddings"
      ],
      "say": {
        "when essential": "face signature",
        "otherwise": "omit the implementation detail"
      },
      "definition": "A face signature is internal numeric recognition data used to compare faces.",
      "rationale": "Face signature connects the data to its purpose; omitting it is clearer whenever the implementation detail does not help the administrator decide or act."
    },
    {
      "banned": "tenant",
      "forms": [
        "tenant",
        "tenants"
      ],
      "say": {
        "site scope": "this site"
      },
      "definition": "This site means the current WordPress site and its data.",
      "rationale": "Administrators recognize the site they are using, while tenant is an infrastructure boundary they should not need to decode."
    },
    {
      "banned": "provenance",
      "forms": [
        "provenance"
      ],
      "say": {
        "source label": "where this came from"
      },
      "definition": "Where this came from identifies the source of a result or piece of data.",
      "rationale": "The replacement asks the ordinary trust question directly instead of naming the abstract record-keeping concept."
    },
    {
      "banned": "outlier",
      "forms": [
        "outlier",
        "outliers"
      ],
      "say": {
        "unassigned face": "unmatched face"
      },
      "definition": "An unmatched face is a detected face that has not been placed in a face group.",
      "rationale": "Unmatched face describes the visible item and its current state, while outlier assumes statistical knowledge and can sound judgmental."
    }
  ],
