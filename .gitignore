# Wordpress - ignore core, configuration, examples, uploads and logs.
# https://github.com/github/gitignore/blob/main/WordPress.gitignore

# Core
#
# Note: if you want to stage/commit WP core files
# you can delete this whole section/until Configuration.
/wp-admin/
/wp-content/index.php
/wp-content/languages
/wp-content/plugins/index.php
/wp-content/themes/index.php
/wp-includes/
/index.php
/license.txt
/readme.html
/wp-*.php
/xmlrpc.php

# Configuration
wp-config.php

# Example themes
/wp-content/themes/twenty*/

# Example plugin
/wp-content/plugins/hello.php

# Uploads
/wp-content/uploads/

# Log files
# *.log

# archives
apps/archived-recognition-service/**
apps/archived-wp-context-alt-text/**

# htaccess
/.htaccess

# All plugins
#
# Note: If you wish to whitelist plugins,
# uncomment the next line
#/wp-content/plugins

# All themes
#
# Note: If you wish to whitelist themes,
# uncomment the next line
#/wp-content/themes

# Reference library (PDFs, extracted notes, marketing — not project planning)
literature/
.DS_Store
# .vscode/settings.json
# .vscode/
.env
.env.*
node_modules/
package-lock.json
public/assets/dist/
storybook-static/
vendor/
composer.lock
.phpunit.result.cache

# Vite build output
**/public/assets/dist/
/dist/
/build/
packages/agent-handoff-mcp/build/

# Python virtual environments (should only exist in apps/recognition-service)
.venv/
venv/
__pycache__/
*.pyc
.hypothesis/

# pip install artifacts
.eggs/
*.egg-info/

# Logs (all service / tool logs)
logs/
apps/prototype-description-service/logs/

# Operational ephemera (local)
CURRENT_TASK.md
DASHBOARD.txt
DASHBOARD.md
.task-state/

# local logs
/docs/agentic/oci-example/*.log

# local retry logs
/retry-apply.log
