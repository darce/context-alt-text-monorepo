# == Runtime mode ==
# Default env in dev/staging/fir. Prod uses oci_vault with a required host-preserved map, whose boot keys are checked by the app at startup. | domain: infra (backend selector) | source: service operator | consumer: shared/secrets.py:get_secret_provider
# RECOGNITION_SECRET_BACKEND=oci_vault
# domain: service root-of-trust (mode flag) | source: service operator | consumer: SecuritySettings / runtime mode gates
RECOGNITION_RUNTIME_MODE=development

# == API security ==
# domain: service root-of-trust (mode flag) | source: service operator | consumer: SecuritySettings.auth_enabled; HTTP auth deps
RECOGNITION_AUTH_ENABLED=1
# Tenant API keys are DB-only (mint via `make dev-mint-key` or /admin).
# The former env-var allowlist bypass is retired (decision #1882); do not re-add.
# domain: service root-of-trust (config) | source: service operator | consumer: HTTP auth dependency (API key header name)
RECOGNITION_API_KEY_HEADER=X-API-Key
# domain: portal auth config | source: service operator | consumer: apps/prototype-description-service/api/main.py:create_app
# RECOGNITION_PORTAL_ENABLED=1
# domain: portal auth config | source: service operator | consumer: apps/prototype-description-service/recognition/interface_adapters/http/deps/portal_composition.py:_portal_auth_settings
# ACX_CLERK_ISSUER=https://issuer.example.test
# domain: portal auth config | source: service operator | consumer: apps/prototype-description-service/recognition/interface_adapters/http/deps/portal_composition.py:_portal_auth_settings
# ACX_CLERK_JWKS_URL=https://issuer.example.test/.well-known/jwks.json
# domain: portal auth config | source: service operator | consumer: apps/prototype-description-service/recognition/interface_adapters/http/deps/portal_composition.py:_portal_auth_settings
# ACX_CLERK_AUDIENCE=portal-audience
# domain: portal auth config | source: service operator | consumer: apps/prototype-description-service/recognition/interface_adapters/http/deps/portal_composition.py:_portal_auth_settings
# ACX_CLERK_AUTHORIZED_PARTIES=https://app.example.test
# domain: portal origin config | source: service operator | consumer: apps/prototype-description-service/recognition/interface_adapters/http/deps/portal_composition.py:_app_public_origin
# APP_PUBLIC_ORIGIN=https://app.example.test
# domain: portal origin config | source: service operator | consumer: apps/prototype-description-service/recognition/interface_adapters/http/deps/portal_composition.py:_app_allowed_origins
# APP_ALLOWED_ORIGINS=https://app.example.test

