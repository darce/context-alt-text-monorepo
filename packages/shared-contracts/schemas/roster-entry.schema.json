{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://context-alt-text.dev/schemas/roster-entry.schema.json",
  "title": "Roster Entry",
  "description": "A roster entry used in the admin UI.",
  "type": "object",
  "required": ["id", "name", "tags", "cluster_count", "updated_at"],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1,
      "description": "Roster entry ID."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name for the entry."
    },
    "tags": {
      "type": "array",
      "description": "Tags associated with the entry.",
      "items": {
        "type": "string"
      }
    },
    "cluster_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of clusters assigned to this entry."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp (ISO 8601)."
    }
  }
}
