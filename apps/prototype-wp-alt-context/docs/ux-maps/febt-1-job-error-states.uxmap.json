    { "id": "job-stall-reconnect", "job": "run-job", "label": "running → stalled (30 s no event) → running (SSE reconnect) or failed", "steps": [ { "screen_id": "workbench-pipeline", "branch_label": "running" }, { "screen_id": "workbench-pipeline", "branch_label": "stalled" }, { "screen_id": "workbench-pipeline", "branch_label": "running | failed" } ] },
