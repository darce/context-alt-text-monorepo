---
title: Persisted Suggestion Review
---
sequenceDiagram
    participant ClusterSvc as IdentityClusteringService
    participant SuggestionSvc as SuggestionService
    participant DB as identity_suggestions table
    participant Client as Admin SPA
    participant API as /recognition/suggestions*
    participant Assign as assign_identity_to_cluster()
    participant Session as AsyncSession

    ClusterSvc->>SuggestionSvc: create_suggestion(identity_id, cluster_id, scores, priority)
    SuggestionSvc->>DB: insert pending suggestion
    DB-->>ClusterSvc: suggestion_id (resolution=pending)

    Client->>API: GET /recognition/suggestions?tenant_id=...
    API->>Session: set_tenant_context()
    API->>DB: fetch pending suggestions + cluster/identity details
    API-->>Client: suggestions[]

    Client->>API: POST /recognition/suggestions/{id}/accept
    API->>Session: set_tenant_context()
    API->>SuggestionSvc: accept_suggestion(id)
    API->>Assign: assign_identity_to_cluster(identity_id, cluster_id)
    API->>SuggestionSvc: expire_suggestions_for_identity(identity_id)
    API->>DB: commit
    API-->>Client: resolution=accepted

    alt user rejects
        Client->>API: POST /recognition/suggestions/{id}/reject
        API->>SuggestionSvc: reject_suggestion(id)
        API->>DB: commit
        API-->>Client: resolution=rejected
    end
