%% Workbench Face Clustering Flow (November 2025)
%% Remote recognition service performs detection and clustering

flowchart TD
    user([Admin Editor]) --> route[WorkbenchPage]

    subgraph WorkbenchUI["Workbench UI"]
        route --> clusterList[IdentityClusterList]
        clusterList --> clusterItem[IdentityClusterItem]
        clusterItem --> combobox[Combobox]
    end

    subgraph HooksAndClients["React Hooks & API Client"]
        clusterItem --> useMutation[useMutation (React Query)]
        clusterItem --> useQuery[useQuery (React Query)]
        useMutation --> api[recognitionApi]
        useQuery --> api
    end

    subgraph ReactQuery["React Query"]
        queryClient[(QueryClient)]
    end

    subgraph WPAPI["WP REST API"]
        suggestionsEndpoint["GET /identities/{id}/suggestions"]
        mergeEndpoint["POST /clusters/merge"]
        revertEndpoint["POST /clusters/revert-merge"]
        splitEndpoint["POST /clusters/{id}/split"]
        updateLabelEndpoint["PATCH /clusters/{id}/label"]
    end

    subgraph PHPDomain["WordPress Domain Layer"]
        proxyController[RecognitionProxyController]
    end

    subgraph RemoteRecognition["Recognition Service (Remote)"]
        remoteSuggest[Suggestion Router]
        remoteCluster[Clustering Service]
    end

    %% Hook ↔ React Query cache
    useQuery --> queryClient
    useMutation --> queryClient

    %% API → REST endpoints
    api -- fetchIdentitySuggestions --> suggestionsEndpoint
    api -- mergeCluster --> mergeEndpoint
    api -- revertMergeCluster --> revertEndpoint
    api -- splitCluster --> splitEndpoint
    api -- updateClusterLabel --> updateLabelEndpoint

    %% REST → Controllers
    suggestionsEndpoint --> proxyController
    mergeEndpoint --> proxyController
    revertEndpoint --> proxyController
    splitEndpoint --> proxyController
    updateLabelEndpoint --> proxyController

    %% Controllers → Services
    proxyController --> remoteSuggest
    proxyController --> remoteCluster

    %% Styling - WCAG-compliant high contrast
    classDef ui fill:#ffffff,stroke:#000000,color:#000000,stroke-width:2px
    classDef hook fill:#f5f5f5,stroke:#000000,color:#000000,stroke-width:1px
    classDef query fill:#e0e0e0,stroke:#000000,color:#000000,stroke-width:1px
    classDef api fill:#cccccc,stroke:#000000,color:#000000,stroke-width:1px
    classDef domain fill:#b0b0b0,stroke:#000000,color:#000000,stroke-width:1px
    classDef remote fill:#999999,stroke:#000000,color:#000000,stroke-width:1px

    class route,clusterList,clusterItem,combobox ui
    class useMutation,useQuery,api hook
    class queryClient query
    class suggestionsEndpoint,mergeEndpoint,revertEndpoint,splitEndpoint,updateLabelEndpoint api
    class proxyController domain
    class remoteSuggest,remoteCluster remote
