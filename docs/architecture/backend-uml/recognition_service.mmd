---
title: InsightFace Recognition Service (Progressive Learning)
---
flowchart LR
    subgraph ports["Ports"]
        recognition_port["RecognitionServicePort\nrecognize_faces(image, threshold)"]
        model_port["RecognitionModelPort\nanalyze(image)\nmodel_info()"]
        embedding_port["EmbeddingRouterPort\nload_embeddings()\nfind_matches(vector, threshold)\nreload_if_needed()"]
        augment_port["AugmentEmbeddingPort\nappend_embedding(person_id, payload)"]
        health_port["ServiceHealthPort\nhealth(), readiness()"]
    end

    subgraph domain["Domain Layer"]
        recognition_service["FaceRecognitionService\n- orchestrates detection → embedding → matches\n- applies thresholds + caching"]
        embedding_refresh_worker["EmbeddingRefreshWorker\n- consumes propagation queue\n- rebuilds FAISS index"]
        propagation_monitor["PropagationMonitor\n- retry/backoff, DLQ alerting"]
        recognition_entities["Domain Entities\nFaceDetection\nFaceEmbedding (512-dim)\nMatchResult\nRecognitionResult\nAugmentCommand"]
        recognition_settings["Settings (Pydantic)\ninsightface, recognition, embedding_router, propagation"]
    end

    subgraph adapters["Adapters"]
        insightface_adapter["InsightFaceAdapter\nimplements RecognitionModelPort"]
        embedding_router_adapter["EmbeddingRouterAdapter\nimplements EmbeddingRouterPort"]
        hybrid_index_manager["HybridIndexManager\n(pgvector ↔ FAISS sync)"]
        propagation_queue_adapter["PropagationQueueAdapter\nimplements QueueConsumer\n(Kafka/SQS/Redis)"]
        index_refresher_adapter["FaissIndexAdapter\n- atomic reload\n- warm cache"]
        augment_repository_adapter["AugmentRepositoryAdapter\n- persists augmented embeddings"]
    end

    subgraph external["External Dependencies"]
        insightface_weights["InsightFace weights / ONNX runtime"]
        pgvector_store["PostgreSQL (pgvector)\nroster storage"]
        faiss_index["FAISS index on disk"]
        propagation_queue["Propagation queue (durable)"]
        recognition_config["recognition_core/config/settings.yaml"]
        cache_dirs["HF_HOME / TORCH_HOME"]
        metrics_sink["Prometheus / OpenTelemetry"]
        alerting_bus["PagerDuty / Slack hooks"]
    end

