flowchart TB
    subgraph api["FastAPI Surface (api/main.py)"]
        app_factory["create_app()\nlogging + cache bootstrap\nStaticFiles /thumbnails"]
        recognition_router["recognition/interface_adapters/http\nrecognition_router + suggestion_router"]
        metrics_router["metrics_router\n/recognition/metrics*"]
        health_routers["/health + subsystem health\nrecognition / roster / scene"]
    end

    subgraph services["Application Services"]
        scan_service["IdentityScanService\nchunked scans + persistence"]
        clustering_service["IdentityClusteringService\nsync/async orchestration"]
        suggestion_service["SuggestionService\nborderline match queue"]
    end

    subgraph clustering["Clustering Orchestration"]
        context_mgr["TenantContextManager\nRLS + centroid refresh"]
        repository["ClusterRepository\nqueries + job records"]
        factory["ClusterFactory\ncreate clusters + centroids"]
        assigner["ClusterAssigner\nmembership + centroid updates"]
        rep_manager["RepresentativeManager\nstore representative embeddings"]
        matcher["RepresentativeMatcher\nrep matching + complete-link"]
        validator["ClusterValidator\nborderline + member checks"]
        batch_processor["BatchClusteringProcessor\nrep match + graph/HDBSCAN"]
        job_service["ClusteringJobService\npending jobs + processing"]
    end

    subgraph infra["Adapters & Infrastructure"]
        embedding_provider["FaceEmbeddingProvider\nInsightFace wrapper"]
        thumbnail_service["ThumbnailService\nbbox crops to filesystem"]
        async_session["AsyncSession (db/session.py)\nget_session dependency"]
        postgres["PostgreSQL + pgvector\nRLS policies"]
        settings["recognition.config.get_settings()\nPydantic settings + YAML/.env"]
    end

