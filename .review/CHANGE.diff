+            fp_tenant_id = fp_tenant.id
+
+        async def conflicting():
+            async with session_factory() as session:
+                await set_tenant_context(session, fp_tenant_id)
+                return await UsageAdmissionService(session).reserve(
+                    fp_tenant_id,
