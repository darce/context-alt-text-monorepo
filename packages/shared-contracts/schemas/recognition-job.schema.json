{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://context-alt-text.dev/schemas/recognition-job.schema.json",
  "title": "Recognition Job",
  "description": "Recognition job status payload returned by the service.",
  "type": "object",
  "required": ["id", "type", "status", "progress", "started_at", "finished_at"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique job identifier (UUID)."
    },
    "type": {
      "type": "string",
      "enum": ["analyze", "clustering", "curation", "split"],
      "description": "Job type."
    },
    "status": {
      "type": "string",
      "enum": ["pending", "running", "completed", "failed"],
      "description": "Current job status."
    },
    "progress": {
      "type": ["object", "null"],
      "description": "Progress tracking for the job.",
      "required": ["completed", "total"],
      "properties": {
        "completed": {
          "type": "integer",
          "minimum": 0,
          "description": "Completed item count."
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total item count."
        }
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when job started."
    },
    "finished_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO 8601 timestamp when job finished."
    },
    "message": {
      "type": ["string", "null"],
      "description": "Optional job status message."
    }
  }
}
