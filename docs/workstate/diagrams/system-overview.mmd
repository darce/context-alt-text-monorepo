            SyncStatus["useSyncStatus"]
            Conflicts["useConflicts"]
            OutboxOps["useOutboxOperations"]
            RetentionState["useRetentionPageState"]
            RosterHooks["useRosterEntries + cluster hooks"]
        end

        subgraph ApiClient["TypeScript API Client"]
            ScanApi["scanApi"]
            ClusterApi["clusterApi + clusterApiMutations"]
            IdentityApi["identityApi"]
            ConflictApi["conflictApi"]
            SyncApi["syncApi"]
            RetentionApi["retentionApi"]
            RosterApi["rosterApi"]
        end

        subgraph PHPLayer["PHP REST Layer"]
            RecognitionCtrl["RecognitionController"]
            BaseProxy["AbstractRecognitionProxyController"]
            ConflictCtrl["ConflictController"]
            SyncCtrl["SyncStatusController"]
            RetentionCtrl["RetentionController"]
        end

        subgraph SovereignSync["Sovereign Sync Layer"]
            Projector["SnapshotProjector"]
            OutboxDrain["OutboxDrain + OutboxDispatcher"]
            ConflictSvc["ConflictResolutionService"]
            Sequencer["CrossPlaneSequencer"]
            SyncStateRepo["SyncStateRepository"]
        end

        subgraph WPData["WP Database Tables"]
            WPCluster["wp_acx_clusters"]
            WPMembers["wp_acx_identity_members"]
            WPOutbox["wp_acx_sync_outbox"]
            WPConflicts["wp_acx_sync_conflicts"]
            WPSyncState["wp_acx_sync_state"]
        end
    end

    subgraph Backend["Recognition Service (prototype-description-service)"]
        subgraph API["FastAPI Routers"]
            AnalyzeRouter["/analyze + /jobs/*"]
            ClusterRouter["/clusters + /clustering/jobs"]
            SuggestionRouter["/suggestions + /identities/*/suggestions"]
            SnapshotRouter["/snapshot/{tenant}"]
            CurationRouter["/curation/sync + /topology/*"]
            RetentionRouter["/retention/policy + /retention/audit + /retention/export + /retention/purge + /retention/import"]
        end

        subgraph Orchestration["Orchestration"]
            ScanService["ScanService"]
            ClusterService["ClusterService"]
            JobService["JobService"]
            SuggestionSvc["SuggestionService"]
            RetentionSvc["Retention application services"]
        end

        subgraph Infra["Infrastructure"]
            EmbeddingService["InsightFaceAdapter"]
            ClusterRepo["ClusterRepository"]
            MemberRepo["MemberRepository"]
            RetentionRepo["Tenant / audit repositories"]
        end
    end

    subgraph Database["PostgreSQL + pgvector"]
        IdentityTables["MediaIdentity<br/>IdentityCluster<br/>IdentityMember"]
        RepTable["ClusterRepresentative"]
        SuggestionTable["IdentitySuggestion"]
        JobTables["ScanJob<br/>ClusteringJob"]
        TenantTables["Tenant<br/>ApiKey<br/>Retention audit state"]
        CentroidMV["mv_identity_cluster_centroids"]
    end

