+		}
+
+		$message = $detail['message'] ?? null;
+		if ( ! is_string( $message ) || '' === $message ) {
+			return false;
+		}
+
+		if ( ! array_key_exists( 'operation_id', $detail ) ) {
+			return false;
+		}
+		$operation_id = $detail['operation_id'];
+		if ( ! is_string( $operation_id ) && null !== $operation_id ) {
