    ClusterJob --> ClusterService --> SuggestionRepo
    ClusterJob -.-> JobService --> JobRepo
    Clusters --> ClusterService --> ClusterRepo
    ClusterPatch --> ClusterService --> ClusterRepo
    Suggestions --> SuggestionService --> SuggestionRepo
    SuggestAccept --> SuggestionService --> SuggestionRepo
    SuggestReject --> SuggestionService --> SuggestionRepo
    MergeSuggestions --> MergeSuggestionRepo
    MergeAccept --> MergeSuggestionRepo
    MergeReject --> MergeSuggestionRepo
    Media --> MediaService --> ClusterRepo
    Diagnostics --> ObsRepo --> DecisionsTable
    Diagnostics -.-> DecisionStore
    Events --> Broadcaster

