engine-strict=true
save-exact=true
min-release-age=2
allow-git=root
# allow-remote=all (not =root): on a fresh tree with no node_modules, npm reify
# must extract every registry tarball, and pacote classifies that extraction as
# spec type "remote" (fetcher.js canUse). With =root that aborts with EALLOWREMOTE,
# so feature worktrees / fresh checkouts can never `npm install`. All deps here are
# registry-hosted, so =root guards nothing real while breaking every cold install.
allow-remote=all
allow-file=root
# allow-directory=all: `npx vitest` fails with EALLOWDIRECTORY when npm's
# libnpmexec hasPkgBin('.') calls pacote.manifest('.'), whose synchronous
# canUse throw for the `directory` spec type with =root is uncaught. This
# package.json declares no `directory:` or local-path dependencies, so =all
# does not remove a meaningful directory-fetch guard here.
allow-directory=all
