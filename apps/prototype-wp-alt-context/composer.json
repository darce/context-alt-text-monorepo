{
  "name": "darce/alt-context",
  "description": "A WordPress plugin that generates contextually relevant alt text for images using AI-powered recognition services.",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=8.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "AltContext\\": "src/"
    },
    "classmap": [
      "src/"
    ]
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "^6.8",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload-dev": {
    "psr-4": {
      "AltContext\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test:unit": "vendor/bin/phpunit --testsuite Unit",
    "cs-check": "vendor/bin/phpcs -n --standard=WordPress --exclude=Squiz.Commenting.FunctionComment,Squiz.Commenting.VariableComment,Squiz.Commenting.FileComment,Squiz.Commenting.ClassComment,Squiz.Commenting.InlineComment,Generic.Commenting.DocComment,WordPress.NamingConventions.ValidVariableName,WordPress.NamingConventions.ValidFunctionName,WordPress.PHP.YodaConditions,WordPress.Files.FileName,Generic.Files.OneObjectStructurePerFile,Generic.WhiteSpace.DisallowSpaceIndent,PEAR.Functions.FunctionCallSignature,Squiz.Functions.FunctionDeclarationArgumentSpacing,Generic.Functions.OpeningFunctionBraceKernighanRitchie,Generic.Classes.OpeningBraceSameLine,WordPress.WhiteSpace.ControlStructureSpacing,WordPress.WhiteSpace.OperatorSpacing,WordPress.WhiteSpace.CastStructureSpacing,WordPress.Arrays.ArrayKeySpacingRestrictions,WordPress.Arrays.ArrayIndentation,WordPress.Arrays.ArrayDeclarationSpacing,WordPress.Arrays.MultipleStatementAlignment,Universal.Arrays.DisallowShortArraySyntax,NormalizedArrays.Arrays.ArrayBraceSpacing,Generic.WhiteSpace.ArbitraryParenthesesSpacing,Generic.Formatting.MultipleStatementAlignment,Universal.WhiteSpace.PrecisionAlignment,Squiz.Strings.DoubleQuoteUsage src alt-context.php",
    "cs-fix": "vendor/bin/phpcbf -n --standard=WordPress --exclude=Squiz.Commenting.FunctionComment,Squiz.Commenting.VariableComment,Squiz.Commenting.FileComment,Squiz.Commenting.ClassComment,Squiz.Commenting.InlineComment,Generic.Commenting.DocComment,WordPress.NamingConventions.ValidVariableName,WordPress.NamingConventions.ValidFunctionName,WordPress.PHP.YodaConditions,WordPress.Files.FileName,Generic.Files.OneObjectStructurePerFile,Generic.WhiteSpace.DisallowSpaceIndent,PEAR.Functions.FunctionCallSignature,Squiz.Functions.FunctionDeclarationArgumentSpacing,Generic.Functions.OpeningFunctionBraceKernighanRitchie,Generic.Classes.OpeningBraceSameLine,WordPress.WhiteSpace.ControlStructureSpacing,WordPress.WhiteSpace.OperatorSpacing,WordPress.WhiteSpace.CastStructureSpacing,WordPress.Arrays.ArrayKeySpacingRestrictions,WordPress.Arrays.ArrayIndentation,WordPress.Arrays.ArrayDeclarationSpacing,WordPress.Arrays.MultipleStatementAlignment,Universal.Arrays.DisallowShortArraySyntax,NormalizedArrays.Arrays.ArrayBraceSpacing,Generic.WhiteSpace.ArbitraryParenthesesSpacing,Generic.Formatting.MultipleStatementAlignment,Universal.WhiteSpace.PrecisionAlignment,Squiz.Strings.DoubleQuoteUsage src alt-context.php"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
