flowchart TD
    subgraph DashboardRuntime
        APP[Dashboard App.tsx]
        CARD[CoverageCard]
        DONUT[CoverageDonut]
        TREND[CoverageTrend]
        ALERT[Inline Retry Button]
        SR[Screen Reader Summary]
    end

    subgraph ReactQuery
        HOOK[useCoverageMetrics]
        CACHE[(QueryClient Cache)]
    end

    subgraph Config
        GLOBAL[window.ContextAltTextAdmin]
        FLAGS[featureFlags.coverageTrend]
        ENDPOINT[endpoints.coverage]
        NONCE[restNonce]
    end

    subgraph Analytics
        TRACKER[emitDashboardEvent]
        IO[IntersectionObserver]
        WP[WP analytics listeners]
    end

    subgraph CoverageAPI
        FETCH[fetch]
        REST[WP dashboard coverage endpoint]
    end

    APP --> CARD
    CARD -->|uses| DONUT
    CARD -->|conditional trend| TREND
    CARD -->|retry action| ALERT
    CARD -->|aria-describedby| SR
    CARD-->|queryState|HOOK
    HOOK --> CACHE
    HOOK -->|reads config| GLOBAL
    GLOBAL --> FLAGS
    GLOBAL --> ENDPOINT
    GLOBAL --> NONCE

    HOOK -->|conditionally enabled| ENDPOINT
    HOOK -->|inject nonce header| NONCE
    HOOK --> FETCH
    FETCH --> REST

    FLAGS -->|trend gated| TREND

    IO --> CARD
    IO -->|signals visible| TRACKER
    TRACKER -->|dispatch event| WP
    TRACKER -->|cat_dashboard_card_seen| WP
    TRACKER -->|cat_dashboard_coverage_trend_enabled| WP

    CARD -->|axe + RTL tests| TESTS[Vitest suite]
    TESTS -->|simulates| HOOK
    TESTS -->|asserts| FLAGS
