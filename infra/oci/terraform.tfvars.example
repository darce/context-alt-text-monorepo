tenancy_ocid     = "ocid1.tenancy.oc1..aaaaaa..."
user_ocid        = "ocid1.user.oc1..aaaaaa..."
fingerprint      = "aa:bb:cc:..."  # `oci iam user api-key list --user-id <user_ocid>`
private_key_path = "~/.oci/oci_api_key.pem"  # must match the fingerprint above; update both on rotation
region           = "us-ashburn-1"

compartment_ocid    = "ocid1.compartment.oc1..aaaaaa..."
ssh_public_key_path = "~/.ssh/id_rsa.pub"
availability_domain = "saEG:US-ASHBURN-AD-1"
# Find the latest ARM image OCID: https://docs.oracle.com/en-us/iaas/images/
# or run: oci compute image list --compartment-id <tenancy> --shape VM.Standard.A1.Flex --operating-system Ubuntu --query data[0].id
ubuntu_image_ocid  = "ocid1.image.oc1.iad.aaaaaaaa5hgxi6voge43kultiindj3cbcnsimyatvlmq7wt5sbm6voo2ln3a"
# GPU golden image must be x86_64 and pre-bake NVIDIA drivers, Docker,
# nvidia-container-toolkit, and /opt/acx-gpu/models/qwen3-vl-30b-a3b-instruct-q4.gguf.
gpu_image_ocid = "ocid1.image.oc1.iad.aaaaaaaa-gpu-golden-image"
gpu_shape      = "VM.GPU.A10.1"

# Independent on-instance cost guard; cloud-init starts the timer before the
# VLM service. A failed OCI stop uses the bounded guest poweroff fallback and
# is audited as STOPPED-by-guest.
gpu_max_uptime_seconds = 3600
gpu_self_stop_enabled  = true

ssh_allowed_cidrs = ["YOUR_IP/32"]
