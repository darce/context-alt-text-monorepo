# Demo stack secrets template — copy to /opt/acx-backend/demo/secrets/.env (chmod 600).
# Real credentials live on the VM only; never commit populated values.

COMPOSE_PROJECT_NAME=acx-demo
ACX_DEMO_WPDATA_PATH=/opt/acx-backend/data/demo-wpdata
ACX_DEMO_DBDATA_PATH=/opt/acx-backend/data/demo-dbdata

MARIADB_DATABASE=acx_demo
MARIADB_USER=acx_demo
MARIADB_PASSWORD=replace-me
MARIADB_ROOT_PASSWORD=replace-me-root

WORDPRESS_DB_NAME=acx_demo
WORDPRESS_DB_USER=acx_demo
WORDPRESS_DB_PASSWORD=replace-me

# Strong generated values — required before bootstrap-wp.sh runs.
WP_ADMIN_USER=acx-demo-admin
WP_ADMIN_PASSWORD=replace-me-admin
WP_ADMIN_EMAIL=ops@altcontext.com

# The define() values inside WORDPRESS_CONFIG_EXTRA below are the ONLY operative
# plugin config — the plugin reads PHP constants, not env vars. There are no
# standalone ACX_RECOGNITION_*/WP_AUTO_UPDATE_CORE vars here on purpose: a second
# copy would drift from the constants at cutover. Edit the define() values directly.
#
# Constants to set (staged rollout: staging.api first, then api.altcontext.com at launch):
#   ACX_RECOGNITION_URL        https://staging.api.altcontext.com -> https://api.altcontext.com
#   ACX_RECOGNITION_SOURCE     service
#   ACX_RECOGNITION_API_KEY    minted key (tenant-mint-runbook.md) — never commit
#   ACX_RECOGNITION_TENANT_ID  explicit tenant UUID — NEVER URL-derived/JIT
#   WP_AUTO_UPDATE_CORE        true
#
# Set WORDPRESS_CONFIG_EXTRA in secrets/.env as a single line (env-file values are not
# compose-interpolated). Example — copy/adapt with real secret values:
# WORDPRESS_CONFIG_EXTRA=define('ACX_RECOGNITION_URL','https://staging.api.altcontext.com'); define('ACX_RECOGNITION_SOURCE','service'); define('ACX_RECOGNITION_API_KEY','replace-me'); define('ACX_RECOGNITION_TENANT_ID','00000000-0000-4000-8000-000000000001'); define('WP_AUTO_UPDATE_CORE', true);
WORDPRESS_CONFIG_EXTRA=
