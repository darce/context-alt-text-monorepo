{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://context-alt-text.dev/schemas/recognition-cluster-list-response.schema.json",
  "title": "Recognition Cluster List Response",
  "description": "Legacy unfiltered WordPress cluster list envelope. For opt-in min_photos requests validate against #/definitions/photoFilteredResponse; total may be unknown and rows may have the remote recognition shape. Missing photo_count is unavailable, never zero or a face count. For opt-in top-unlabeled review pages use #/definitions/reviewPhotoFilteredResponse; the legacy top-unlabeled root remains the unfiltered contract.",
  "type": "object",
  "required": ["clusters", "limit", "total", "truncated"],
  "properties": {
    "clusters": {
      "type": "array",
      "description": "Cluster summaries returned by GET /recognition/clusters.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "label_state",
          "identity_count",
          "member_ids",
          "representative_identity",
          "sample_identities",
          "person_uuid"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable cluster UUID."
          },
          "label": {
            "type": ["string", "null"],
            "description": "Resolved cluster label presented by the admin UI."
          },
          "label_state": {
            "type": "string",
            "enum": ["person", "unlabeled", "unbound"],
            "description": "Named label authority: person (bound person name), unlabeled (empty/null or reserved cluster-*), unbound (human label with no person bind)."
          },
          "is_auto_label": {
            "type": "boolean",
            "description": "Whether the label is system-derived."
          },
          "identity_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Observed member-row count when the member fetch is not truncated (list preview cap PREVIEW_IDENTITIES_PER_CLUSTER=4; detail cap DEFAULT_CLUSTER_MEMBER_LIMIT=500). When the fetch returns more than the cap, this is the projected column and representatives/samples are sliced to the cap."
          },
          "photo_count": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "Distinct photos across the complete group. Absence or null means unavailable."
          },
          "member_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Identity UUIDs already present in the local projection for this cluster."
          },
          "representative_identity": {
            "type": "object",
            "required": ["media_id", "bbox"],
            "properties": {
              "media_id": {
                "type": ["integer", "null"],
                "minimum": 1,
                "description": "Attachment ID for the current representative image when available."
              },
              "bbox": {
                "type": ["object", "null"],
                "required": ["x", "y", "width", "height"],
                "description": "Face rect in the pixel space of media_url, not of the original attachment: a deleted original degrades url and bbox together into the largest surviving sub-size.",
                "properties": {
                  "x": { "type": "integer", "minimum": 0 },
                  "y": { "type": "integer", "minimum": 0 },
                  "width": { "type": "integer", "minimum": 0 },
                  "height": { "type": "integer", "minimum": 0 }
                }
              },
              "thumb_url": {
                "type": ["string", "null"],
                "format": "uri"
              },
              "attachment_url": {
                "type": ["string", "null"],
                "format": "uri"
              },
              "media_url": {
                "type": ["string", "null"],
                "format": "uri"
              }
            }
          },
          "sample_identities": {
            "type": "array",
            "description": "Preview identities included with the cluster summary for UI rendering.",
            "items": {
              "type": "object",
              "required": ["identity_id", "media_id", "similarity", "confidence", "bbox"],
              "properties": {
                "identity_id": {
                  "type": "string"
                },
                "media_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "similarity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "clustering_pending": {
                  "type": "boolean"
                },
                "bbox": {
                  "type": "object",
                  "required": ["x", "y", "width", "height"],
                  "description": "Face rect in the pixel space of media_url, not of the original attachment: a deleted original degrades url and bbox together into the largest surviving sub-size.",
                  "properties": {
                    "x": { "type": "integer", "minimum": 0 },
                    "y": { "type": "integer", "minimum": 0 },
                    "width": { "type": "integer", "minimum": 0 },
                    "height": { "type": "integer", "minimum": 0 }
                  }
                },
                "thumb_url": {
                  "type": ["string", "null"],
                  "format": "uri"
                },
                "attachment_url": {
                  "type": ["string", "null"],
                  "format": "uri"
                },
                "media_url": {
                  "type": ["string", "null"],
                  "format": "uri"
                }
              }
            }
          },
          "confidence_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "person_uuid": {
            "type": ["string", "null"],
            "description": "Person UUID bound via wp_acx_clusters.person_id → persons.person_uuid. Null when the cluster is not assigned to a person."
          }
        }
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "description": "Maximum number of cluster summaries returned in this response."
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of matching clusters available for the request."
    },
    "truncated": {
      "type": "boolean",
      "description": "Whether additional matching clusters exist beyond this page."
    }
  },
  "definitions": {
    "min_photos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Optional query parameter. Omission means All; no display-page filtering."
    },
    "remoteCluster": {
      "type": "object",
      "required": [
        "id",
        "tenant_id",
        "label",
        "is_labeled",
        "is_auto_label",
        "identity_count",
        "representatives",
        "person_uuid"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_labeled": {
          "type": "boolean"
        },
        "is_auto_label": {
          "type": "boolean"
        },
        "identity_count": {
          "type": "integer",
          "minimum": 0
        },
        "photo_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "person_uuid": {
          "type": "null",
          "description": "Remote labels never establish a local WordPress person binding."
        },
        "representatives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "media_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "bbox": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "is_user_selected": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "photoFilteredResponse": {
      "type": "object",
      "description": "Opt-in listing envelope. Distinct photo filter is applied by the producer before pagination; unknown total remains null and truncated controls continuation. Older missing aggregates remain unavailable.",
      "required": [
        "clusters",
        "limit",
        "total",
        "truncated"
      ],
      "properties": {
        "clusters": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/properties/clusters/items"
              },
              {
                "$ref": "#/definitions/remoteCluster"
              }
            ]
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "reviewPhotoFilteredResponse": {
      "type": "object",
      "required": [
        "clusters",
        "limit",
        "total",
        "truncated",
        "data_source",
        "repair_pending"
      ],
      "properties": {
        "clusters": {
          "type": "array",
          "description": "Top unlabeled clusters returned by GET /recognition/clusters/top-unlabeled.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "tenant_id",
              "label",
              "label_state",
              "is_labeled",
              "is_auto_label",
              "identity_count",
              "user_confirmed",
              "representatives"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "tenant_id": {
                "type": "string"
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "label_state": {
                "type": "string",
                "enum": [
                  "person",
                  "unlabeled",
                  "unbound"
                ],
                "description": "Named label authority: person (bound person name), unlabeled (empty/null or reserved cluster-*), unbound (human label with no person bind)."
              },
              "is_labeled": {
                "type": "boolean"
              },
              "is_auto_label": {
                "type": "boolean"
              },
              "identity_count": {
                "type": "integer",
                "minimum": 0,
                "description": "Observed member-row count when the representative preview is not truncated. When the preview is truncated, identity_count = max(projected, representatives.length). Always identity_count >= representatives.length."
              },
              "user_confirmed": {
                "type": "boolean"
              },
              "suggested_label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "suggested_label_source": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "suggested_label_confidence": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "suggested_target_cluster_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "representatives": {
                "type": "array",
                "minItems": 1,
                "description": "Preview of observed members (cap 4). Non-empty for top-unlabeled queue rows. identity_count reflects observed members when this array is shorter than the preview cap.",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": [
                        "id",
                        "media_id",
                        "is_pinned"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "media_id": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 1
                        },
                        "thumb_url": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "uri"
                        },
                        "media_url": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "uri"
                        },
                        "bbox": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "required": [
                            "x",
                            "y",
                            "width",
                            "height"
                          ],
                          "properties": {
                            "x": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "y": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "width": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "height": {
                              "type": "integer",
                              "minimum": 0
                            }
                          }
                        },
                        "is_pinned": {
                          "type": "boolean"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "id"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "media_id": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "bbox": {
                          "type": [
                            "object",
                            "null"
                          ]
                        },
                        "is_user_selected": {
                          "type": "boolean"
                        }
                      }
                    }
                  ]
                }
              },
              "photo_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "description": "Distinct photos across the complete group. Absence or null means unavailable."
              }
            }
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "description": "Maximum number of clusters requested for the naming queue response."
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Qualifying filtered population total when available; never substitute page length for unknown."
        },
        "truncated": {
          "type": "boolean",
          "description": "Whether additional unlabeled clusters exist beyond this response. Paging only — invariant filtering does not set this flag."
        },
        "repair_pending": {
          "type": "boolean",
          "description": "True when this response requested targeted projection repair or dropped invariant-failing rows. Drives the review-queue Resync affordance."
        },
        "singleton_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of singleton clusters omitted from the naming queue when projection data is available."
        },
        "data_source": {
          "type": "string",
          "description": "Source of the naming queue response envelope."
        },
        "projection_status": {
          "type": "string",
          "description": "Projection bootstrap state when the response depends on local sync status."
        }
      },
      "description": "Opt-in min_photos top-unlabeled review envelope. Preserves the existing unlabeled population and suggestion producers. Filter the full membership aggregate before pagination; truncated controls continuation when total is unknown."
    }
  }
}
