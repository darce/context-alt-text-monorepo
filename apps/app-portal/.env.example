# Production Vite build-time values for app-portal.
#
# Consumed by `apps/app-portal/src/config.ts` through Vite's `import.meta.env`.
# These values are public and ship in the browser bundle. The public production
# Clerk pk_live_ publishable key is committed in 60-app-portal.toml; it is public
# by design, never a Clerk secret.

# == Portal public build ==
# Clerk publishable key. This public key is embedded in the browser bundle;
# the local test key is never valid for production builds.
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk Frontend API origin consumed by `apps/app-portal/src/config.ts`.
VITE_CLERK_FAPI=https://clerk.altcontext.com
# Controls whether the portal renders its enabled experience.
VITE_PORTAL_ENABLED=true
# Controls whether portal checkout and subscription management are enabled.
VITE_PAYMENTS_ENABLED=false
# Optional public plan code accepted by the backend catalog map. Leave unset
# while payments are disabled; an empty value is parsed as no plan code.
# VITE_PUBLIC_PLAN_CODE=
