---
title: Roster Domain Overview
---
classDiagram
    class RosterImage {
        +embedding : List~float~
        +metadata : Dict
        +image_path : Optional~str~
        +to_dict()
        +from_dict(data)
    }

    class RosterEntry {
        +name : str
        +display_name : str
        +unique_id : str
        +reference_images : List~RosterImage~
        +aggregate_embedding : Optional~List~float~~
        +metadata : Dict
        +created_timestamp : str
        +updated_timestamp : str
        +image_count : int
        +add_reference_image(image)
        +add_augmented_embedding(vector, source, observation_id, metadata) bool
        +to_dict()
        +from_dict(data)
    }

    class RosterStoragePort {
        <<interface>>
        +save_roster_entry(entry, model) bool
        +load_roster_entries(model) List~RosterEntry~
        +get_roster_entry(unique_id, model) Optional~RosterEntry~
        +delete_roster_entry(unique_id, model) bool
        +roster_exists(model) bool
        +clear_roster(model) bool
        +get_storage_info(model) Dict
    }

    class DataValidationPort {
        <<interface>>
        +validate_embedding(embedding, model) List~str~
        +validation_config : Dict
    }

    class RosterService {
        -roster_storage : RosterStoragePort
        -data_validator : DataValidationPort
        -_cache : Dict~str,List~RosterEntry~~
        +add_entry(name, embedding, model, metadata, image_path) Optional~RosterEntry~
        +add_entries_bulk(payload, model) List~str~
        +add_augmented_embedding(unique_id, model, embedding, source, observation_id, metadata) bool
        +get_entries(model, use_cache=True) List~RosterEntry~
        +get_entry(unique_id, model) Optional~RosterEntry~
        +update_entry(unique_id, model, embedding, metadata, image_path) bool
        +delete_entry(unique_id, model) bool
        +clear_roster(model) bool
        +get_entry_count(model) int
        +get_storage_info(model) Dict
    }

    class PostgreSQLStorageAdapter {
        +save_roster_entry(...)
        +load_roster_entries(...)
        +get_storage_info(...)
        +search_similar(query_embedding, model, top_k, threshold) List~Tuple~
    }

    class SQLiteStorageAdapter {
        +save_roster_entry(...)
        +load_roster_entries(...)
        +clear_roster(...)
    }

    RosterEntry "1" *-- "*" RosterImage
    RosterService --> RosterStoragePort
    RosterService --> DataValidationPort
    RosterStoragePort <|.. PostgreSQLStorageAdapter
    RosterStoragePort <|.. SQLiteStorageAdapter
