```mermaid.radar
---
title: Recognition Pipeline Components (V2 - AssignmentGate Architecture)
---
flowchart LR
    subgraph ingestion["Ingestion"]
        analyze_endpoint["/recognition/analyze\nchunked BackgroundTasks"]
        scan["IdentityScanService\nscan_identities()"]
        embed["FaceEmbeddingProvider\nInsightFace 1024D\nFACE ONLY similarity"]
        thumb["ThumbnailService\noptional crops"]
        persist_identity["MediaIdentity + IdentityScanJob\nrows persisted"]
    end

    subgraph discovery["Discovery Phase (No Assignments)"]
        rep_disc["RepresentativeDiscovery\nfind candidates via reps"]
        cent_disc["CentroidDiscovery\nfind candidates via centroids"]
        graph_disc["GraphDiscovery\nHDBSCAN/Chinese Whispers"]
    end

    subgraph gate["AssignmentGate (Single Validation Point)"]
        assignment_gate["AssignmentGate\nevaluate(candidate)"]
        maturity_check["MaturityCheck\n≥2 diverse reps?"]
        complete_link["CompleteLinkCheck\nmatch ALL reps?"]
        member_dist["MemberDistributionCheck\navg member similarity?"]
        confidence["ConfidenceCheck\ndiscovery_sim threshold?"]
    end

    subgraph writers["Output Routing"]
        writer["AssignmentWriter\nACCEPT → assign"]
        suggestions["SuggestionService\nSUGGEST → human review"]
        unclustered["Unclustered Pool\nREJECT → skip"]
    end

    subgraph orchestrator["Orchestration"]
        cluster["ClusteringService\ncluster_unclustered_identities()"]
        context_mgr["TenantContextManager\nSET LOCAL app.current_tenant\nrefresh MV"]
        repo["ClusterRepository\nunclustered ids + centroids"]
        factory["ClusterFactory\ncreates new clusters"]
        jobs["ClusteringJobService\nsync vs async jobs"]
    end

    note top of assignment_gate
        KEY IMPROVEMENT:
        ALL paths go through ONE gate
        - RepresentativeDiscovery
        - CentroidDiscovery  
        - GraphDiscovery
        Same validation for all!
    end note

    subgraph persistence["Persistence"]
        pg["PostgreSQL + pgvector\nidentities, clusters, reps, members,\nsuggestions, jobs, centroids MV"]
    end

    %% Ingestion flow
    analyze_endpoint --> scan
    scan --> embed
    embed --> scan
    scan --> thumb
    scan --> persist_identity
    persist_identity --> pg

    %% Discovery flow - all produce candidates
    cluster --> rep_disc
    cluster --> cent_disc
    cluster --> graph_disc
    rep_disc --> assignment_gate
    cent_disc --> assignment_gate
    graph_disc --> assignment_gate

    %% Gate runs all checks
    assignment_gate --> maturity_check
    assignment_gate --> complete_link
    assignment_gate --> member_dist
    assignment_gate --> confidence

    %% Output routing based on decision
    assignment_gate -->|ACCEPT| writer
    assignment_gate -->|SUGGEST| suggestions
    assignment_gate -->|REJECT| unclustered

    %% Orchestration dependencies
    cluster --> context_mgr
    cluster --> repo
    cluster --> factory
    cluster --> jobs

    %% Persistence
    writer --> pg
    suggestions --> pg
    repo --> pg
    context_mgr --> pg
```
