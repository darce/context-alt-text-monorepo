{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/filter-test-output.py\"",
            "statusMessage": "Summarizing test output",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
