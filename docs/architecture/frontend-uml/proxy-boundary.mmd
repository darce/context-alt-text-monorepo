
flowchart TB
    %% =======================================================================
    %% WORDPRESS PLUGIN - FRONTEND ↔ BACKEND BOUNDARY
    %% Shows the proxy architecture between WP and Recognition Service
    %% Updated: December 6, 2025
    %% =======================================================================

    subgraph Browser["Browser (React SPA) ✅"]
        direction TB
        
        subgraph Pages["Page Components"]
            WB["WorkbenchPage"]
            RP["RosterPage"]
            DP["DashboardPage"]
        end
        
        subgraph Hooks["React Hooks"]
            URH["useRecognitionHooks"]
            UJH["useRecognitionJobHistory"]
            UMI["useMediaIdentities"]
        end
        
        subgraph APIClient["API Client Layer"]
            SA["scanApi.ts"]
            CA["clusterApi.ts"]
            IA["identityApi.ts"]
            CFG["config.ts<br/>BASE_URL, headers"]
        end
        
        Pages --> Hooks
        Hooks --> APIClient
        
        style Browser fill:#e3f2fd,stroke:#0d47a1,stroke-width:2px,color:#0d47a1
    end

    WPREST[/"══════ WordPress REST API ══════<br/>/wp-json/alt-context/v1/recognition/*<br/>Nonce-authenticated ✅"/]

    subgraph WordPress["WordPress PHP Layer ✅"]
        direction TB
        
        subgraph Controllers["REST Controllers"]
            RC["RecognitionController<br/>Route registration"]
            RPC["RecognitionProxyController<br/>Request forwarding"]
        end
        
        subgraph Auth["Authentication"]
            NONCE["WP Nonce Validation"]
            APIKEY["API Key Storage<br/>wp_options"]
        end
        
        subgraph ApiClient["HTTP Client"]
            API["Api Class<br/>wp_remote_request()"]
        end
        
        RC --> RPC
        RC --> NONCE
        RPC --> APIKEY
        RPC --> API
        
        style WordPress fill:#fce4ec,stroke:#ad1457,stroke-width:2px,color:#880e4f
    end

    BACKEND[/"══════ Recognition Service API ══════<br/>FastAPI /recognition/*<br/>API Key authenticated ✅"/]

    subgraph RecognitionService["Recognition Service Backend ✅"]
        direction TB
        
        subgraph Routers["FastAPI Routers"]
            AR["AnalyzeRouter"]
            CR["ClusterRouter"]
            SR["SuggestionRouter"]
            MR["MediaRouter"]
        end
        
        subgraph Security["Security Layer"]
            RA["require_auth"]
            RWA["require_write_access"]
        end
        
        subgraph Services["Application Services"]
            SS["ScanService"]
            CS["ClusterService"]
            JS["JobService"]
        end
        
        Routers --> Security
        Security --> Services
        
        style RecognitionService fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1b5e20
    end

    %% Connections between layers
    APIClient --> WPREST
    WPREST --> Controllers
    API --> BACKEND
    BACKEND --> Routers

    %% Request flow annotations
    subgraph Legend["Request Flow"]
        direction LR
        L1["1. React calls API client"]
        L2["2. Fetch to WP REST endpoint"]
        L3["3. PHP proxy forwards to backend"]
        L4["4. Backend processes & responds"]
        L5["5. Response flows back through proxy"]
        
        style Legend fill:#f5f5f5,stroke:#9e9e9e,color:#424242
    end

    style WPREST fill:#fff3e0,stroke:#bf360c,stroke-width:3px,color:#bf360c
    style BACKEND fill:#fff3e0,stroke:#bf360c,stroke-width:3px,color:#bf360c
