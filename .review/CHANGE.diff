+    expect(fetchImpl).not.toHaveBeenCalled();
+  });
+
+  it('allows same-origin relative /portal/ paths including key list query [DATA-03]', async () => {
+    const fetchImpl = vi.fn(async (input: RequestInfo | URL) => {
