%% Updated: 2026-03-28
%% Workbench scan + confirm flow (React Query + WP REST)

flowchart TD
    user([Admin]) --> workbench[WorkbenchPage]

    subgraph UI["Workbench UI"]
        workbench --> syncIndicator[SyncStatusIndicator]
        workbench --> scanTab[ScanTabContent]
        workbench --> confirmTab[ConfirmTabContent]
        workbench --> overlay[ConflictInbox / DeadLetterPanel]
    end

    subgraph State["Workbench context + hooks"]
        workbench --> context[WorkbenchContext]
        context --> mediaHooks[useWorkbenchMedia + useMediaSelectionState + useWorkbenchFilters]
        context --> stateMachine[useJobStateMachine]
        overlay --> overlayHooks[useConflicts + useOutboxOperations + useSyncStatus]
        confirmTab --> reviewHooks[useRecognitionClusters + useClusterSuggestions]
    end

    subgraph Cache["React Query Cache"]
        queryClient[(QueryClient)]
    end

    subgraph WPAPI["WP REST (proxy endpoints)"]
        workbenchMedia["GET /acx/v1/workbench/media"]
        postAnalyze["POST /acx/v1/recognition/analyze"]
        getJobs["GET /acx/v1/recognition/jobs/{id}"]
        postCluster["POST /acx/v1/recognition/cluster"]
        getClusters["GET /acx/v1/recognition/clusters"]
        getSuggestions["GET /acx/v1/recognition/suggestions"]
        getConflicts["GET /acx/v1/recognition/conflicts"]
        getOutbox["GET /acx/v1/recognition/outbox"]
        getSync["GET /acx/v1/recognition/sync-status"]
    end

    subgraph Remote["Recognition Service"]
        analyze["/analyze"]
        jobs["/jobs/{id}"]
        cluster["/clustering/jobs or cluster mutations"]
        clusters["/clusters"]
        suggestions["/suggestions"]
        conflicts["sync conflict + outbox surfaces"]
    end

    mediaHooks --> queryClient
    stateMachine --> queryClient
    overlayHooks --> queryClient
    reviewHooks --> queryClient

    mediaHooks --> workbenchMedia
    stateMachine --> postAnalyze
    stateMachine --> getJobs
    stateMachine --> postCluster
    reviewHooks --> getClusters
    reviewHooks --> getSuggestions
    overlayHooks --> getConflicts
    overlayHooks --> getOutbox
    overlayHooks --> getSync

    postAnalyze --> analyze
    getJobs --> jobs
    postCluster --> cluster
    getClusters --> clusters
    getSuggestions --> suggestions
    getConflicts --> conflicts
    getOutbox --> conflicts
    getSync --> conflicts

    classDef ui fill:#ffffff,stroke:#000000,color:#000000,stroke-width:2px
    classDef hook fill:#f5f5f5,stroke:#000000,color:#000000,stroke-width:1px
    classDef cache fill:#e0e0e0,stroke:#000000,color:#000000,stroke-width:1px
    classDef api fill:#cccccc,stroke:#000000,color:#000000,stroke-width:1px
    classDef remote fill:#999999,stroke:#000000,color:#000000,stroke-width:1px

    class workbench,syncIndicator,scanTab,confirmTab,overlay ui
    class context,mediaHooks,stateMachine,overlayHooks,reviewHooks hook
    class queryClient cache
    class workbenchMedia,postAnalyze,getJobs,postCluster,getClusters,getSuggestions,getConflicts,getOutbox,getSync api
    class analyze,jobs,cluster,clusters,suggestions,conflicts remote
