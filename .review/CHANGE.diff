+
+function signedInPerson() {
+  clerkDouble.state.isLoaded = true;
+  clerkDouble.state.isSignedIn = true;
+  clerkDouble.state.userId = 'user_2';
+  clerkDouble.state.user = {
+    fullName: 'Grace Hopper',
+    primaryEmailAddress: {
