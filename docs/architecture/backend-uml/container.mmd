    end

    %% API wiring
    app_factory --> routers
    routers --> auth_deps
    routers --> scan_queue
    routers --> cluster_service
    routers --> suggestion_service
    routers --> job_service
    routers --> media_service

    %% Clustering pipeline
    cluster_service --> rep_discovery
    cluster_service --> centroid_discovery
    cluster_service --> graph_discovery
    graph_discovery --> hdbscan
    rep_discovery --> gate
    centroid_discovery --> gate
    graph_discovery --> gate
    gate --> checks
    gate --> writer
    cluster_service --> suggestion_service

    %% Worker pipeline
    scan_worker --> scan_queue
    scan_worker --> scan_service
    scan_service --> detector
    scan_service --> generator
    detector --> insightface
    generator --> insightface

    %% Persistence
    scan_queue --> repos
    cluster_service --> repos
    suggestion_service --> repos
    job_service --> repos
    media_service --> repos
    writer --> repos
    repos --> async_session --> postgres

    settings --> gate
    settings --> cluster_service
    settings --> writer

