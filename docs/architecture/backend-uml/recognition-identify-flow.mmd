sequenceDiagram
%% Recognition Service Backend Endpoints - v2
%% Aligns with CONSOLIDATED_FACE_DETECTION_PLAN.md Section 4

autonumber
participant WP as WordPress Plugin
participant Crop as ImageCropUtility
participant Embed as /api/v0/embeddings/batch
participant Suggest as /api/v0/suggest
participant Cluster as /api/v0/cluster-unknowns
participant FAISS as FAISS Index
participant DB as WP Database

%% Request from Frontend
Note over WP: POST /wp-json/cat/v1/recognition/identify<br/>{attachmentId, faces[{bbox}]}

WP->>WP: Validate capabilities
WP->>WP: Resolve attachment
WP->>Crop: cropFaces(attachmentId, bboxes[])
Crop->>Crop: Load image (WP_Image_Editor)

loop For each bounding box
    Crop->>Crop: Calculate crop coordinates
    Crop->>Crop: Crop region + resize to 112x112
end

Crop-->>WP: faceImages[] (base64 or temp files)

%% Embeddings Generation
WP->>Embed: POST /embeddings/batch<br/>{images: [base64...], model: "adaface"}
Embed->>Embed: Decode images
Embed->>Embed: Normalize + resize (if needed)
Embed->>Embed: Run face recognition model (AdaFace/InsightFace)
Embed->>Embed: Generate 512-dim embeddings
Embed-->>WP: {embeddings: [[0.123, ...], ...]}

%% Suggestions (FAISS Search)
WP->>Suggest: POST /suggest<br/>{embeddings[], topK: 5, threshold: 0.92}
Suggest->>FAISS: Load roster index
FAISS->>FAISS: Normalize query embeddings
FAISS->>FAISS: Search with IndexFlatIP/HNSW

loop For each embedding
    FAISS->>FAISS: Compute cosine similarity
    FAISS->>FAISS: Filter by threshold (0.92)
    FAISS->>FAISS: Sort by score descending
end

FAISS-->>Suggest: {matches: [[{rosterId, score}, ...], ...]}
Suggest->>Suggest: Map rosterIds to display names
Suggest-->>WP: {suggestions: [[{rosterId, display, score}], ...]}

%% Clustering (for low-confidence faces)
WP->>Cluster: POST /cluster-unknowns<br/>{embeddings[]}
Cluster->>Cluster: Calculate pairwise distances
Cluster->>Cluster: Run DBSCAN/Agglomerative (threshold: 0.6)
Cluster->>Cluster: Assign cluster IDs or -1 (noise)
Cluster-->>WP: {clusterIds: ["cluster-abc-001", "cluster-abc-001", "cluster-abc-002", ...]}

%% Combine Results
WP->>WP: Merge suggestions + clusters per face
WP->>WP: Generate faceIds (if not provided)

alt User provided labels
    WP->>DB: INSERT cat_observation (bbox, label_status: 'confirmed')
    WP->>DB: INSERT/UPDATE cat_roster_entity (if newName)
    DB-->>WP: observationId, rosterId
    
    WP->>Suggest: POST /roster/sync<br/>{personId, embedding}
    Suggest->>FAISS: Add embedding to index
    FAISS-->>Suggest: Index updated
end

WP-->>WP: Build response payload

%% Response to Frontend
Note over WP: Response: {faces: [{faceId, clusterId?, suggestions[], observationId?}]}
