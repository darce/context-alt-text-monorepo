# ============================================================================
# Context Alt Text - Environment Configuration
# ============================================================================
# Copy this file to create environment-specific configurations:
#   - .env.local        → Full local development (LocalWP + local recognition)
#   - .env.local-remote → Hybrid dev (LocalWP + remote recognition service)
#   - .env.staging      → Staging environment
#   - .env.production   → Production deployment
#
# Then symlink the one you want to use:
#   ln -sf .env.local .env
#
# Or set WP_ENVIRONMENT_TYPE in wp-config.php and the plugin will auto-select:
#   define('WP_ENVIRONMENT_TYPE', 'local');        // Uses .env.local
#   define('WP_ENVIRONMENT_TYPE', 'development');  // Uses .env.development  
#   define('WP_ENVIRONMENT_TYPE', 'staging');      // Uses .env.staging
#   define('WP_ENVIRONMENT_TYPE', 'production');   // Uses .env.production
# ============================================================================

# ----------------------------------------------------------------------------
# VITE DEVELOPMENT SERVER
# ----------------------------------------------------------------------------
# URL of the Vite dev server for hot module replacement (HMR)
# Only used when wp_get_environment_type() === 'development'
CAT_VITE_DEV_SERVER=http://localhost:5173

# ----------------------------------------------------------------------------
# RECOGNITION SERVICE
# ----------------------------------------------------------------------------
# Base URL of the recognition service API
# Examples:
#   - Local:  http://localhost:7860
#   - Remote: https://your-space.hf.space
#   - Prod:   https://recognition.yourdomain.com
CAT_RECOGNITION_BASE_URL=

# HTTP request timeout in milliseconds
CAT_RECOGNITION_TIMEOUT_MS=30000

# Optional: API key for authentication (if your service requires it)
CAT_RECOGNITION_API_KEY=

# Optional: Specific model profile to use
CAT_RECOGNITION_MODEL_PROFILE=

# ----------------------------------------------------------------------------
# FEATURE FLAGS (Optional Overrides)
# ----------------------------------------------------------------------------
# Leave commented to use smart defaults (auto-enable when service configured)
# Uncomment to explicitly enable/disable features

# Enable/disable workbench recognition features
# CAT_FEATURE_WORKBENCH_RECOGNITION=true

# Enable/disable roster UI
# CAT_FEATURE_ROSTER_UI_ENABLED=true

# Enable/disable bulk AI features (post-MVP)
# CAT_FEATURE_WORKBENCH_BULK_AI=false

# Enable/disable abilities system (post-MVP)
# CAT_ENABLE_ABILITIES=false

# Enable/disable MCP server adapter (post-MVP)
# CAT_ENABLE_MCP=false

# ----------------------------------------------------------------------------
# DEBUGGING
# ----------------------------------------------------------------------------
# Enable verbose logging (requires WP_DEBUG=true in wp-config.php)
# Logs are written to wp-content/uploads/cat-logs/debug-YYYY-MM-DD.log
# WP_DEBUG=true
