# Local development environment template for the prototype description service.
#
# Copy to `apps/prototype-description-service/.env` and adjust as needed:
#   cp apps/prototype-description-service/.env.example apps/prototype-description-service/.env
# Or run `make dev-setup` (copies only if .env is absent, then mints a DB API key).
#
# Annotation format (Slice 4): `# domain: <n> | source: <owner> | consumer: <who reads it>`
# Cross-ref: docs/secrets-inventory.md
#
# Consumed by:
#   - db.settings._load_env_file (Python runtime + Alembic + pytest)
#   - scripts/reset_dev_db.sh   (`make reset-local`)
#   - scripts/db_shell.sh       (`make db-shell`)
#
# Production deployments MUST NOT use this file - see `.env.prod.example`
# for the multi-environment OCI VM template.

# == Postgres connection ==
# Postgres connection (canonical names; consumed by db.settings + reset_dev_db.sh)
# domain: infra | source: description-service / DB ops | consumer: db/settings.py (get_database_settings, DSN render); scripts/reset_dev_db.sh; scripts/db_shell.sh
PGUSER=context
# domain: infra | source: description-service / DB ops | consumer: db/settings.py (get_database_settings, DSN render); scripts/reset_dev_db.sh; scripts/db_shell.sh
PGPASSWORD=context
# domain: infra | source: description-service / DB ops | consumer: db/settings.py DSN render
PGHOST=localhost
# domain: infra | source: description-service / DB ops | consumer: db/settings.py DSN render
PGPORT=5432
# domain: infra | source: description-service / DB ops | consumer: db/settings.py (_resolved_db_name, canonicalize)
DB_NAME=alt_context_service

# == Aliases ==
# Aliases used by reset_dev_db.sh + db_shell.sh as a fallback when PGUSER /
# PGPASSWORD are unset. Default to the canonical values via shell expansion
# so a single edit to PGUSER/PGPASSWORD keeps the local reset flow working.
# domain: infra | source: description-service / DB ops | consumer: scripts/reset_dev_db.sh; scripts/db_shell.sh (fallback when PGUSER unset)
APP_PGUSER="${PGUSER}"
# domain: infra | source: description-service / DB ops | consumer: scripts/reset_dev_db.sh; scripts/db_shell.sh (fallback when PGPASSWORD unset)
APP_PGPASSWORD="${PGPASSWORD}"

# == Database DSNs ==
