flowchart TD
    Start([Plugin Loaded]) --> Scan[MissingAltTextScanner handles initial scan]
    Scan --> Summary[DashboardMetricsService stores summary counts]
    Summary --> AdminBootstrap[Admin SPA enqueued on dashboard/workbench routes]
    AdminBootstrap --> Localize[ContextAltTextAdmin payload includes workbench.items]
    Localize --> WorkbenchUI[Workbench App mounts]
    WorkbenchUI --> dashboardUI[Dashboard route]
    WorkbenchUI --> workbench[Alt-Text Workbench route]
    WorkbenchUI --> rosterUI[Roster Manager route]
    WorkbenchUI --> automationUI[Automation Queue route]

    workbench --> selectMedia{Attachments selected?}
    selectMedia -- yes --> recognitionRequest[POST /wp-json/context-alt-text/v1/recognition/analyze]
    backendAnalyze(["/api/v0/analyze-scene"])
    recognitionRequest --> backendAnalyze
    backendAnalyze --> recognitionPipeline[SceneAnalysisService + FaceRecognitionService]
    recognitionPipeline --> rosterMatches[Matches + observations persisted]
    rosterMatches --> storeObs[RecognitionObservationRepository::persistObservations]
    storeObs --> workbenchRefresh[useWorkbenchMedia refetch]
    workbenchRefresh --> workbench

    rosterUI --> observationPanel[RosterObservationsPanel]
    observationPanel --> autoAssign[RosterObservationManager::autoAssignPending]
    autoAssign --> observationUpdates[RecognitionObservationRepository updates]
    observationPanel --> manualResolve{Operator assigns roster match?}
    manualResolve -- yes --> resolveRequest[POST /wp-json/context-alt-text/v1/roster/resolve]
    rosterDomain(["Domain\\Roster\\RosterService create/update"])
    recognitionServiceAPI(["/api/v0/roster/*"])
    resolveRequest --> rosterDomain
    rosterDomain --> recognitionServiceAPI
    reloadEmbeddings(["POST /api/v0/service/reload-embeddings"])
    recognitionServiceAPI --> reloadEmbeddings
    reloadEmbeddings --> embeddingRouter[Embedding cache refreshed]
    embeddingRouter --> backendAnalyze

    automationUI --> automationJobs["Background jobs (cron + queue)"]
    automationJobs --> recognitionServiceAPI
    automationJobs --> recognitionRequest

    dashboardUI --> dashboardHooks[React Query hooks /dashboard/*]
    dashboardHooks --> recognitionRequest

    note["Roster CRUD now runs through WP services + backend API; SPA exposes review + assignment with keyboard-first flows."]
    rosterUI -. accessibility overlays .- note
