+def compute_usage_request_fingerprint(
+    *,
+    route_mode: DescribeUsageRouteMode | str,
+    media_ids: Sequence[int],
+    image_digests: Mapping[int, str],
+    context_hash: str,
+    recognition_enabled: bool,
