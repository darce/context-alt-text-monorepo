---
title: InsightFace Recognition Service (Modular)
---
flowchart TB
    subgraph ports["Ports"]
        recognition_port["RecognitionServicePort\nrecognize_faces()\nget_service_info()"]
        model_port["RecognitionModelPort\nanalyze(image)\nmodel_info()"]
        embedding_port["EmbeddingRouterPort\nload_embeddings()\nfind_matches()\nreload_if_needed()"]; 
    end

    subgraph domain["Domain Layer"]
        recognition_service["FaceRecognitionService\n- orchestrates analyze + match\n- aggregates per-face matches\n- exposes diagnostics"]
        recognition_entities["Domain Entities\nFaceDetection / FaceEmbedding\nRecognitionResult / MatchResult"]
        recognition_settings["Settings (Pydantic)\ninsightface, recognition, router"]
    end

    subgraph adapters["Adapters"]
        insightface_adapter["InsightFaceAdapter\nimplements RecognitionModelPort\n- lazy load model\n- analyze → FaceEmbedding list"]
        embedding_router["EmbeddingRouterAdapter\nimplements EmbeddingRouterPort\n- JSON roster store\n- cosine similarity"]
    end

    subgraph external["External Dependencies"]
        insightface_weights["InsightFace weights / providers"]
        embeddings_file["Roster embeddings JSON"]
        settings_yaml["recognition_core/config/settings.yaml + env"]
    end

    recognition_port --> recognition_service
    recognition_service --> recognition_entities
    recognition_service --> recognition_settings
    recognition_service --> model_port
    recognition_service --> embedding_port

    model_port --> insightface_adapter
    embedding_port --> embedding_router

    insightface_adapter --> insightface_weights
    embedding_router --> embeddings_file
    recognition_settings --> settings_yaml

    classDef portsClass fill:#e3f2fd,stroke:#1565c0,color:#000,stroke-width:2px
    classDef domainClass fill:#e8f5e9,stroke:#2e7d32,color:#000,stroke-width:2px
    classDef adapterClass fill:#fff3e0,stroke:#ef6c00,color:#000,stroke-width:2px
    classDef externalClass fill:#fce4ec,stroke:#ad1457,color:#000,stroke-width:2px

    class ports,recognition_port,model_port,embedding_port portsClass
    class domain,recognition_service,recognition_entities,recognition_settings domainClass
    class adapters,insightface_adapter,embedding_router adapterClass
    class external,insightface_weights,embeddings_file,settings_yaml externalClass
