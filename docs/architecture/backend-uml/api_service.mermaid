title: Recognition API Surface (FastAPI)
---
flowchart TB
    subgraph fastapi_layer["FastAPI Layer"]
        fastapi_app["FastAPI App\n(lifespan managed)"]
        main_router["api/routes/main.py\n(/api/v0/*)"]
        media_router["api/routes/media.py\n(/api/v0/media/*)"]
        legacy_roster_router["api/routes/roster.py\n(/api/v0/roster)"]
        typed_roster_router["roster/ports/api_router.py\n(/api/v0/roster/*)"]
        suggest_router["api/routes/suggest.py\nPOST /api/v0/suggest"]
        cluster_router["api/routes/cluster_unknowns.py\nPOST /api/v0/cluster-unknowns"]
        health_route["GET /api/v0/health"]
        service_info_route["GET /api/v0/service/info"]
        readiness_routes["GET /ready\nGET /warmup-status"]
    end

    subgraph dependencies["Shared Dependencies"]
        roster_dependency["api.dependencies.get_roster_service()\n(singleton cache)"]
    end

    subgraph domain["Domain Services"]
        startup_manager["StartupManager"]
        scene_analysis_service["SceneAnalysisService"]
        recognition_service["FaceRecognitionService"]
        roster_service["RosterService"]
        clustering_service["ClusteringService"]
    end

    subgraph adapters["Adapters"]
        object_adapter["YOLOAdapter"]
        caption_adapter["Phi3CaptionAdapter"]
        recognition_adapter["InsightFaceAdapter"]
        embedding_adapter["EmbeddingRouterAdapter"]
        roster_storage["FileRosterStorageAdapter"]
        embedding_storage["EmbeddingStorageAdapter"]
        data_validation["DataValidationAdapter"]
    end

    subgraph external["External"]
        settings_yaml["shared/settings.yaml + env"]
        insightface_weights["InsightFace weights"]
        yolo_weights["YOLO weights"]
        phi3_weights["Phi-3 weights"]
        roster_files["Roster JSON + embeddings"]
        cache_dirs["HF/Torch cache dirs"]
    end

    fastapi_app --> main_router
    fastapi_app --> media_router
    fastapi_app --> legacy_roster_router
    fastapi_app --> typed_roster_router
    fastapi_app --> suggest_router
    fastapi_app --> cluster_router
    fastapi_app --> health_route
    fastapi_app --> service_info_route
    fastapi_app --> readiness_routes

    main_router --> scene_analysis_service
    main_router --> recognition_service
    media_router --> scene_analysis_service
    legacy_roster_router --> roster_dependency
    typed_roster_router --> roster_dependency
    suggest_router --> recognition_service
    suggest_router --> roster_dependency
    cluster_router --> clustering_service
    service_info_route --> recognition_service
    health_route --> recognition_service
    readiness_routes --> startup_manager

    roster_dependency --> roster_service

    scene_analysis_service --> recognition_service
    scene_analysis_service --> object_adapter
    scene_analysis_service --> caption_adapter
    recognition_service --> recognition_adapter
    recognition_service --> embedding_adapter
    recognition_service --> cache_dirs

    roster_service --> roster_storage
    roster_service --> embedding_storage
    roster_service --> data_validation

    startup_manager --> scene_analysis_service
    startup_manager --> recognition_service
    startup_manager --> roster_service
    startup_manager --> settings_yaml

    object_adapter --> yolo_weights
    caption_adapter --> phi3_weights
    recognition_adapter --> insightface_weights
    embedding_adapter --> roster_files
    roster_storage --> roster_files
    embedding_storage --> roster_files

    classDef fastapiClass fill:#e3f2fd,stroke:#1565c0,color:#000,stroke-width:2px
    classDef dependencyClass fill:#ede7f6,stroke:#5e35b1,color:#000,stroke-width:2px
    classDef domainClass fill:#e8f5e9,stroke:#2e7d32,color:#000,stroke-width:2px
    classDef adapterClass fill:#fff3e0,stroke:#ef6c00,color:#000,stroke-width:2px
    classDef externalClass fill:#fce4ec,stroke:#ad1457,color:#000,stroke-width:2px

    class fastapi_layer,fastapi_app,main_router,media_router,legacy_roster_router,typed_roster_router,suggest_router,cluster_router,health_route,service_info_route,readiness_routes fastapiClass
    class dependencies,roster_dependency dependencyClass
    class domain,startup_manager,scene_analysis_service,recognition_service,roster_service domainClass
    class adapters,object_adapter,caption_adapter,recognition_adapter,embedding_adapter,roster_storage,embedding_storage,data_validation adapterClass
    class external,settings_yaml,insightface_weights,yolo_weights,phi3_weights,roster_files,cache_dirs externalClass
