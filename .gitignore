# Wordpress - ignore core, configuration, examples, uploads and logs.
# https://github.com/github/gitignore/blob/main/WordPress.gitignore

# Core
#
# Note: if you want to stage/commit WP core files
# you can delete this whole section/until Configuration.
/wp-admin/
/wp-content/index.php
/wp-content/languages
/wp-content/plugins/index.php
/wp-content/themes/index.php
/wp-includes/
/index.php
/license.txt
/readme.html
/wp-*.php
/xmlrpc.php

# Configuration
wp-config.php

# Example themes
/wp-content/themes/twenty*/

# Example plugin
/wp-content/plugins/hello.php

# Uploads
/wp-content/uploads/

# Log files
# *.log

# archives
apps/archived-recognition-service/**
apps/archived-wp-context-alt-text/**

# htaccess
/.htaccess

# All plugins
#
# Note: If you wish to whitelist plugins,
# uncomment the next line
#/wp-content/plugins

# All themes
#
# Note: If you wish to whitelist themes,
# uncomment the next line
#/wp-content/themes

# Reference library — tracked since 2026-07-09 (remote is private; distilled
# corpus is load-bearing for the heuristics lexicons). Only the embedded
# gstack clone stays out (it is its own git repo).
literature/process/gstack/
literature/process/product-deploy-agents/
.DS_Store
# .vscode/settings.json
# .vscode/
# Env files: never commit populated secrets. No repo-root .env is used or
# tracked — description-service loads only <service-dir>/.env via
# db/settings.py:_load_env_file (ENV_FILE = Path(__file__).parents[1] / ".env").
# Backend env files: /opt/acx-backend/<env>/.env on the VM (demo: /opt/acx-backend/demo/secrets/.env).
# WP Playwright creds: apps/prototype-wp-alt-context/.env.local (example shipped).
.env
.env.*
*.envman-tmp-*
!.env*.example
!apps/prototype-wp-alt-context/.env.local.example
apps/prototype-wp-alt-context/.env.local
apps/prototype-wp-alt-context/tests/e2e/.auth/
apps/prototype-wp-alt-context/local/playwright/
# visual:localwp snapshot baselines are LocalWP/dev-specific (live media table) — regenerate per machine, not committed.
apps/prototype-wp-alt-context/tests/e2e/visual/*-snapshots/
node_modules/
package-lock.json
!apps/prototype-wp-alt-context/package-lock.json
public/assets/dist/
storybook-static/
vendor/
composer.lock
!apps/prototype-wp-alt-context/composer.lock
.phpunit.result.cache

# Vite build output
**/public/assets/dist/
/dist/
/build/

# Python virtual environments (should only exist in apps/recognition-service)
.venv/
venv/
__pycache__/
*.pyc
.hypothesis/

# pip install artifacts
.eggs/
*.egg-info/

# Logs (all service / tool logs)
logs/
apps/prototype-description-service/logs/

# Operational ephemera (local)
CURRENT_TASK.json
CURRENT_TASK.md
DASHBOARD.txt
DASHBOARD.md
.task-state/
.acx-dep-cache/
.acx-dep-source

# --- workbay-bootstrap-managed surfaces -------------------------------
# Regenerate via `workbay-bootstrap install` from the pinned remote_sha in
# .workbay-bootstrap.json (which IS tracked — it is the install ledger).
# SHARED entries are symlinks into .workbay/remote/; committing them would
# leave dangling symlinks on a fresh clone. GENERATED entries are deterministic
# generator outputs. .mcp.json / .vscode/mcp.json / .codex/config.toml are kept
# tracked here (not gitignored) as the consumer-owned MCP server config.
.workbay/
# Legacy workstate overlay clone — still load-bearing via the scripts/hooks,
# .github/hooks and Makefile.d symlinks until
# `workbay-bootstrap install` repoints them to .workbay/remote. Physical removal
# is deferred to that installer cutover; see the upstream request
# 2026-06-28-refactoring-lens-and-overlay-mechanism (now filed in
# agentic-protocol-monorepo/docs/upstream-requests/).
.workstate/
/scripts/hooks
# Local materialization: symlink into the gitignored /scripts/hooks overlay;
# tracking it would dangle on a fresh clone.
/.claude/hooks
# Lifecycle runner: pre-rename this lived under /scripts/workbay (covered
# below); workbay-system 0.3.8 hoisted it to the top-level path, so the fence
# needs its own entry. Bootstrap-materialized SHARED surface, regenerated by
# `workbay install`; committing it drifts on every update.
/scripts/workbay_lifecycle
/.github/hooks
/skills
/Makefile.d
/.github/prompts/
/.claude-plugin/
/.agents/

# local logs
/docs/agentic/oci-example/*.log

# local retry logs
/retry-apply.log

# Per-user Claude Code permissions allowlist (machine-specific paths)
.claude/settings.local.json

# Local linked Claude worktrees are ephemeral per-machine artifacts.
.claude/worktrees/

# Local branch/worktree inventory files are ephemeral operator notes.
local/*-worktrees.txt

# Cursor overlay surfaces (machine-local, ephemeral).
/.cursor/skills
/.cursor/commands
/.cursor/hooks.json
/.cursor/mcp.json
# >>> WORKBAY_BOOTSTRAP OVERLAY IGNORE >>>
/.workbay
/docs/workbay/contracts
/docs/workbay/rules
/scripts/workbay
/.grok/plugins/workbay-system
/.workbay-cache
/scripts/review_pipeline.py
/scripts/assert_gate_interpreter.sh
# <<< WORKBAY_BOOTSTRAP OVERLAY IGNORE <<<

# codemap MCP index artifact (local, regenerated)
.codebase-memory/

