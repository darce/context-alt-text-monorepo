---
title: Identity Domain Overview
---
classDiagram
    class Tenant {
        +id : UUID
        +site_url : str
        +created_at : datetime
        +updated_at : datetime
    }

    class MediaIdentity {
        +id : UUID
        +tenant_id : UUID
        +media_id : int
        +media_url : str
        +bbox_x : int
        +bbox_y : int
        +bbox_width : int
        +bbox_height : int
        +confidence : float
        +embedding : Vector~512~
        +thumbnail_url : str
        +created_at : datetime
        +created_by_user_id : int
    }

    class IdentityCluster {
        +id : UUID
        +tenant_id : UUID
        +label : str
        +representative_identity_id : UUID
        +identity_count : int
        +roster_id : UUID
        +similarity_threshold : float
        +clustering_algorithm : str
        +created_at : datetime
        +updated_at : datetime
    }

    class IdentityClusterRepresentative {
        +id : UUID
        +tenant_id : UUID
        +cluster_id : UUID
        +identity_id : UUID
        +embedding : Vector~512~
        +quality_score : float
        +diversity_score : float
        +created_at : datetime
    }

    class IdentityMember {
        +id : UUID
        +tenant_id : UUID
        +cluster_id : UUID
        +identity_id : UUID
        +similarity : float
        +assigned_at : datetime
        +created_by_user_id : int
    }

    class ClusterCentroid {
        <<Materialized View>>
        +cluster_id : UUID
        +tenant_id : UUID
        +member_count : int
        +centroid : Vector~512~
        +refreshed_at : datetime
    }

    class IdentityScanJob {
        +id : UUID
        +tenant_id : UUID
        +status : str
        +media_ids : List~int~
        +total_media : int
        +processed_media : int
        +identities_detected : int
        +error_message : str
        +created_at : datetime
        +started_at : datetime
        +completed_at : datetime
    }

    class IdentityClusteringJob {
        +id : UUID
        +tenant_id : UUID
        +status : str
        +progress : float
        +total_identities : int
        +processed_identities : int
        +error_message : str
        +created_at : datetime
        +started_at : datetime
        +completed_at : datetime
    }

    Tenant "1" -- "*" MediaIdentity : owns
    Tenant "1" -- "*" IdentityCluster : owns
    IdentityCluster "1" -- "*" IdentityMember : contains
    IdentityCluster "1" -- "*" IdentityClusterRepresentative : has
    IdentityCluster "1" -- "0..1" ClusterCentroid : summarized_by
    MediaIdentity "1" -- "0..1" IdentityMember : belongs_to
    MediaIdentity "1" -- "0..1" IdentityClusterRepresentative : represents
