# Browser-safe publishable key only. Never put CLERK_SECRET_KEY here.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional Frontend API origin used by the production CSP artifact.
# Production custom host: https://clerk.altcontext.com
VITE_CLERK_FAPI=https://clerk.altcontext.com

# Public build-time portal flag. false/0/off renders the designed unavailable screen.
VITE_PORTAL_ENABLED=true
