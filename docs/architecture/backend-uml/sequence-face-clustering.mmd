sequenceDiagram
    %% Face Clustering Workflow
    %% Implementation: subfeature/face-clustering-poc
    %% Shows: Detection → Embedding Storage → Clustering → UI Display → Labeling

    actor User
    participant UI as WorkbenchApp
    participant ScanBtn as FaceScanActions
    participant ScanAPI as ScanController<br/>(REST)
    participant Queue as SynchronousFaceDetectionQueue
    participant Job as FaceDetectionJob
    participant Pipeline as RecognitionServiceFaceDetectionPipeline
    participant RecogAPI as Recognition Service<br/>(FastAPI)
    participant Repo as UnknownFaceRepository
    participant Clustering as ClusteringService
    participant ClusterAPI as ClusterController<br/>(REST)
    participant ClusterUI as UnknownPeoplePanel
    participant DetailUI as ClusterDetailView
    participant Modal as ClusterConfirmationModal

    %% Phase 1: Face Detection & Embedding Storage
    User->>UI: Click "Scan for Faces"
    UI->>ScanBtn: Trigger scan
    ScanBtn->>ScanAPI: POST /recognition/scan<br/>{attachment_ids: [123, 456]}
    ScanAPI->>Queue: enqueueBatch([123, 456], 'normal')
    
    loop For each attachment
        Queue->>Job: execute(attachmentId)
        Job->>Pipeline: detectFaces(attachmentId)
        Pipeline->>RecogAPI: POST /analyze<br/>{imageUrl, threshold: 0.45}
        RecogAPI-->>Pipeline: {faces: [{bbox, embedding, embedding_id}]}
        Pipeline-->>Job: Detected faces with embeddings
        
        Job->>Job: Check IoU duplicates (threshold: 0.8)
        Job->>Repo: saveUnknownFace(attachmentId, bbox,<br/>embeddingId, embeddingVector)
        Repo-->>Job: Face persisted with ID
    end

    %% Phase 2: Automatic Clustering
    Queue->>Clustering: clusterUnknownFaces()
    Note over Clustering: Load all faces with embeddings
    Clustering->>Repo: findUnresolvedWithEmbeddings()
    Repo-->>Clustering: UnknownFace[] with 512-dim vectors

    Note over Clustering: Local clustering algorithm:<br/>1. Normalize vectors (L2)<br/>2. Compute cosine similarities<br/>3. Merge if similarity > 0.45<br/>4. Assign cluster IDs
    
    loop For each face pair
        Clustering->>Clustering: cosineSimilarity(vec1, vec2)
        alt Similarity > 0.45
            Clustering->>Clustering: Merge into same cluster
        end
    end

    loop Update cluster assignments
        Clustering->>Repo: updateClusterId(faceId, clusterId)
    end

    Clustering-->>Queue: {strategy: 'local', clusters: 11}
    Queue-->>ScanAPI: {job_id, queued_count: 2}
    ScanAPI-->>ScanBtn: Success response
    ScanBtn-->>UI: Show success toast

    %% Phase 3: Display Clusters
    User->>UI: View Unknown People panel
    UI->>ClusterUI: Render
    ClusterUI->>ClusterAPI: GET /clusters?per_page=20
    ClusterAPI->>Clustering: clusterUnknownFaces([])
    Clustering->>Repo: findUnresolvedWithEmbeddings()
    Repo-->>Clustering: Grouped faces
    Clustering-->>ClusterAPI: {clusters: [{id, face_ids, sample_face_id}]}
    ClusterAPI-->>ClusterUI: Cluster list

    loop For each cluster
        ClusterUI->>ClusterUI: Render ClusterCard<br/>with thumbnail & count
    end

    %% Phase 4: View Cluster Details
    User->>ClusterUI: Click cluster card
    ClusterUI->>DetailUI: Show detail view
    DetailUI->>ClusterAPI: GET /clusters/{clusterId}
    ClusterAPI->>Clustering: getClusterDetail(clusterId)
    Clustering->>Repo: findByClusterId(clusterId)
    Repo-->>Clustering: UnknownFace[] for cluster
    
    ClusterAPI->>Clustering: getClusterSuggestions(clusterId)
    Clustering->>RecogAPI: POST /suggest<br/>{embeddings: [centroid]}
    RecogAPI-->>Clustering: {matches: [{roster_id, display_name, confidence}]}
    
    Clustering-->>ClusterAPI: {cluster, faces, suggestions}
    ClusterAPI-->>DetailUI: Complete cluster data
    DetailUI-->>User: Display faces + suggestions

    %% Phase 5: Label Cluster
    User->>DetailUI: Click "Label these faces"
    DetailUI->>Modal: Open confirmation modal
    Modal-->>User: Show suggestions list

    User->>Modal: Select roster entry
    Modal->>ClusterAPI: POST /clusters/{clusterId}/confirm<br/>{roster_id, face_ids}
    ClusterAPI->>Clustering: confirmCluster(clusterId, rosterId, faceIds)
    
    loop For each face in cluster
        Clustering->>Repo: markAsResolved(faceId, rosterId)
    end

    Clustering->>RecogAPI: POST /roster/{id}/augment<br/>{embedding, observation_id, metadata}
    RecogAPI-->>Clustering: {status: 'queued', sync_id}
    
    Clustering-->>ClusterAPI: {resolved_count: 5, sync_status}
    ClusterAPI-->>Modal: Success response
    Modal-->>DetailUI: Close modal
    DetailUI-->>ClusterUI: Refresh cluster list
    ClusterUI-->>User: Show updated clusters (cluster removed)

    Note over User,Modal: Cluster disappears from Unknown People<br/>Faces now associated with roster entry<br/>Future suggestions improve with new data
