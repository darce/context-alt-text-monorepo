# Local development environment template for the prototype description service.
#
# Copy to `apps/prototype-description-service/.env` and adjust as needed:
#   cp apps/prototype-description-service/.env.example apps/prototype-description-service/.env
# Or run `make dev-setup` (copies only if .env is absent, then mints a DB API key).
#
# Annotation format (Slice 4): `# domain: <n> | source: <owner> | consumer: <who reads it>`
# Cross-ref: docs/secrets-inventory.md
#
# Consumed by:
#   - db.settings._load_env_file (Python runtime + Alembic + pytest)
#   - scripts/reset_dev_db.sh   (`make reset-local`)
#   - scripts/db_shell.sh       (`make db-shell`)
#
# Production deployments MUST NOT use this file - see `.env.prod.example`
# for the multi-environment OCI VM template.

# ---------------------------------------------------------------------------
# Postgres connection (canonical names; consumed by db.settings + reset_dev_db.sh)
# ---------------------------------------------------------------------------
# domain: infra | source: description-service / DB ops | consumer: db/settings.py (get_database_settings, DSN render); scripts/reset_dev_db.sh; scripts/db_shell.sh
PGUSER=context
# domain: infra | source: description-service / DB ops | consumer: db/settings.py (get_database_settings, DSN render); scripts/reset_dev_db.sh; scripts/db_shell.sh
PGPASSWORD=context
# domain: infra | source: description-service / DB ops | consumer: db/settings.py DSN render
PGHOST=localhost
# domain: infra | source: description-service / DB ops | consumer: db/settings.py DSN render
PGPORT=5432
# domain: infra | source: description-service / DB ops | consumer: db/settings.py (_resolved_db_name, canonicalize)
DB_NAME=alt_context_service

# ---------------------------------------------------------------------------
# Aliases used by reset_dev_db.sh + db_shell.sh as a fallback when PGUSER /
# PGPASSWORD are unset. Default to the canonical values via shell expansion
# so a single edit to PGUSER/PGPASSWORD keeps the local reset flow working.
# ---------------------------------------------------------------------------
# domain: infra | source: description-service / DB ops | consumer: scripts/reset_dev_db.sh; scripts/db_shell.sh (fallback when PGUSER unset)
APP_PGUSER=${PGUSER}
# domain: infra | source: description-service / DB ops | consumer: scripts/reset_dev_db.sh; scripts/db_shell.sh (fallback when PGPASSWORD unset)
APP_PGPASSWORD=${PGPASSWORD}

# ---------------------------------------------------------------------------
# Optional DSN overrides. Leave commented to let db.settings render defaults
# from PG* above.
# ---------------------------------------------------------------------------
# domain: infra | source: description-service / DB ops | consumer: db/settings.py:get_database_settings
# POSTGRES_DSN=postgresql+asyncpg://${PGUSER}:${PGPASSWORD}@${PGHOST}:${PGPORT}/${DB_NAME}
# domain: infra | source: description-service / DB ops | consumer: db/settings.py:get_database_settings
# POSTGRES_SYNC_DSN=postgresql+psycopg://${PGUSER}:${PGPASSWORD}@${PGHOST}:${PGPORT}/${DB_NAME}

# ---------------------------------------------------------------------------
# Pool + timeout knobs (defaults match db.settings.get_database_settings).
# ---------------------------------------------------------------------------
# domain: infra | source: description-service / DB ops | consumer: db/settings.py pool/timeout settings
# DB_STATEMENT_TIMEOUT=10s
# domain: infra | source: description-service / DB ops | consumer: db/settings.py pool/timeout settings
# DB_IDLE_IN_TXN_TIMEOUT=30s
# domain: infra | source: description-service / DB ops | consumer: db/settings.py pool/timeout settings
# DB_DISABLE_STMT_CACHE=0
# domain: infra | source: description-service / DB ops | consumer: db/settings.py pool/timeout settings
# DB_EMBEDDING_TIMEOUT_SECONDS=30
# domain: infra | source: description-service / DB ops | consumer: db/settings.py observability pool
# DB_OBSERVABILITY_POOL_SIZE=2
# domain: infra | source: description-service / DB ops | consumer: db/settings.py observability pool
# DB_OBSERVABILITY_MAX_OVERFLOW=0
# domain: infra | source: description-service / DB ops | consumer: db/settings.py observability pool
# DB_OBSERVABILITY_POOL_TIMEOUT=5
# domain: infra | source: description-service / DB ops | consumer: db/settings.py breaker settings
# DB_BREAKER_FAILURE_THRESHOLD=3
# domain: infra | source: description-service / DB ops | consumer: db/settings.py breaker settings
# DB_BREAKER_WINDOW_SECONDS=30
# domain: infra | source: description-service / DB ops | consumer: db/settings.py breaker settings
# DB_BREAKER_HALF_OPEN_AFTER_SECONDS=10

# ---------------------------------------------------------------------------
# Local recognition auth
# ---------------------------------------------------------------------------
# domain: service root-of-trust (mode flag) | source: service operator | consumer: SecuritySettings / runtime mode gates
RECOGNITION_RUNTIME_MODE=development
# domain: service root-of-trust (mode flag) | source: service operator | consumer: SecuritySettings.auth_enabled; HTTP auth deps
RECOGNITION_AUTH_ENABLED=1
# domain: service root-of-trust (config) | source: service operator | consumer: HTTP auth dependency (API key header name)
RECOGNITION_API_KEY_HEADER=X-API-Key
# Tenant API keys are DB-only (mint via `make dev-mint-key` or /admin).
# The former env-var allowlist bypass is retired (decision #1882); do not re-add.

# ---------------------------------------------------------------------------
# Operator /admin surface (optional local; generate token if enabling)
# ---------------------------------------------------------------------------
# domain: service root-of-trust (flag) | source: service operator | consumer: SecuritySettings.admin_enabled; /admin router mount
# RECOGNITION_ADMIN_ENABLED=false
# domain: service root-of-trust | source: service operator | consumer: SecuritySettings.admin_token; validate_admin_config; /admin deps
# RECOGNITION_ADMIN_TOKEN=
# domain: service root-of-trust (config) | source: service operator | consumer: admin auth dependency (default X-Admin-Token)
# RECOGNITION_ADMIN_TOKEN_HEADER=X-Admin-Token
