# Multi-environment deployment template for OCI VM.
#
# Each environment (prod/staging/dev) needs its own copy at:
#   /opt/acx-backend/<env>/secrets/.env
# Then symlink: ln -s /opt/acx-backend/<env>/secrets/.env /opt/acx-backend/<env>/.env
#
# Annotation format (Slice 4): `# domain: <n> | source: <owner> | consumer: <who reads it>`
# Cross-ref: apps/prototype-description-service/docs/secrets-inventory.md
#
# Do NOT commit secrets.

# ---------------------------------------------------------------------------
# Compose project identity (required by docker-compose.env.yml)
# ---------------------------------------------------------------------------
# These vars must differ per environment.
# domain: infra | source: OCI deploy | consumer: docker-compose.env.yml project identity
COMPOSE_PROJECT_NAME=acx-prod
# domain: infra | source: OCI deploy | consumer: compose / deploy scripts (environment label)
ACX_ENV=prod
# domain: infra | source: OCI deploy | consumer: compose image tag selection
ACX_IMAGE_TAG=latest
# domain: infra | source: OCI deploy | consumer: compose volume mount for Postgres data
ACX_PGDATA_PATH=/opt/acx-backend/data/prod-pgdata
# domain: infra | source: OCI deploy | consumer: compose volume mount for model cache
ACX_MODELS_PATH=/opt/acx-backend/data/prod-models
# domain: infra | source: OCI deploy | consumer: compose network name
ACX_NETWORK_NAME=acx-prod-net

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------
# domain: service root-of-trust (mode flag) | source: service operator | consumer: SecuritySettings / runtime mode gates; validate_required_secrets
RECOGNITION_RUNTIME_MODE=production
# domain: infra | source: OCI deploy | consumer: application logging config
LOG_LEVEL=INFO
# domain: infra | source: OCI deploy | consumer: runtime default tenant context (deploy bootstrap)
TENANT_ID=00000000-0000-7000-8000-000000000000

# ---------------------------------------------------------------------------
# Secret backend (Phase 3 — OCI Vault; decision #1882)
# ---------------------------------------------------------------------------
# env (default): the app reads the secret values in this file directly.
# oci_vault: api/worker fetch POSTGRES_DSN / POSTGRES_SYNC_DSN / PGPASSWORD /
#   RECOGNITION_ADMIN_TOKEN from OCI Vault via the VM's instance principal.
#   Those values MUST stay blank here — no app secret ships as host plaintext.
#   Runbook: infra/oci/vault-instance-principal-runbook.md.
# domain: infra (backend selector) | source: service operator | consumer: shared/secrets.py:get_secret_provider
RECOGNITION_SECRET_BACKEND=oci_vault
# Non-secret JSON map. KEY = the logical secret name the app requests
# (get_secret("PGPASSWORD"), ...) — the SAME name used everywhere in code, NOT
# the Vault-side secret path. VALUE = that secret's Vault OCID (an identifier,
# not a secret). Required when RECOGNITION_SECRET_BACKEND=oci_vault. Single
# compartment, trust-domain namespacing on the Vault side (decision #1882; see
# the runbook's path table).
#   Boot-REQUIRED keys (eagerly fetched, fail-fast if missing — must be present):
#     PGPASSWORD, RECOGNITION_ADMIN_TOKEN.
#   OPTIONAL keys (add only if you want them Vault-managed / the provider is on):
#     POSTGRES_DSN, POSTGRES_SYNC_DSN (else the DSN is rendered from PGPASSWORD),
#     ACX_GPU_ENDPOINT_API_KEY, ACX_HOSTED_PROVIDER_API_KEY, ACX_EVAL_API_KEY
#     (else they stay env-only; only needed when those providers are enabled).
# domain: infra (OCID map) | source: OCI deploy | consumer: shared/secrets.py:OciVaultSecretProvider.from_env
RECOGNITION_VAULT_SECRET_MAP={"PGPASSWORD":"ocid1.vaultsecret.oc1..REPLACE","RECOGNITION_ADMIN_TOKEN":"ocid1.vaultsecret.oc1..REPLACE","POSTGRES_DSN":"ocid1.vaultsecret.oc1..REPLACE","POSTGRES_SYNC_DSN":"ocid1.vaultsecret.oc1..REPLACE","ACX_GPU_ENDPOINT_API_KEY":"ocid1.vaultsecret.oc1..REPLACE_GPU_ENDPOINT_KEY"}

# ---------------------------------------------------------------------------
# Postgres (used by compose for container bootstrap)
# ---------------------------------------------------------------------------
# NOTE: the postgres CONTAINER reads POSTGRES_PASSWORD directly (it is not a
# Python-app secret and cannot use the Vault provider). Under oci_vault the
# systemd ExecStartPre hook fetches it into the runtime .env before compose up
# (see acx-env.service.template + the runbook) — never commit a real value.
# This is the accepted two-fetch-mechanism trade-off (ADR-013, [ARCH-06]).
# domain: infra | source: OCI Vault (ExecStartPre) / OCI deploy | consumer: docker-compose Postgres bootstrap
POSTGRES_USER=acx_app
# domain: infra | source: OCI Vault (ExecStartPre) under oci_vault | consumer: docker-compose Postgres bootstrap
POSTGRES_PASSWORD=
# domain: infra | source: OCI deploy | consumer: docker-compose Postgres bootstrap (POSTGRES_DB)
POSTGRES_DB=alt_context_service

# Disk headroom protection for concurrent centroid-MV refreshes and Postgres health.
# WHY: the 2026-09-02 prod outage exhausted the filesystem during REFRESH MATERIALIZED VIEW CONCURRENTLY.
# The compose template supplies the probe mount path to api/worker; leave this
# unset outside compose to preserve local/test parity.
# domain: infra | source: service operator / docker-compose.env.yml | consumer: shared/disk_headroom.py
# ACX_PG_HEADROOM_PROBE_PATH=/run/acx-pg-headroom
# domain: infra | source: service operator | consumer: shared/disk_headroom.py minimum free bytes
# ACX_PG_HEADROOM_MIN_BYTES=2147483648
# domain: infra | source: service operator | consumer: docker-compose.env.yml Postgres healthcheck
# ACX_PG_DISK_MAX_USED_PCT=90

# ---------------------------------------------------------------------------
# Application database DSNs
# ---------------------------------------------------------------------------
# Under RECOGNITION_SECRET_BACKEND=oci_vault these are fetched from Vault (keys
# above) — leave BLANK. Set them ONLY for the env backend (local/staging without
# Vault). Do not commit real passwords.
# domain: infra | source: OCI Vault (oci_vault) / env | consumer: db/settings.py:get_database_settings
POSTGRES_DSN=
# domain: infra | source: OCI Vault (oci_vault) / env | consumer: db/settings.py:get_database_settings
POSTGRES_SYNC_DSN=

# ---------------------------------------------------------------------------
# Cache directories (container-internal, mapped via volumes)
# ---------------------------------------------------------------------------
# domain: infra | source: OCI deploy | consumer: runtime cache path resolution
CACHE_BASE=/data/cache
# domain: infra | source: OCI deploy | consumer: HuggingFace hub cache
HF_HOME=/data/cache/huggingface_cache
# domain: infra | source: OCI deploy | consumer: HuggingFace hub cache
HF_HUB_CACHE=/data/cache/huggingface_cache
# domain: infra | source: OCI deploy | consumer: InsightFace model cache
INSIGHTFACE_CACHE_DIR=/data/cache/insightface
# domain: infra | source: OCI deploy | consumer: InsightFace home path
INSIGHTFACE_HOME=/data/cache/insightface

# ---------------------------------------------------------------------------
# Database pool tuning (sensible defaults; adjust for production load)
# ---------------------------------------------------------------------------
# domain: infra | source: description-service / DB ops | consumer: db/settings.py pool/vector settings
# PGVECTOR_DIM=512
# domain: infra | source: description-service / DB ops | consumer: db/settings.py pool settings
# DB_POOL_SIZE=20
# domain: infra | source: description-service / DB ops | consumer: db/settings.py pool settings
# DB_MAX_OVERFLOW=10
# domain: infra | source: description-service / DB ops | consumer: db/settings.py pool settings
# DB_POOL_TIMEOUT=30
# domain: infra | source: description-service / DB ops | consumer: db/settings.py pool settings
# DB_POOL_RECYCLE=3600

# ---------------------------------------------------------------------------
# Worker behavior
# ---------------------------------------------------------------------------
# domain: infra | source: service operator | consumer: recognition async analyze worker path
# RECOGNITION_ASYNC_ANALYZE_INLINE=0

# ---------------------------------------------------------------------------
# API security (recognition HTTP surface)
# ---------------------------------------------------------------------------
# domain: service root-of-trust (mode flag) | source: service operator | consumer: SecuritySettings.auth_enabled; HTTP auth deps
RECOGNITION_AUTH_ENABLED=true
# Tenant API keys are DB-only via /admin (or scripts/manage_api_keys.py).
# There is no env-var allowlist bypass (retired, decision #1882).
# domain: service root-of-trust (config) | source: service operator | consumer: HTTP auth dependency (API key header name)
RECOGNITION_API_KEY_HEADER=X-API-Key

# ---------------------------------------------------------------------------
# Operator /admin surface (E15-31) — tailnet-gated tenant + API-key console
# ---------------------------------------------------------------------------
# The /admin router mounts ONLY when RECOGNITION_ADMIN_ENABLED=true. Leave it
# false everywhere except the prod VM, where the operator reaches /admin over
# the tailnet (see docs/runbooks/admin-tenant-keys.md). The public
# api.altcontext.com vhost denies /admin* (404, Caddyfile); the admin token is
# still required on top. Startup fails closed (validate_admin_config) when
# enabled with an empty/<32-char token, or in production without the
# RECOGNITION_ADMIN_TAILNET_BOUND ack below.
# domain: service root-of-trust (flag) | source: service operator | consumer: SecuritySettings.admin_enabled; /admin router mount
RECOGNITION_ADMIN_ENABLED=false
# Shared operator admin token. Generate a strong value (>=32 chars):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Under RECOGNITION_SECRET_BACKEND=oci_vault this is fetched from Vault (map key
# RECOGNITION_ADMIN_TOKEN) — leave BLANK. Set here only for the env backend.
# domain: service root-of-trust | source: OCI Vault (oci_vault) / service operator | consumer: SecuritySettings.admin_token; validate_admin_config; /admin deps (admin_auth)
RECOGNITION_ADMIN_TOKEN=
# Required production acknowledgement that /admin is reachable only over the
# tailnet and denied on the public vhost. Must be 1 when admin is enabled in
# production, or startup refuses.
# domain: service root-of-trust (ack) | source: service operator | consumer: validate_admin_config (must be 1 in production when admin on)
RECOGNITION_ADMIN_TAILNET_BOUND=1
# domain: service root-of-trust (config) | source: service operator | consumer: API key hashing (SecuritySettings)
# RECOGNITION_API_KEY_HASH_ALGORITHM=sha256
# domain: service root-of-trust (config) | source: service operator | consumer: rate-limit middleware (SecuritySettings)
# RECOGNITION_RATE_LIMIT_RPM=60
# domain: service root-of-trust (config) | source: service operator | consumer: rate-limit middleware (SecuritySettings)
# RECOGNITION_RATE_LIMIT_BURST=10
# domain: service root-of-trust (config) | source: service operator | consumer: pagination bounds (SecuritySettings)
# RECOGNITION_MAX_PAGE_SIZE=500
# RECOGNITION_ALLOWED_ORIGINS is a comma-separated allowlist of browser origins
# permitted to make cross-origin requests. Default empty = no browser CORS
# (deny-all). Wildcard '*' is rejected at startup. List explicit origins only,
# e.g. "https://admin.example.com,https://demo.example.com".
# domain: service root-of-trust (config) | source: service operator | consumer: CORS middleware (SecuritySettings)
# RECOGNITION_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Image description (E19-1) — the ACX_DESCRIPTION_ADAPTER profile switch
# ---------------------------------------------------------------------------
# One operator switch selects the description backend. Values:
#   seeded         deterministic fixture captions; forbidden for demo publish.
#   florence_small Florence-2-base-ft, ~14s/image on the OCI A1 CPU (under budget).
#                  Requires the [vlm] extra (build the runtime-vlm image; see
#                  docs/tasks/19.0/E19-1-florence-large-async-worker-impl-notes.md).
#   florence_large Florence-2-large-ft, ~39s/image — STUB until the async worker
#                  exists; selecting it returns 503.
#   gpu_phi4       Phi-4-multimodal-instruct — GPU-only STUB; returns 503 on CPU.
# Default seeded keeps the recognition-only image torch-free outside the demo.
#
# --- GPU burst profile (demo) ---
# Allowed live demo values: florence_small | gpu_qwen30b | gpu_qwen30b_ensemble
# From the repository root, validate both live files together before every deploy:
#   scripts/deploy/preflight-gpu-env.sh --check-reaper /path/to/prod.env /path/to/demo.env
# domain: infra | source: service operator | consumer: scene description adapter selection
ACX_DESCRIPTION_ADAPTER=gpu_qwen30b
# Private A10 endpoint; http(s) is required for gpu_* adapters.
# domain: infra | source: service operator | consumer: remote GPU description adapter
ACX_GPU_ENDPOINT_URL=http://acx-gpu-burst.compute.oraclevcn.com:8000
# Optional comma-separated hostname policy. Defaults shown here match the service.
ACX_GPU_ENDPOINT_ALLOWLIST=acx-gpu-burst,*.oraclevcn.com
# Finite request budgets and concurrency consumed by scene/config/settings.py.
ACX_GPU_CONNECT_TIMEOUT_SECONDS=5
ACX_GPU_READ_TIMEOUT_SECONDS=175
ACX_GPU_MAX_CONCURRENT_CALLS=4
# Startup may include instance boot, model load, and readiness probing; max 3600.
ACX_GPU_WARMUP_TIMEOUT_SECONDS=510
# Bump when the remote GPU prompt/task contract changes.
ACX_GPU_PROMPT_VERSION=3
# oci_vault: leave this blank and replace the ACX_GPU_ENDPOINT_API_KEY OCID in
# RECOGNITION_VAULT_SECRET_MAP. env: put the direct value here. Never commit it.
# domain: service secret | source: OCI Vault / service operator | consumer: remote GPU description adapter
ACX_GPU_ENDPOINT_API_KEY=
# Recognition URL, tenant key, and tenant ID belong only in the demo's
# WORDPRESS_CONFIG_EXTRA. Do not copy plugin credentials into this env_file.
#
# Host runtime caps for the local-CPU Florence path (defaults shown; model id/
# revision/decode-params live in scene/config/profiles.py, not env):
# domain: infra | source: service operator | consumer: VLM host runtime caps
# ACX_VLM_MAX_IMAGE_EDGE_PX=1024
# domain: infra | source: service operator | consumer: VLM host runtime caps
# ACX_VLM_TIMEOUT_SECONDS=20
# domain: infra | source: service operator | consumer: VLM host runtime caps
# ACX_VLM_MAX_RSS_MB=6144
# domain: infra | source: service operator | consumer: VLM host runtime caps
# ACX_VLM_WORKER_CONCURRENCY=1
# domain: infra | source: service operator | consumer: description request timeout
# ACX_DESCRIPTION_TIMEOUT_SECONDS=180

# ---------------------------------------------------------------------------
# GPU lifecycle snapshots (split host and API ownership)
# ---------------------------------------------------------------------------
# ACX_ENV=prod selects the API's namespaced writable load directory below.
# Host lifecycle units publish gpu-state.json under /run/acx; the API compose
# service mounts that host-owned directory read-only at the identical path.
# domain: infra | source: OCI deploy | consumer: docker-compose.prod.yml snapshot mount
ACX_GPU_SNAPSHOT_DIR=/run/acx
# domain: infra | source: OCI deploy | consumer: lifecycle producer and scene GPU-state reader
ACX_GPU_STATE_PATH=/run/acx/gpu-state.json
# State older than this is unknown to the API and fails the deployment check.
# domain: infra | source: service operator | consumer: scene GPU-state reader / snapshot check
ACX_GPU_STATE_STALE_SECONDS=180
# The API publishes DB-derived load in its own writable environment directory;
# lifecycle units aggregate /run/acx-write/*/describe-load.json without granting
# the container write access to host-owned GPU state.
# domain: infra | source: OCI deploy | consumer: docker-compose.prod.yml load mount
ACX_DESCRIBE_LOAD_DIR=/run/acx-write/prod
# domain: infra | source: OCI deploy | consumer: scene load writer / lifecycle units
ACX_DESCRIBE_LOAD_PATH=/run/acx-write/prod/describe-load.json
# Keep two refresh opportunities inside the lifecycle reader's 120s stale guard.
# domain: infra | source: service operator | consumer: scene load snapshot refresher
ACX_DESCRIBE_LOAD_REFRESH_SECONDS=45
