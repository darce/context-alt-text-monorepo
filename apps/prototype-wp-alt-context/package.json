{
  "name": "prototype-wp-alt-context",
  "version": "0.0.18",
  "description": "WordPress plugin configuration",
  "packageManager": "npm@11.14.1",
  "scripts": {
    "test": "vitest run",
    "test:agent": "sh -c 'vitest run \"$@\" || true' --",
    "test:watch": "vitest",
    "e2e:install": "bash scripts/playwright-cli.sh install chromium",
    "e2e:list": "bash scripts/playwright-cli.sh test --list",
    "e2e:auth": "bash scripts/playwright-cli.sh test --project=auth-setup --headed",
    "e2e:localwp": "bash scripts/playwright-cli.sh test --project=smoke",
    "e2e:evidence": "bash scripts/playwright-cli.sh test --project=evidence",
    "e2e:runtime": "bash scripts/playwright-cli.sh test --project=evidence evidence/scan-runtime-evidence.spec.ts",
    "e2e:guided-record": "bash scripts/playwright-cli.sh test --project=guided-recording tests/e2e/evidence/guided-walkthrough.spec.ts",
    "e2e:public-guide": "bash scripts/playwright-cli.sh test --project=public-guide",
    "a11y:localwp": "bash scripts/playwright-cli.sh test --project=a11y",
    "visual:localwp": "bash scripts/playwright-cli.sh test --project=visual",
    "test:php": "composer test",
    "test:all": "npm run test && npm run test:php",
    "dev": "vite",
    "build": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "release:package": "bash scripts/release/package-plugin.sh",
    "preview": "vite preview",
    "lint": "python3 ../../scripts/lint_ratchet.py --tool eslint",
    "lint:raw": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "arch": "node scripts/check-architecture-compliance.js",
    "arch:tips": "node scripts/check-architecture-compliance.js --tips",
    "arch:verbose": "node scripts/check-architecture-compliance.js --tips --verbose",
    "check": "npm run lint && npm run typecheck && npm run arch && npm run test -- --run",
    "check:all": "npm run lint && npm run typecheck && npm run arch:verbose && npm run test",
    "typecheck": "tsc --noEmit --project tsconfig.type-check.json",
    "generate:contracts": "json2ts -i ../../packages/shared-contracts/schemas/ -o js/admin/api/generated",
    "nuke": "rm -rf node_modules public && npm ci && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@tanstack/eslint-plugin-query": "^5.90.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-react": "^5.1.0",
    "ajv": "^6.15.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-import-x": "^4.6.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^22.1.0",
    "json-schema-to-typescript": "^14.0.6",
    "msw": "^2.7.0",
    "prettier": "^3.6.2",
    "prettier-plugin-curly": "^0.4.1",
    "sass": "^1.80.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "vitest-axe": "^0.1.0"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@tanstack/react-query": "^5.90.7",
    "@wordpress/element": "^6.34.0",
    "@wordpress/i18n": "^6.7.0",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.554.0",
    "react-router-dom": "^7.9.5"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "^11.14.1"
  }
}
