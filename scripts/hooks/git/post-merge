#!/bin/sh
# Git post-merge hook: warn if protected paths are dirty on main (BR-16/BR-22).
#
# Installed via `make install-git-hooks`. Fires after a successful merge/pull.
#
# Args: $1=is_squash (1 if squash merge, else 0)

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
    exit 0
fi

python3 "$REPO_ROOT/scripts/hooks/check_main_clean.py" --trigger post-merge || true
exit 0
