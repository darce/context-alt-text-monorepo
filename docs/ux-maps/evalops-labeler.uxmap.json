      "job_entry": false,
      "deep_link": false,
      "url_params": [],
      "primary_action_id": "export",
      "states": [
        "default",
        "loading",
        "empty",
        "error",
        "offline",
        "first_time",
        "edge_input",
        "degraded"
      ],
      "zones": [
        {
          "id": "summary",
          "label": "Completed and unanswered items",
          "role": "status",
          "states": [
            "default",
