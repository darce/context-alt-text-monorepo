{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://context-alt-text.dev/schemas/recognition-observation.schema.json",
  "title": "Recognition Observation",
  "description": "A single detected face or entity in an image with matching information",
  "type": "object",
  "required": [
    "observationId",
    "label",
    "entityType",
    "confidence",
    "boundingBox",
    "status"
  ],
  "properties": {
    "observationId": {
      "type": "string",
      "description": "Unique identifier for this observation"
    },
    "label": {
      "type": "string",
      "description": "Label for the detected entity (person name, brand name, etc.)"
    },
    "entityType": {
      "type": "string",
      "enum": ["person", "organization", "brand", "face", "object", "other"],
      "description": "Type of detected entity"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Overall confidence score (0-1)"
    },
    "detectionConfidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence that entity was detected (0-1)"
    },
    "matchConfidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence in the roster match (0-1)"
    },
    "area": {
      "type": "number",
      "minimum": 0,
      "description": "Bounding box area in pixels"
    },
    "boundingBox": {
      "type": "array",
      "description": "Bounding box coordinates [x, y, width, height]",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "status": {
      "type": "string",
      "enum": ["matched", "needs_review", "unknown"],
      "description": "Match status"
    },
    "source": {
      "type": ["object", "null"],
      "description": "Source metadata from recognition service"
    },
    "match": {
      "type": "object",
      "description": "Matching information",
      "required": ["isMatch", "similarity", "confidence", "threshold"],
      "properties": {
        "isMatch": {
          "type": "boolean",
          "description": "Whether this observation matched a roster entry"
        },
        "similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Similarity score to matched entry (0-1)"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence in the match (0-1)"
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Threshold used for matching (0-1)"
        }
      }
    },
    "roster": {
      "type": ["object", "null"],
      "description": "Matched roster entry (if any)",
      "properties": {
        "remoteId": {
          "type": ["string", "null"],
          "description": "Roster entry remote ID"
        },
        "name": {
          "type": ["string", "null"],
          "description": "Roster entry name"
        },
        "displayName": {
          "type": ["string", "null"],
          "description": "Roster entry display name"
        }
      }
    },
    "candidates": {
      "type": "array",
      "description": "Alternative match candidates",
      "items": {
        "$ref": "#/definitions/observationCandidate"
      }
    }
  },
  "definitions": {
    "observationCandidate": {
      "type": "object",
      "required": ["similarity", "meetsThreshold"],
      "properties": {
        "remoteId": {
          "type": ["string", "null"],
          "description": "Roster entry remote ID"
        },
        "name": {
          "type": ["string", "null"],
          "description": "Roster entry name"
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "Match confidence (0-1)"
        },
        "similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Similarity score (0-1)"
        },
        "meetsThreshold": {
          "type": "boolean",
          "description": "Whether similarity meets matching threshold"
        }
      }
    }
  }
}
