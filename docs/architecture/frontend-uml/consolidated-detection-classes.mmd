classDiagram
%% Consolidated Face Recognition Data Structures (Oct 2025)
%% Frontend consumes backend-owned clustering + suggestions only

class ClusterSummary {
  +id: string
  +faceCount: number
  +sampleFace: ClusterSampleFace | null
  +suggestion: ClusterSummarySuggestion | null
  +createdAt: string | null
  +updatedAt: string | null
}

class ClusterSampleFace {
  +attachmentId: number
  +thumbnailUrl: string | null
  +bbox: ClusterBoundingBox | null
}

class ClusterSummarySuggestion {
  +rosterId: string
  +displayName: string
  +confidence: number | null
  +reason: string | null
}

class ClusterFaceDetail {
  +id: string
  +attachmentId: number
  +bbox: ClusterBoundingBox
  +thumbnailUrl: string | null
  +clusterId: string | null
  +detectedAt: string | null
  +resolvedAt: string | null
  +rosterId: string | null
  +embeddingId: string | null
}

class ClusterBoundingBox {
  +x: number
  +y: number
  +width: number
  +height: number
  +imageWidth: number | null
  +imageHeight: number | null
}

class ClusterSuggestion {
  +clusterId: string
  +rosterId: string
  +displayName: string
  +confidence: number
  +confidenceLevel: "high" | "medium" | "low" | undefined
  +matchCount: number
  +faceIds: string[]
  +reason: string | null
}

class FaceScanResult {
  +jobId: string
  +queuedCount: number
  +priority: "normal" | "high"
}

class FaceScanError {
  +message: string
  +code: string | undefined
  +status: number | undefined
}

class UseUnknownClusters {
  <<hook>>
  +clusters: ClusterSummary[]
  +total: number
  +page: number
  +perPage: number
  +isLoading: boolean
  +error: Error | null
  +refetch(): Promise<unknown>
}

class UseClusterDetail {
  <<hook>>
  +cluster: ClusterSummary
  +faces: ClusterFaceDetail[]
  +isLoading: boolean
  +error: Error | null
  +refetch(): Promise<unknown>
}

class UseClusterSuggestions {
  <<hook>>
  +suggestions: ClusterSuggestion[]
  +isLoading: boolean
  +error: Error | null
  +refetch(): Promise<unknown>
}

class UseFaceScan {
  <<hook>>
  +scanFaces(ids: number[], options?): Promise<void>
  +isScanning: boolean
  +error: FaceScanError | null
  +result: FaceScanResult | null
  +reset(): void
}

class UsePeopleSuggestions {
  <<hook>>
  +faces: DetectedFaceFE[]
  +isLoading: boolean
  +error: Error | null
  +identifyFaces(attachmentId: number, faces: DetectedFaceRequest[]): Promise<void>
  +submitLabel(faceId: string, label: Label): Promise<void>
  +bulkConfirm(rosterId: string, faceIds: string[]): Promise<void>
  +reset(): void
}

class DetectedFaceFE {
  +faceId: string
  +bbox: BoundingBox
  +attachmentId: number
  +clusterId: string | null
  +suggestions: Suggestion[]
  +labelDraft: Label | null
  +confirmedRosterId: string | null
  +observationId: string | null
  +confidence: number
}

class DetectedFaceRequest {
  +bbox: BoundingBox
  +faceId?: string
  +label?: Label
  +observationId?: string
}

class BoundingBox {
  +x: number
  +y: number
  +width: number
  +height: number
}

class Suggestion {
  +rosterId: string
  +displayName: string
  +score: number
}

class Label {
  +rosterId?: string
  +newName?: string
  +displayName?: string
}

ClusterSummary --> ClusterSampleFace
ClusterSummary --> ClusterSummarySuggestion
ClusterFaceDetail --> ClusterBoundingBox
UseUnknownClusters ..> ClusterSummary
UseClusterDetail ..> ClusterSummary
UseClusterDetail ..> ClusterFaceDetail
UseClusterSuggestions ..> ClusterSuggestion
UseFaceScan ..> FaceScanResult
UseFaceScan ..> FaceScanError
UsePeopleSuggestions ..> DetectedFaceFE
UsePeopleSuggestions ..> DetectedFaceRequest
UsePeopleSuggestions ..> Label
