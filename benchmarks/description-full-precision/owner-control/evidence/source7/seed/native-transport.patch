+ def write_all(fd,data):
+  remaining=memoryview(data)
+  while remaining:
+   try: n=os.write(fd,remaining)
+   except InterruptedError: continue
+   check(n>0,'native result short write'); remaining=remaining[n:]
+ r,w=os.pipe2(os.O_CLOEXEC); gate_r=gate_w=None
+ try:
+  if before: gate_r,gate_w=os.pipe2(os.O_CLOEXEC)
+  deadline=time.monotonic()+seconds; pid=os.fork()
+ except BaseException:
+  for fd in (r,w,gate_r,gate_w):
+   if fd is not None: os.close(fd)
+  raise
