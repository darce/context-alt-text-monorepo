classDiagram
    %% Face Clustering Frontend Components (November 2025)
    %% Workbench implementation with IdentityClusterList

    class IdentityClusterList {
        <<component>>
        +render() JSX.Element
        +identities: DetectedIdentity[]
        +mediaId: number
        -clusters: ClusterGroup[]
    }

    class IdentityClusterItem {
        <<component>>
        +render() JSX.Element
        +cluster: ClusterGroup
        -isEditing: boolean
        -labelInput: string
        -error: string|null
        -lastMerge: MergeClusterResponse|null
        +handleMerge(targetLabel: string)
        +handleSplit()
        +handleUpdateLabel()
    }

    class Combobox {
        <<component>>
        +render() JSX.Element
        +value: string
        +onChange(value: string)
        +options: ComboboxOption[]
        +onSearch(term: string)
        +renderOption?(option: ComboboxOption) JSX.Element
        +isLoading: boolean
    }

    class recognitionApi {
        <<module>>
        +fetchClusterLabels()
        +fetchIdentitySuggestions(identityId: string, topK: number)
        +mergeCluster(clusterId: string, targetLabel: string)
        +revertMergeCluster(clusterId: string, targetId: string)
        +updateClusterLabel(clusterId: string, label: string)
        +reassignClusterIdentity(identityId: string, targetClusterId: string)
        +splitCluster(clusterId: string)
    }

    class ClusterGroup {
        <<type>>
        +key: string
        +clusterId: string|null
        +label: string|null
        +isAutoLabel: boolean
        +members: DetectedIdentity[]
    }

    class DetectedIdentity {
        <<type>>
        +id: string
        +media_id: number
        +cluster_id: string|null
        +cluster_label: string|null
        +is_auto_label: boolean
        +bbox: BBox
        +confidence: number
        +similarity: number|null
        +thumbnail_url: string|null
    }

    class ClusterSuggestion {
        <<type>>
        +cluster_id: string
        +label: string
        +similarity: number
        +identity_count: number
    }

    class ComboboxOption {
        <<type>>
        +value: string
        +label: string
        +group: string
        +similarity: number
        +identityCount: number
    }

    IdentityClusterList --> IdentityClusterItem : renders
    IdentityClusterItem --> Combobox : renders
    IdentityClusterItem --> recognitionApi : calls
    
    IdentityClusterList ..> ClusterGroup : uses
    ClusterGroup --> DetectedIdentity : contains
    IdentityClusterItem ..> ClusterSuggestion : uses via Combobox
    Combobox ..> ComboboxOption : uses

