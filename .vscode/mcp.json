{
  "servers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@2.1.4"
      ],
      "type": "stdio"
    },
    "mcp-agent-handoff": {
      "command": "uvx",
      "args": [
        "mcp-agent-handoff==0.11.2",
        "--workspace-root",
        "${workspaceFolder}",
        "--state-dir",
        "${workspaceFolder}/.task-state",
        "--exports-dir",
        "${workspaceFolder}/.task-state/exports",
        "serve-stdio"
      ],
      "env": {
        "PATH": "${env:HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:${env:PATH}",
        "AGENT_HANDOFF_ENFORCE_BRANCH": "1"
      },
      "type": "stdio"
    },
    "mcp-agent-orchestrator": {
      "command": "uvx",
      "args": [
        "mcp-agent-orchestrator==0.4.6",
        "--workspace-root",
        "${workspaceFolder}",
        "--state-dir",
        "${workspaceFolder}/.task-state",
        "--exports-dir",
        "${workspaceFolder}/.task-state/exports",
        "serve-stdio"
      ],
      "env": {
        "PATH": "${env:HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:${env:PATH}",
        "AGENT_HANDOFF_ENFORCE_BRANCH": "1"
      },
      "type": "stdio"
    }
  }
}
