title: Context Alt Text Recognition Backend (Current)
---
flowchart TB
    %% Clients
    subgraph clients["Client Integrations"]
        admin_spa["WP Admin SPA\n(React Router)"]
        wp_php_client["WP Plugin PHP\nRecognitionClient"]
        wp_cli["WP-CLI Commands\ncat-recognition"]
        automation_jobs["Automation Jobs\n(cron + queues)"]
        agents_flagged["MCP Agents\n(feature-flagged)"]
    end

    %% API Layer
    subgraph api["FastAPI Surface"]
        fastapi_app["FastAPI app\n(lifespan startup)"]
        analyze_scene_route["POST /api/v0/analyze-scene"]
        embeddings_route["POST /api/v0/embeddings"]
        caption_route["POST /api/v0/caption"]
        identify_route["POST /api/v0/identify"]
        identify_hf_route["POST /api/v0/identify-hf"]
        media_routes["/api/v0/media/*\n(upload + captions)"]
        suggest_route["POST /api/v0/suggest"]
        cluster_route["POST /api/v0/cluster-unknowns"]
        roster_routes_legacy["/api/v0/roster\n(legacy upsert)"]
        roster_routes_typed["/api/v0/roster/*\n(typed API router)"]
        service_info_route["GET /api/v0/service/info"]
        health_route["GET /api/v0/health"]
        readiness_route["GET /ready\nGET /warmup-status"]
    end

    %% Domain Services
    subgraph domain["Domain Layer"]
        startup_manager["StartupManager\n(metrics + device setup)"]
        scene_service["SceneAnalysisService"]
        scene_composer["SceneComposer\n(detector + caption)"]
        recognition_service["FaceRecognitionService\n(InsightFace pipeline)"]
        roster_service["RosterService\n(cache + embedding sync)"]
    end

    %% Adapters & Infra
    subgraph adapters["Adapters & Infrastructure"]
        yolo_adapter["YOLOAdapter"]
        caption_adapter["Phi3CaptionAdapter"]
        insightface_adapter["InsightFaceAdapter"]
        embedding_adapter["EmbeddingRouterAdapter"]
        roster_storage["FileRosterStorageAdapter"]
        embedding_storage["EmbeddingStorageAdapter"]
        data_validation_adapter["DataValidationAdapter"]
        gpu_manager["GPUManager"]
    end

    %% External Systems
    subgraph external["External Dependencies"]
        settings_yaml["shared/settings.yaml\n+ env overrides"]
        insightface_weights["InsightFace weights"]
        yolo_weights["YOLO weights"]
        phi3_weights["Phi-3 weights"]
        roster_files["Roster JSON +\nembeddings cache"]
        cache_dirs["HF/Torch cache dirs"]
        hardware["GPU/CPU runtime"]
        blob_storage["Media storage\n(local or remote)"]
    end

    clients --> fastapi_app
    fastapi_app --> analyze_scene_route
    fastapi_app --> embeddings_route
    fastapi_app --> caption_route
    fastapi_app --> identify_route
    fastapi_app --> identify_hf_route
    fastapi_app --> media_routes
    fastapi_app --> suggest_route
    fastapi_app --> cluster_route
    fastapi_app --> roster_routes_legacy
    fastapi_app --> roster_routes_typed
    fastapi_app --> service_info_route
    fastapi_app --> health_route
    fastapi_app --> readiness_route

    analyze_scene_route --> scene_service
    embeddings_route --> scene_service
    caption_route --> scene_service
    identify_route --> scene_service
    identify_hf_route --> recognition_service
    media_routes --> scene_service
    suggest_route --> recognition_service
    cluster_route --> scene_service
    roster_routes_legacy --> roster_service
    roster_routes_typed --> roster_service
    service_info_route --> recognition_service
    health_route --> recognition_service
    readiness_route --> startup_manager

    scene_service --> scene_composer
    scene_service --> recognition_service
    scene_composer --> yolo_adapter
    scene_composer --> caption_adapter
    recognition_service --> insightface_adapter
    recognition_service --> embedding_adapter

    roster_service --> roster_storage
    roster_service --> embedding_storage
    roster_service --> data_validation_adapter

    startup_manager --> gpu_manager
    startup_manager --> scene_composer
    startup_manager --> recognition_service
    startup_manager --> roster_service

    gpu_manager --> hardware
    gpu_manager --> cache_dirs

    yolo_adapter --> yolo_weights
    caption_adapter --> phi3_weights
    insightface_adapter --> insightface_weights
    embedding_adapter --> roster_files
    roster_storage --> roster_files
    embedding_storage --> roster_files
    media_routes --> blob_storage

    fastapi_app --> settings_yaml
    startup_manager --> settings_yaml
    recognition_service --> cache_dirs

    classDef clientsClass fill:#e8eaf6,stroke:#3949ab,color:#000,stroke-width:2px
    classDef apiClass fill:#e3f2fd,stroke:#1565c0,color:#000,stroke-width:2px
    classDef domainClass fill:#e8f5e9,stroke:#2e7d32,color:#000,stroke-width:2px
    classDef adapterClass fill:#fff3e0,stroke:#ef6c00,color:#000,stroke-width:2px
    classDef externalClass fill:#fce4ec,stroke:#ad1457,color:#000,stroke-width:2px

    class clients,admin_spa,wp_php_client,wp_cli,automation_jobs,agents_flagged clientsClass
    class api,fastapi_app,analyze_scene_route,embeddings_route,identify_hf_route,media_routes,roster_routes,service_info_route,reload_embeddings_route,health_route,readiness_route apiClass
    class domain,scene_service,scene_composer,recognition_service,roster_service,startup_manager domainClass
    class adapters,yolo_adapter,caption_adapter,insightface_adapter,embedding_adapter,adaface_pipeline,roster_storage,embedding_storage,gpu_manager,adapter_factory adapterClass
    class external,settings_yaml,insightface_weights,yolo_weights,phi3_weights,roster_files,cache_dirs,hardware,blob_storage externalClass
