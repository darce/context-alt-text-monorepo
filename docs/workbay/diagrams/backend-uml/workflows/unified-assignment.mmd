sequenceDiagram
    autonumber
    
    %% =======================================================================
    %% UNIFIED ASSIGNMENT FLOW
    %% Shows how all discovery methods route through AssignmentGate
    %% =======================================================================
    
    participant Client as HTTP Client
    participant API as FastAPI Router
    participant CS as ClusterService
    participant RD as RepresentativeDiscovery
    participant CD as CentroidDiscovery
    participant GD as GraphDiscovery
    participant Gate as AssignmentGate
    participant BC as BlockCheck
    participant CON as ConstraintCheck
    participant CC as ConfidenceCheck
    participant Writer as AssignmentWriter
    participant Sugg as SuggestionService
    participant DB as Database

    Note over Client,DB: Legend: ENTRY = external entrypoint, Dashed arrow = optional wiring
    Note over Client,DB: Mini-map: ENTRY: POST /recognition/clustering/jobs -> ClusterService.cluster_unclustered_identities, Code: recognition/interface_adapters/http/routers/clusters_admission.py | recognition/application/orchestration/cluster_service.py | recognition/infrastructure/repositories/cluster_repository.py
    
    %% Phase 1: Initiate Clustering
    Client->>API: ENTRY: POST /recognition/clustering/jobs

    API->>CS: cluster_unclustered_identities(tenant_id)
    
    CS->>DB: get_unclustered(tenant_id)
    DB-->>CS: identities[]
    CS->>DB: get_by_tenant(tenant_id)
    DB-->>CS: clusters (reps + centroids)
    CS->>CS: prepare_cluster_caches()
    
    Note over CS: Phase 2: Discovery (find candidates, NO assignments)
    
    %% Representative Discovery
    rect rgb(180, 220, 180)
        Note over RD: Path 1: Representative Matching
        CS->>RD: discover(identities, representatives)
        loop For each identity
            RD->>RD: face_vec = extract_face_embedding(vector)
            RD->>RD: find_best_rep_match(face_vec, reps)
            alt similarity >= threshold
                RD->>RD: create AssignmentCandidate(REPRESENTATIVE)
            end
        end
        RD-->>CS: rep_candidates[]
    end
    
    CS->>CS: remaining = identities - matched
    
    %% Centroid Discovery
    rect rgb(180, 180, 220)
        Note over CD: Path 2: Centroid Matching
        CS->>CD: discover(remaining, centroids)
        loop For each identity
            CD->>CD: face_vec = extract_face_embedding(vector)
            CD->>CD: find_best_centroid_match(face_vec, centroids)
            alt similarity >= threshold
                CD->>CD: create AssignmentCandidate(CENTROID)
            end
        end
        CD-->>CS: centroid_candidates[]
    end
    
    CS->>CS: remaining = remaining - matched
    
    %% Graph Discovery (HDBSCAN)
    rect rgb(220, 180, 180)
        Note over GD: Path 3: Graph Clustering
        CS->>GD: discover(remaining, anchors)
        GD->>GD: run_hdbscan(embeddings)
        GD->>GD: match_clusters_to_anchors()
        loop For each cluster-anchor match
            GD->>GD: create AssignmentCandidate(GRAPH)
        end
        GD-->>CS: graph_candidates[]
    end
    
    %% Phase 3: ALL candidates go through the gate
    Note over CS,Gate: Phase 3: Unified Evaluation (ALL paths merge here)
    
    CS->>CS: all_candidates = rep + centroid + graph
    
    loop For each candidate in all_candidates
        rect rgb(255, 230, 180)
            Note over Gate: THE ONLY PATH TO ASSIGNMENT
            CS->>Gate: evaluate(candidate)
            
            %% Block check (fatal reject)
            Gate->>BC: evaluate(candidate)
            alt blocked
                BC-->>Gate: CheckResult(failed, fatal reject)
                Gate-->>CS: AssignmentDecision(REJECT)
            else not blocked
                BC-->>Gate: CheckResult(passed)
                %% Constraint check (fatal reject on CANNOT_LINK)
                Gate->>CON: evaluate(candidate)
                alt cannot link
                    CON-->>Gate: CheckResult(failed, fatal reject)
                    Gate-->>CS: AssignmentDecision(REJECT)
                else ok
                    CON-->>Gate: CheckResult(passed)

                    %% Confidence check (adaptive thresholds + quality)
                    Note over CC: settings: ClusteringSettings.similarity_threshold, suggestion_floor, suggestion_ceiling, fatal_confidence_floor, fatal_quality_floor, early_stage_suggestion_enabled, anchor_linked candidates bypass thresholds
                    Gate->>CC: evaluate(candidate)
                    alt similarity >= threshold
                        CC-->>Gate: CheckResult(passed)
                        Gate-->>CS: AssignmentDecision(ACCEPT)
                    else within suggestion band
                        CC-->>Gate: CheckResult(failed, suggest)
                        Gate-->>CS: AssignmentDecision(SUGGEST)
                    else below floor / fatal quality
                        CC-->>Gate: CheckResult(failed, reject)
                        Gate-->>CS: AssignmentDecision(REJECT)
                    end
                end
            end
        end

        
        %% Route based on decision
        alt decision.outcome == ACCEPT
            CS->>Writer: assign(candidate)
            Writer->>DB: update identity.cluster_id
            Writer->>DB: insert representative (if criteria met)
            Writer-->>CS: assigned
        else decision.outcome == SUGGEST
            CS->>Sugg: create(candidate, confidence)
            Sugg->>DB: insert suggestion
            Sugg-->>CS: suggestion_id
        else decision.outcome == REJECT
            CS->>CS: add to unclustered_pool
        end
    end
    
    %% Phase 4: Create new clusters for truly unclustered
    Note over CS: Phase 4: New Cluster Creation
    
    CS->>GD: discover(unclustered_pool, anchors={})
    GD->>GD: run_hdbscan(no anchors)
    GD-->>CS: new_cluster_proposals[]
    
    loop For each proposal
        CS->>Writer: create_cluster(members)
        Writer->>DB: insert cluster, members, representative
        Writer-->>CS: new_cluster
    end
    
    CS-->>API: ClusteringResult
    API-->>Client: {status: "complete", stats: {...}}
