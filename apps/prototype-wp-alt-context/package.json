{
  "name": "prototype-wp-alt-context",
  "version": "0.0.1",
  "description": "WordPress plugin configuration",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite",
    "build": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,php,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,php,json,css,scss,md}\"",
    "check:architecture": "node scripts/check-architecture-compliance.js",
    "check:all": "npm run lint && npm run check:architecture && npm run test",
    "nuke": "rm -rf node_modules public && npm install && npm run build"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "@eslint/js": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "vitest-axe": "^0.1.0",
    "@vitejs/plugin-react": "^5.1.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.7",
    "@wordpress/element": "^6.34.0",
    "@wordpress/i18n": "^6.7.0",
    "react-router-dom": "^7.9.5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
