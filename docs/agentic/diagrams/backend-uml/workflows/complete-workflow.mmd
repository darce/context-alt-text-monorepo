sequenceDiagram
    autonumber
    
    %% =======================================================================
    %% COMPLETE WORKFLOW (high-level)
    %% See recognize_faces.mmd + unified-assignment.mmd for details
    %% =======================================================================
    
    actor Admin
    participant UI as Workbench UI
    participant WP as WordPress REST Proxy
    participant API as Recognition Service API
    participant Worker as Scan Worker
    participant Cluster as ClusterService
    participant Sugg as SuggestionService
    participant DB as Database

    Note over Admin,DB: Legend: ENTRY = external entrypoint, Dashed arrow = optional wiring
    Note over Admin,DB: Mini-map: ENTRY: /recognition/analyze -> ScanQueueService -> SqlAlchemyScanQueueRepository, ENTRY: /recognition/clustering/jobs -> ClusterService -> SqlAlchemyClusterRepository, Code: recognition/interface_adapters/http/routers/analyze.py | recognition/interface_adapters/http/routers/clusters.py
    
    %% ===== PHASE 1: SCAN MEDIA FOR IDENTITIES =====
    Note over Admin,DB: Phase 1: Scan Media for Identities
    
    Admin->>UI: Select media rows
    UI->>WP: ENTRY: POST /recognition/analyze {media_items}
    WP->>API: ENTRY: POST /recognition/analyze

    API->>DB: INSERT identity_scan_jobs + queue items
    API-->>WP: {job_id}
    WP-->>UI: {job_id}

    Worker->>DB: claim scan queue items
    Worker->>DB: INSERT media_identities
    Worker->>DB: UPDATE identity_scan_jobs (progress/status)

    UI->>WP: ENTRY: GET /recognition/jobs/{job_id}
    WP->>API: ENTRY: GET /recognition/jobs/{job_id}
    API->>DB: SELECT identity_scan_jobs
    API-->>UI: {status, progress}
    
    UI->>UI: Show "Scan complete"
    
    %% ===== PHASE 2: CLUSTER IDENTITIES =====
    Note over Admin,DB: Phase 2: Cluster Identities
    
    Admin->>UI: Click "Cluster identities"
    UI->>WP: ENTRY: POST /recognition/clustering/jobs
    WP->>API: ENTRY: POST /recognition/clustering/jobs
    
    API->>Cluster: cluster_unclustered_identities(tenant_id)
    Cluster->>DB: SELECT unclustered identities
    Cluster->>DB: INSERT clusters, members, representatives
    Cluster->>Sugg: create suggestions (for labeled clusters)
    Cluster-->>API: {status, stats}
    API-->>UI: {status=complete, stats}
    
    %% ===== PHASE 3: REVIEW CLUSTERS =====
    Note over Admin,DB: Phase 3: Review Clusters & Suggestions
    
    UI->>WP: ENTRY: GET /recognition/clusters
    WP->>API: ENTRY: GET /recognition/clusters
    API->>DB: SELECT clusters with member counts
    DB-->>API: clusters[]
    API-->>WP: ClusterSummary[]
    WP-->>UI: clusters
    UI->>UI: Render IdentityClusterList
    
    Admin->>UI: Click cluster row
    UI->>WP: ENTRY: GET /recognition/identities/{id}/suggestions
    WP->>API: ENTRY: GET /recognition/identities/{id}/suggestions
    API->>Sugg: list_for_identity(identity_id)
    Sugg->>DB: SELECT suggestions WHERE identity_id
    DB-->>Sugg: suggestions[]
    Sugg-->>API: suggestions
    API-->>WP: SuggestionMatch[]
    WP-->>UI: suggestions
    UI->>UI: Render SuggestionReviewPanel
    
    %% ===== PHASE 4: ACCEPT/REJECT SUGGESTIONS =====
    Note over Admin,DB: Phase 4: Human-in-the-Loop Decisions
    
    alt Accept suggestion
        Admin->>UI: Click "Accept"
        UI->>WP: ENTRY: POST /recognition/suggestions/{id}/accept
        WP->>API: ENTRY: POST /recognition/suggestions/{id}/accept
        API->>Sugg: accept(suggestion_id)
        Sugg->>DB: UPDATE identity_members + suggestions
        Sugg-->>API: success
        API-->>WP: success
        WP-->>UI: success
        UI->>UI: Remove from pending, refresh cluster
    else Reject suggestion
        Admin->>UI: Click "Reject"
        UI->>WP: ENTRY: POST /recognition/suggestions/{id}/reject
        WP->>API: ENTRY: POST /recognition/suggestions/{id}/reject
        API->>Sugg: reject(suggestion_id)
        Sugg->>DB: UPDATE suggestion SET status=rejected
        Sugg-->>API: success
        API-->>WP: success
        WP-->>UI: success
        UI->>UI: Remove from pending
    end
    
    %% ===== PHASE 5: LABEL CLUSTER =====
    Note over Admin,DB: Phase 5: Label Cluster
    
    Admin->>UI: Enter name "John Smith"
    UI->>WP: ENTRY: PATCH /recognition/clusters/{id} {label: "John Smith"}
    WP->>API: ENTRY: PATCH /recognition/clusters/{id}
    API->>DB: UPDATE identity_clusters SET label/user_confirmed
    DB-->>API: success
    API-->>WP: success
    WP-->>UI: success
    UI->>UI: Update cluster display
    
    Note over Admin: Workflow Complete
