%% Workbench Flow - Current Implementation (October 2025)
%% Reflects refactored hooks, extracted utilities, and actual data flow

flowchart TD
    subgraph WorkbenchUI["Workbench UI Layer"]
        route[WorkbenchRoute]
        app[WorkbenchApp]
        mediaList[MediaList]
        toolbar[SelectionToolbar]
        recognitionPanel[RecognitionActions]
        notices[Notice System]
    end

    subgraph Hooks["Custom Hooks"]
        useWorkbench[useWorkbenchMedia<br/>224 lines, paginated data]
        useRecognition[useRecognitionJob<br/>333 lines, submit + poll]
        useSubmit[useRecognitionSubmit<br/>extracted submission logic]
        usePoll[useRecognitionPoll<br/>extracted polling logic]
        useActions[useWorkbenchActions<br/>bulk operations]
    end

    subgraph Utilities["Shared Utilities"]
        httpUtils[HTTP Utils<br/>buildApiUrl, fetchApi]
        normalize[Normalization<br/>primitives, recognition]
        validation[Validation Constants<br/>timeout, URL patterns]
        noticeUtil[dispatchNotice<br/>consolidated system]
    end

    subgraph ReactQuery["React Query Layer"]
        queryClient[(QueryClient)]
        queries[Media Queries]
        mutations[Recognition Mutations]
    end

    subgraph RESTAPI["WordPress REST API"]
        mediaEndpoint["GET /workbench/media<br/>?page=1&per_page=20&status=all"]
        recognitionEndpoint["POST /recognition/analyze<br/>{ attachment_ids: [...] }"]
        observationEndpoint["GET /observations<br/>?attachment_id=123"]
        updateObservation["PATCH /observations/:id"]
    end

    subgraph Backend["Recognition Service (Remote)"]
        analyzeScene["POST /api/v0/analyze-scene<br/>Face detection + embedding"]
        rosterMatch["GET /api/v0/roster<br/>Match embeddings to roster"]
        storeResults["Store observations in WP"]
    end

    subgraph PHP["WordPress Backend"]
        workbenchResolver[WorkbenchMediaResolver<br/>337 lines, refactored]
        recognitionService[RecognitionService<br/>handles API calls]
        observationManager[RosterObservationManager<br/>stores observations]
        sanitization[SanitizationHelpers<br/>aligned with TS]
    end

    %% UI Flow
    route --> app
    app --> mediaList
    app --> toolbar
    app --> recognitionPanel
    app --> notices

    %% Hook Integration
    app --> useWorkbench
    app --> useActions
    recognitionPanel --> useRecognition
    useRecognition --> useSubmit
    useRecognition --> usePoll

    %% React Query Integration
    useWorkbench --> queries
    useSubmit --> mutations
    usePoll --> queries
    queries --> queryClient
    mutations --> queryClient

    %% Utility Usage
    useWorkbench --> httpUtils
    useSubmit --> httpUtils
    usePoll --> httpUtils
    httpUtils --> normalize
    httpUtils --> validation
    app --> noticeUtil

    %% API Calls
    queries --> mediaEndpoint
    mutations --> recognitionEndpoint
    queries --> observationEndpoint

    %% Backend Processing
    mediaEndpoint --> workbenchResolver
    recognitionEndpoint --> recognitionService
    recognitionService --> analyzeScene
    analyzeScene --> rosterMatch
    rosterMatch --> storeResults
    storeResults --> observationManager
    observationManager --> observationEndpoint

    %% Contract Alignment
    workbenchResolver --> sanitization
    normalize -.contract.-> sanitization

    %% User Actions
    user([Admin User]) --> route
    mediaList --> user
    toolbar --> user
    recognitionPanel --> user
    notices --> user

    %% Notes
    note1["✅ Hooks refactored: 333 lines with extracted logic"]
    note2["✅ Utilities aligned: TS ↔ PHP contracts documented"]
    note3["✅ 716 tests passing: frontend + PHP"]
    note4["📍 MVP Focus: Recognition workflow completion"]

    useRecognition -.- note1
    httpUtils -.- note2
    queryClient -.- note3
    Backend -.- note4

    %% Styling
    classDef complete fill:#d4edda,stroke:#28a745,stroke-width:2px
    classDef refactored fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    classDef remote fill:#cfe2ff,stroke:#0d6efd,stroke-width:2px

    class mediaList,toolbar,recognitionPanel complete
    class useWorkbench,useRecognition,useActions refactored
    class analyzeScene,rosterMatch remote
