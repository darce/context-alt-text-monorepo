{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://context-alt-text.dev/schemas/roster-entry.schema.json",
  "title": "Roster Entry",
  "description": "A roster entry used in the admin UI.",
  "type": "object",
  "required": [
    "id",
    "person_uuid",
    "name",
    "tags",
    "cluster_count",
    "clusters",
    "queue_memberships",
    "updated_at",
    "source_version",
    "projection_status",
    "projection_refreshed_at"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1,
      "description": "Roster entry ID."
    },
    "person_uuid": {
      "type": "string",
      "minLength": 1,
      "description": "Stable UUID for the local person write model behind this derived roster projection."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name for the entry."
    },
    "tags": {
      "type": "array",
      "description": "Tags associated with the entry.",
      "items": {
        "type": "string"
      }
    },
    "cluster_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of clusters assigned to this entry."
    },
    "clusters": {
      "type": "array",
      "description": "Projected clusters and identity instances for this person review surface.",
      "items": {
        "type": "object",
        "required": [
          "cluster_id",
          "identity_count",
          "representative_identity",
          "instances"
        ],
        "properties": {
          "cluster_id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable cluster UUID."
          },
          "identity_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of identities currently assigned to this cluster."
          },
          "representative_media_id": {
            "type": ["integer", "null"],
            "minimum": 1,
            "description": "Projected WP attachment ID of the cluster representative. Read from the projection column; never derived from representative_identity.media_id (rg-015). Null when the snapshot omitted it."
          },
          "undoable_merge_receipt_id": {
            "type": ["string", "null"],
            "format": "uuid",
            "description": "Projected newest unreverted, unexpired cluster-merge receipt id. Read from the projection column; never computed in PHP (rg-015). Null when none is undoable."
          },
          "representative_identity": {
            "type": ["object", "null"],
            "description": "Representative face evidence for the cluster when available.",
            "required": [
              "identity_id",
              "media_id",
              "media_url",
              "bbox",
              "similarity"
            ],
            "properties": {
              "identity_id": {
                "type": "string",
                "minLength": 1
              },
              "media_id": {
                "type": "integer",
                "minimum": 0
              },
              "media_url": {
                "type": ["string", "null"]
              },
              "bbox": {
                "type": ["object", "null"],
                "description": "Pixel-space face bounding box.",
                "required": ["x", "y", "width", "height"],
                "properties": {
                  "x": { "type": "integer", "minimum": 0 },
                  "y": { "type": "integer", "minimum": 0 },
                  "width": { "type": "integer", "minimum": 0 },
                  "height": { "type": "integer", "minimum": 0 }
                }
              },
              "similarity": {
                "type": ["number", "null"]
              },
              "similarity_threshold": {
                "type": ["number", "null"],
                "description": "Threshold used for this projected evidence item when available."
              },
              "representative_quality": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1,
                "description": "Projected composite quality in [0,1]. Read from the projection column; never recomputed in PHP (rg-015). Null when the snapshot omitted it."
              },
              "quality_components": {
                "type": ["object", "null"],
                "description": "Projected parts of representative_quality (UXR-15). Null when omitted. When present, all four keys are required; a missing signal is null, never omitted.",
                "additionalProperties": false,
                "required": ["confidence", "bbox_area", "sharpness", "occlusion_severity"],
                "properties": {
                  "confidence": {
                    "type": ["number", "null"],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "bbox_area": {
                    "type": ["number", "null"],
                    "minimum": 0
                  },
                  "sharpness": {
                    "type": ["number", "null"],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "occlusion_severity": {
                    "type": ["number", "null"],
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          },
          "instances": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "identity_id",
                "media_id",
                "media_url",
                "bbox",
                "similarity"
              ],
              "properties": {
                "identity_id": {
                  "type": "string",
                  "minLength": 1
                },
                "media_id": {
                  "type": "integer",
                  "minimum": 0
                },
                "media_url": {
                  "type": ["string", "null"]
                },
                "bbox": {
                  "type": ["object", "null"],
                  "description": "Pixel-space face bounding box.",
                  "required": ["x", "y", "width", "height"],
                  "properties": {
                    "x": { "type": "integer", "minimum": 0 },
                    "y": { "type": "integer", "minimum": 0 },
                    "width": { "type": "integer", "minimum": 0 },
                    "height": { "type": "integer", "minimum": 0 }
                  }
                },
                "similarity": {
                  "type": ["number", "null"]
                },
                "similarity_threshold": {
                  "type": ["number", "null"],
                  "description": "Threshold used for this projected evidence item when available."
                }
              }
            }
          }
        }
      }
    },
    "queue_memberships": {
      "type": "array",
      "description": "Curriculum review queues currently assigned by the local roster projection.",
      "items": {
        "type": "string",
        "enum": [
          "singleton-proposals",
          "hard-examples",
          "needs-confirmation-after-merge"
        ]
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp (ISO 8601)."
    },
    "source_version": {
      "type": "integer",
      "minimum": 0,
      "description": "Latest mirrored cluster snapshot version used to build this derived roster projection."
    },
    "projection_status": {
      "type": "string",
      "enum": ["current", "refreshing", "stale", "failed"],
      "description": "Freshness state of the local derived roster projection."
    },
    "projection_refreshed_at": {
      "type": ["string", "null"],
      "description": "Last local projection refresh timestamp, or null when the projection has never been refreshed."
    }
  }
}
