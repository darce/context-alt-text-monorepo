{
    "name": "context-alt-text",
    "version": "0.0.1",
    "description": "WordPress plugin configuration",
    "scripts": {
        "storybook": "storybook dev -p 6006",
        "storybook:build": "storybook build",
        "test": "vitest run",
        "test:watch": "vitest",
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
        "check:architecture": "node scripts/check-architecture-compliance.js",
        "check:all": "npm run lint && npm run check:architecture && npm run test",
        "nuke": "rm -rf node_modules public && npm install && npm run build && npm run storybook:build",
        "prepare": "husky"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^4.1.1",
        "@eslint/js": "^9.13.0",
        "@storybook/addon-docs": "^9.1.8",
        "@storybook/addon-onboarding": "^9.1.8",
        "@storybook/react-vite": "^9.1.8",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.0.0",
        "@types/node": "^24.7.2",
        "@types/react": "^18.3.1",
        "@types/react-dom": "^18.3.1",
        "@typescript-eslint/eslint-plugin": "^8.12.2",
        "@typescript-eslint/parser": "^8.12.2",
        "@vitejs/plugin-react": "^5.0.4",
        "axe-core": "^4.10.3",
        "eslint": "^9.13.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^5.0.0",
        "husky": "^9.1.7",
        "jsdom": "^25.0.1",
        "msw": "^2.11.3",
        "prettier": "^3.6.2",
        "prop-types": "^15.8.1",
        "sass": "^1.81.0",
        "sass-embedded": "^1.81.0",
        "storybook": "^9.1.8",
        "typescript": "^5.6.2",
        "typescript-eslint": "^8.12.2",
        "vite": "^7.1.7",
        "vitest": "^3.2.4",
        "vitest-axe": "^0.1.0"
    },
    "dependencies": {
        "@radix-ui/react-avatar": "^1.1.10",
        "@radix-ui/react-checkbox": "^1.3.3",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-form": "^0.1.8",
        "@radix-ui/react-icons": "^1.3.2",
        "@radix-ui/react-label": "^2.1.7",
        "@radix-ui/react-progress": "^1.0.3",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.7",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-tooltip": "^1.1.3",
        "@tanstack/react-query": "^5.59.9",
        "@wordpress/element": "^6.12.0",
        "@wordpress/i18n": "^5.1.1",
        "react-router-dom": "^7.9.3"
    },
    "engines": {
        "node": ">=22.18.0"
    }
}
