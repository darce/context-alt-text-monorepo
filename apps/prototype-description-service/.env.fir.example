# Isolated FIR/SFace 128d benchmark stack template for OCI VM (acx-dev-fir).
#
# Install at (the ONE runtime file; edit it in place):
#   /opt/acx-backend/dev-fir/.env        owner ubuntu:ubuntu, mode 0600
#   install -d -m 0755 /opt/acx-backend/dev-fir
#   install -m 0600 .env.fir.example /opt/acx-backend/dev-fir/.env
# Then replace every REPLACE_ME_DEV_FIR_PG with one fresh value that is not
# reused by any other env (PG-09), e.g. `openssl rand -hex 24`.
# Do NOT use a secrets/.env + symlink layout: recognition-service.sh rewrites
# .env with an atomic os.replace (image_repo_resource), which replaces the
# symlink with a regular file and leaves secrets/.env a stale copy (REF-09).
# Rotation + OCI Vault opt-in: apps/prototype-description-service/docs/secrets-inventory.md
#   § "Per-environment runtime files".
#
# This stack is intentionally separate from InsightFace acx-dev (512d). SFace is
# 128d; media_identities.embedding is dimension-pinned by PGVECTOR_DIM and the
# three-way guard assert_three_way_embedding_dimensions
# (face_pipeline_adapter.py:318-329). Both of the following are MANDATORY:
#   - PGVECTOR_DIM=128
#   - RECOGNITION_FACE_PIPELINE_PROFILE=face_pipeline
# Plus RECOGNITION_FACE_PIPELINE_MODELS_DIR must point under the compose mount
# (${ACX_MODELS_PATH}:/data/cache) so runtime ONNX loads from the volume, not
# the package DEFAULT_MODELS_DIR.
#
# DEV tier: inline plaintext secret placeholders (mirror acx-dev). Uses the env
# secret backend by default; the commented oci_vault block below is the opt-in.
# Auth disabled so LocalWP fir wiring needs no tenant key.
#
# Annotation format: `# domain: <n> | source: <owner> | consumer: <who reads it>`
# Cross-ref: apps/prototype-description-service/docs/secrets-inventory.md
#
# Do NOT commit secrets.

# ---------------------------------------------------------------------------
# Compose project identity (required by docker-compose.env.yml)
# ---------------------------------------------------------------------------
# domain: infra | source: OCI deploy | consumer: docker-compose.env.yml project identity
COMPOSE_PROJECT_NAME=acx-dev-fir
# domain: infra | source: OCI deploy | consumer: compose / deploy scripts (environment label)
ACX_ENV=dev-fir
# domain: infra | source: OCI deploy | consumer: compose image tag selection
# Independent :dev-fir tag promoted from :dev (SFace ONNX is volume-mounted, not baked in).
ACX_IMAGE_TAG=dev-fir
# domain: infra | source: OCI deploy | consumer: compose volume mount for Postgres data
ACX_PGDATA_PATH=/opt/acx-backend/data/dev-fir-pgdata
# domain: infra | source: OCI deploy | consumer: compose volume mount for model cache
ACX_MODELS_PATH=/opt/acx-backend/data/dev-models
# domain: infra | source: OCI deploy | consumer: compose network name
ACX_NETWORK_NAME=acx-dev-fir-net

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------
# domain: service root-of-trust (mode flag) | source: service operator | consumer: SecuritySettings / runtime mode gates; validate_required_secrets
RECOGNITION_RUNTIME_MODE=production
# domain: infra | source: OCI deploy | consumer: application logging config
LOG_LEVEL=INFO
# domain: infra | source: OCI deploy | consumer: runtime default tenant context (deploy bootstrap)
TENANT_ID=00000000-0000-7000-8000-000000000000

# ---------------------------------------------------------------------------
# Secret backend — DEV tier (env/plaintext; not OCI Vault)
# ---------------------------------------------------------------------------
# domain: infra (backend selector) | source: service operator | consumer: shared/secrets.py:get_secret_provider
RECOGNITION_SECRET_BACKEND=env
# OCI Vault opt-in (runbook: infra/oci/vault-instance-principal-runbook.md).
# oci_vault boot eagerly requires PGPASSWORD AND RECOGNITION_ADMIN_TOKEN
# (shared/secrets.py:validate_oci_vault_boot) even with /admin disabled, so both
# need dev-fir-only Vault secrets (names unique per vault, e.g.
# dev-fir-pg-password / dev-fir-admin-token); never point at prod's OCIDs.
# Then blank POSTGRES_DSN / POSTGRES_SYNC_DSN below and let the ExecStartPre
# hook fetch POSTGRES_PASSWORD (runbook § 4, with --secret-name dev-fir-pg-password).
# RECOGNITION_SECRET_BACKEND=oci_vault
# domain: infra (OCID map) | source: OCI deploy | consumer: shared/secrets.py:OciVaultSecretProvider.from_env
# RECOGNITION_VAULT_SECRET_MAP={"PGPASSWORD":"ocid1.vaultsecret.oc1..REPLACE_DEV_FIR","RECOGNITION_ADMIN_TOKEN":"ocid1.vaultsecret.oc1..REPLACE_DEV_FIR"}

# ---------------------------------------------------------------------------
# Postgres (used by compose for container bootstrap)
# ---------------------------------------------------------------------------
# domain: infra | source: OCI deploy | consumer: docker-compose Postgres bootstrap
POSTGRES_USER=acx_dev_fir
# domain: infra | source: OCI deploy (plaintext placeholder — replace on VM) | consumer: docker-compose Postgres bootstrap
POSTGRES_PASSWORD=REPLACE_ME_DEV_FIR_PG
# domain: infra | source: OCI deploy | consumer: docker-compose Postgres bootstrap (POSTGRES_DB)
POSTGRES_DB=alt_context_dev_fir

# ---------------------------------------------------------------------------
# Application database DSNs (inline plaintext placeholders — replace on VM)
# ---------------------------------------------------------------------------
# domain: infra | source: OCI deploy | consumer: db/settings.py:get_database_settings
POSTGRES_DSN=postgresql+asyncpg://acx_dev_fir:REPLACE_ME_DEV_FIR_PG@postgres:5432/alt_context_dev_fir
# domain: infra | source: OCI deploy | consumer: db/settings.py:get_database_settings
POSTGRES_SYNC_DSN=postgresql+psycopg://acx_dev_fir:REPLACE_ME_DEV_FIR_PG@postgres:5432/alt_context_dev_fir

# ---------------------------------------------------------------------------
# Face pipeline / embedding space (FIR stack — 128d SFace)
# ---------------------------------------------------------------------------
# Both profile + dim are required for the three-way guard
# (face_pipeline_adapter.py:318-329). Models dir must sit under the
# ACX_MODELS_PATH -> /data/cache volume mount.
# domain: recognition | source: OCI deploy | consumer: face_pipeline profile selection
RECOGNITION_FACE_PIPELINE_PROFILE=face_pipeline
# domain: infra | source: description-service / DB ops | consumer: db/settings.py pool/vector settings
PGVECTOR_DIM=128
# domain: recognition | source: OCI deploy | consumer: face_pipeline settings.resolved_models_dir
RECOGNITION_FACE_PIPELINE_MODELS_DIR=/data/cache/face_pipeline

# ---------------------------------------------------------------------------
# Cache directories (container-internal, mapped via volumes)
# ---------------------------------------------------------------------------
# domain: infra | source: OCI deploy | consumer: runtime cache path resolution
CACHE_BASE=/data/cache
# domain: infra | source: OCI deploy | consumer: HuggingFace hub cache
HF_HOME=/data/cache/huggingface_cache
# domain: infra | source: OCI deploy | consumer: HuggingFace hub cache
HF_HUB_CACHE=/data/cache/huggingface_cache
# domain: infra | source: OCI deploy | consumer: InsightFace model cache (unused on FIR profile)
INSIGHTFACE_CACHE_DIR=/data/cache/insightface
# domain: infra | source: OCI deploy | consumer: InsightFace home path (unused on FIR profile)
INSIGHTFACE_HOME=/data/cache/insightface

# ---------------------------------------------------------------------------
# Database pool tuning (sensible defaults; adjust for load)
# ---------------------------------------------------------------------------
# domain: infra | source: description-service / DB ops | consumer: db/settings.py pool settings
# DB_POOL_SIZE=20
# domain: infra | source: description-service / DB ops | consumer: db/settings.py pool settings
# DB_MAX_OVERFLOW=10
# domain: infra | source: description-service / DB ops | consumer: db/settings.py pool settings
# DB_POOL_TIMEOUT=30
# domain: infra | source: description-service / DB ops | consumer: db/settings.py pool settings
# DB_POOL_RECYCLE=3600

# ---------------------------------------------------------------------------
# Worker behavior
# ---------------------------------------------------------------------------
# domain: infra | source: service operator | consumer: recognition async analyze worker path
# RECOGNITION_ASYNC_ANALYZE_INLINE=0

# ---------------------------------------------------------------------------
# API security (recognition HTTP surface) — auth ON
# ---------------------------------------------------------------------------
# fir.dev.api.altcontext.com is a public vhost (Caddyfile): with auth off every
# recognition route is open to the internet with tenant scoping disabled, and
# FIRDV-1 readiness refuses it (validate_fir_dev_runtime.py: auth_disabled).
# Never set false on a stack behind a public vhost [SECD-05][SEC-01].
# domain: service root-of-trust (mode flag) | source: service operator | consumer: SecuritySettings.auth_enabled; HTTP auth deps
RECOGNITION_AUTH_ENABLED=true
# Tenant API keys are DB-only. /admin is off on this stack, so mint inside its
# api container. --env prod is the CLI's DSN-host guard label (the in-container
# DSN host is `postgres`), not the target env; the dev-fir compose project
# selects the dev-fir DB (infra/oci/README.md, reset step 8). The tenant UUID
# must equal the plugin's X-Tenant-ID; without an explicit ACX_RECOGNITION_TENANT_ID
# it derives from the WordPress site URL. Print it from the repo root:
#   python3 scripts/deploy/_derive_tenant_id.py http://localhost:10028
# Then on the VM (fir LocalWP values; set SITE_URL and T for another site):
#   SITE_URL=http://localhost:10028
#   T=fa22a16e-ec19-5e04-a49c-1f884914c945
#   cd /opt/acx-backend/dev-fir
#   sudo docker compose -f docker-compose.env.yml exec -T api python -m scripts.manage_api_keys --env prod tenant create --tenant "$T" --site-url "$SITE_URL" < /dev/null
#   sudo docker compose -f docker-compose.env.yml exec -T api python -m scripts.manage_api_keys --env prod create --tenant "$T" < /dev/null
# The raw key prints once. Keys live in this stack's DB: a pgdata reset orphans them.
# There is no env-var allowlist bypass (retired, decision #1882).
# domain: service root-of-trust (config) | source: service operator | consumer: HTTP auth dependency (API key header name)
RECOGNITION_API_KEY_HEADER=X-API-Key

# ---------------------------------------------------------------------------
# Operator /admin surface — disabled on FIR benchmark stack
# ---------------------------------------------------------------------------
# domain: service root-of-trust (flag) | source: service operator | consumer: SecuritySettings.admin_enabled; /admin router mount
RECOGNITION_ADMIN_ENABLED=false
# domain: service root-of-trust | source: service operator | consumer: SecuritySettings.admin_token; validate_admin_config; /admin deps
RECOGNITION_ADMIN_TOKEN=
# domain: service root-of-trust (ack) | source: service operator | consumer: validate_admin_config
RECOGNITION_ADMIN_TAILNET_BOUND=0
# domain: service root-of-trust (config) | source: service operator | consumer: API key hashing (SecuritySettings)
# RECOGNITION_API_KEY_HASH_ALGORITHM=sha256
# domain: service root-of-trust (config) | source: service operator | consumer: rate-limit middleware (SecuritySettings)
# RECOGNITION_RATE_LIMIT_RPM=60
# domain: service root-of-trust (config) | source: service operator | consumer: rate-limit middleware (SecuritySettings)
# RECOGNITION_RATE_LIMIT_BURST=10
# domain: service root-of-trust (config) | source: service operator | consumer: pagination bounds (SecuritySettings)
# RECOGNITION_MAX_PAGE_SIZE=500
# domain: service root-of-trust (config) | source: service operator | consumer: CORS middleware (SecuritySettings)
# RECOGNITION_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Image description (E19-1) — optional; FIR stack is recognition-benchmark first
# ---------------------------------------------------------------------------
# domain: infra | source: service operator | consumer: scene description adapter selection
# ACX_DESCRIPTION_ADAPTER=seeded
# domain: infra | source: service operator | consumer: VLM host runtime caps
# ACX_VLM_MAX_IMAGE_EDGE_PX=1024
# domain: infra | source: service operator | consumer: VLM host runtime caps
# ACX_VLM_TIMEOUT_SECONDS=20
# domain: infra | source: service operator | consumer: VLM host runtime caps
# ACX_VLM_MAX_RSS_MB=6144
# domain: infra | source: service operator | consumer: VLM host runtime caps
# ACX_VLM_WORKER_CONCURRENCY=1
# domain: infra | source: service operator | consumer: description request timeout
# ACX_DESCRIPTION_TIMEOUT_SECONDS=180
