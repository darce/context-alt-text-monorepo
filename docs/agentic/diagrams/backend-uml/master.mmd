flowchart LR
    %% ======================================================================
    %% RECOGNITION SERVICE - SYSTEM OVERVIEW
    %% Focus: Runtime components and their primary data flows
    %% ======================================================================

    subgraph Legend["Legend + Conventions"]
        direction TB
        LegendEntry["ENTRY: external entrypoint"]
        LegendOptional["Dashed arrow = optional wiring"]
    end

    subgraph Client["WordPress Workbench"]
        direction TB
        AdminUI["ENTRY: Admin SPA"]
        WPProxy["ENTRY: WP REST proxy<br/>/wp-json/acx/v1/recognition/*"]
    end

    subgraph API["Recognition API (FastAPI)"]
        direction TB
        Routers["ENTRY: /recognition/* routers<br/>analyze, clusters, suggestions,<br/>media, diagnostics, events, health"]
        Auth["Auth + tenant guards<br/>Authorization Bearer + X-Tenant-ID"]
        Services["Application services<br/>ScanQueueService, ClusterService,<br/>SuggestionService, JobService"]
        SSE["ENTRY: SSE stream<br/>/recognition/clusters/events"]
    end

    subgraph Worker["Async Scan Worker"]
        direction TB
        ScanWorker["scan_worker.py<br/>claims scan items + curation jobs"]
        ScanService["ScanService<br/>FaceDetector + EmbeddingGenerator"]
    end

    subgraph Data["Data Plane"]
        direction TB
        DB["Postgres + pgvector<br/>RLS tenant isolation"]
        Thumbs["Thumbnail storage"]
        Models["InsightFace model cache"]
    end

    AdminUI --> WPProxy --> Routers
    Routers --> Auth --> Services
    Services --> DB
    Routers --> SSE --> AdminUI

    Services -->|"enqueue scan jobs"| DB
    DB -->|"scan queue items"| ScanWorker
    ScanWorker --> ScanService --> Models
    ScanService --> DB
    ScanService --> Thumbs

    Services -.->|"observability logs<br/>assignment_decisions + recognition_events"| DB

    RouterCode["Code anchors:\nrecognition/interface_adapters/http/routers/*\nrecognition/interface_adapters/http/deps/services.py\nrecognition/infrastructure/repositories/*"]
    Routers -.-> RouterCode
