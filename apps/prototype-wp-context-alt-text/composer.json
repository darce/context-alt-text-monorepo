{
    "name": "darce/context-alt-text",
    "description": "A WordPress plugin that generates contextually relevant alt text for images using AI-powered recognition services.",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.0"
    },
    "autoload": {
        "psr-4": {
            "CAT\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "php-stubs/wordpress-stubs": "^6.8"
    },
    "autoload-dev": {
        "psr-4": {
            "CAT\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf"
    }
}
