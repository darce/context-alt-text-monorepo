{
  "mcpServers": {
    "agent-handoff-mcp": {
      "type": "stdio",
      "command": "agent-handoff-mcp",
      "args": [
        "--workspace-root",
        ".",
        "serve-stdio"
      ],
      "env": {
        "PYENV_VERSION": "description-service",
        "AGENT_HANDOFF_ENFORCE_BRANCH": "1"
      }
    },
    "agent-orchestrator-mcp": {
      "type": "stdio",
      "command": "agent-orchestrator-mcp",
      "args": [
        "--workspace-root",
        ".",
        "serve-stdio"
      ],
      "env": {
        "PYENV_VERSION": "description-service",
        "AGENT_HANDOFF_ENFORCE_BRANCH": "1"
      }
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@2.1.4"]
    }
  }
}
