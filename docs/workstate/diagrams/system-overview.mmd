    subgraph WordPress["WordPress Plugin (prototype-wp-alt-context)"]
        subgraph ReactUI["React Admin UI"]
            Dashboard["DashboardPage"]
            Workbench["WorkbenchPage<br/>scan + confirm"]
            Roster["RosterPage<br/>entries + clusters"]
            Retention["RetentionPage<br/>governance + audit"]
            ConflictInbox["ConflictInbox"]
            DeadLetterPanel["DeadLetterPanel"]
            SyncHealth["SyncStatusIndicator"]
        end

        subgraph Hooks["React Hooks / Page State"]
            JobHistory["useRecognitionJobHistory"]
            WorkbenchMedia["useWorkbenchMedia"]
            Selection["useMediaSelectionState"]
            Filters["useWorkbenchFilters"]
