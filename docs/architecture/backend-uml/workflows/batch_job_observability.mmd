%%{init: {"theme": "base", "sequence": {"mirrorActors": false}}}%%
sequenceDiagram
    autonumber
    
    participant Job as ClusteringJobService
    participant Logger as ClusteringLogger
    participant Gate as AssignmentGate
    participant Viz as ClusterVisualizer
    participant FS as FileSystem (logs/)
    
    Note over Job,FS: Batch Job with Observability Integration
    
    %% Job Start
    Job->>Logger: __init__(algorithm="HDBSCAN", job_id)
    Job->>Logger: log_batch_start(identity_count=150, algorithm="HDBSCAN")
    Logger-->>Logger: Log: "Starting HDBSCAN batch job with 150 identities"
    
    rect rgb(40, 40, 80)
        Note over Job,Logger: Discovery Phase - Log Candidates
        loop For each candidate
            Job->>Logger: log_candidate_generated(candidate)
            Logger-->>Logger: Log: "[HDBSCAN] Candidate: identity=X → cluster=Y, sim=0.87"
        end
    end
    
    rect rgb(40, 80, 40)
        Note over Job,Gate: Evaluation Phase - Log Decisions
        loop For each candidate
            Job->>Gate: evaluate(candidate)
            Gate->>Logger: log_check_result("complete_link", passed=true, {min_sim: 0.78})
            Gate->>Logger: log_check_result("maturity", passed=true, {rep_count: 3})
            Gate-->>Job: AssignmentDecision(ACCEPT|SUGGEST|REJECT)
            
            alt Decision = ACCEPT
                Job->>Logger: log_decision(identity_id, cluster_id, ACCEPT, sim=0.87)
                Logger-->>Logger: Log: "[HDBSCAN] ACCEPT: identity X → cluster Y (sim=0.87)"
            else Decision = SUGGEST
                Job->>Logger: log_decision(identity_id, cluster_id, SUGGEST, sim=0.83, reason="borderline")
                Logger-->>Logger: Log: "[HDBSCAN] SUGGEST: identity X → cluster Y (sim=0.83, borderline)"
            else Decision = REJECT
                Job->>Logger: log_decision(identity_id, None, REJECT, sim=0.71, reason="below threshold")
                Logger-->>Logger: Log: "[HDBSCAN] REJECT: identity X (sim=0.71, below threshold)"
            end
        end
    end
    
    rect rgb(80, 40, 80)
        Note over Job,FS: Completion Phase - Generate Report & Chart
        Job->>Job: Build BatchJobReport
        Note right of Job: accept_count: 120<br/>suggest_count: 18<br/>reject_count: 12
        
        Job->>Logger: log_batch_complete(report)
        Logger-->>Logger: Log: "[HDBSCAN] Batch complete: 120 accepted, 18 suggested, 12 rejected"
        
        Job->>Viz: generate_batch_report_chart(report, algorithm="HDBSCAN")
        Note over Viz: Chart title: "[HDBSCAN] Batch Job Summary"<br/>Subtitle: "Accepted: 120 | Suggested: 18 | Rejected: 12"
        Viz->>FS: Save batch_job123_2025-12-01_143215.png
        FS-->>Viz: Path to saved chart
        Viz-->>Job: Path("/logs/charts/batch_job123_2025-12-01_143215.png")
        
        Job->>Logger: log_batch_start(identity_count=0, algorithm="HDBSCAN")
        Logger-->>Logger: Log: "[HDBSCAN] Chart saved: /logs/charts/batch_job123_2025-12-01_143215.png"
    end
    
    Note over Job,FS: Every batch job produces:<br/>1. Structured decision logs (accept/suggest/reject)<br/>2. Chart with algorithm name + decision breakdown
