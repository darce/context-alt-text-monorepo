flowchart LR
%% Workbench -> WP REST proxy -> Recognition service (current endpoints)

subgraph Workbench["Admin SPA (React)"]
    selectMedia["MediaSelection\n(useWorkbenchMedia)"]
    scanActions["ScanActionPanel\nscanFaces()"]
    statusPanel["RecentJobsPanel\npoll useScanStatus/useMultiScanStatus"]
    clusterPanel["BatchPanel\nclusterFaces()"]
    clusterList["IdentityClusterList\nuseRecognitionClusters"]
    suggestions["SuggestionReviewPanel\npending suggestions"]
end

subgraph WPProxy["WP REST proxy (PHP)"]
    postAnalyze["POST /recognition/analyze"]
    getJob["GET /recognition/jobs/{id}"]
    postCluster["POST /recognition/clustering/jobs"]
    getClusters["GET /recognition/clusters"]
    getSuggestions["GET /recognition/suggestions"]
    actSuggestion["POST /recognition/suggestions/{id}/accept|reject"]
end

subgraph Recognition["Prototype Description Service"]
    analyze["/recognition/analyze\nBackgroundTasks chunking"]
    jobStatus["/recognition/jobs/{id}\nIdentityScanJob"]
    clustering["/recognition/clustering/jobs\nIdentityClusteringService"]
    clusters["/recognition/clusters\n+ /clusters/labels"]
    suggestionsApi["/recognition/suggestions\nSuggestionService"]
end

selectMedia --> scanActions
scanActions --> postAnalyze
postAnalyze --> analyze
analyze --> jobStatus
statusPanel --> getJob
getJob --> jobStatus
statusPanel --> clusterPanel
clusterPanel --> postCluster
postCluster --> clustering
clustering --> clusters
clusters --> getClusters
getClusters --> clusterList
clusterList --> suggestions
suggestions --> getSuggestions
getSuggestions --> suggestionsApi
suggestions --> actSuggestion
actSuggestion --> suggestionsApi
actSuggestion --> getClusters
style Workbench fill:#ffffff,stroke:#000000,color:#000000,stroke-width:2px
style WPProxy fill:#e0e0e0,stroke:#000000,color:#000000,stroke-width:2px
style Recognition fill:#cccccc,stroke:#000000,color:#000000,stroke-width:2px
