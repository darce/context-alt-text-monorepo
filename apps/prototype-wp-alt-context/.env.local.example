# LocalWP-only Playwright auth bootstrap placeholders for E15-6.
# Copy this file to .env.local and fill in real values before running
# the auth bootstrap described in docs/playwright-localwp-evidence.md.

ACX_E2E_WP_ADMIN_USER=
ACX_E2E_WP_ADMIN_PASS=

# Optional LocalWP site root override. Defaults to http://localhost:10010.
# WP_BASE_URL=http://localhost:10010

# Optional: opt into seeded-state a11y assertions in route-level axe specs.
# ACX_E2E_SEEDED=1

# Optional: scope Playwright artifacts under local/playwright/<task-ref>/.
# Typically passed inline (ACX_PLAYWRIGHT_TASK_REF=E15-3a npm run e2e:evidence).
# ACX_PLAYWRIGHT_TASK_REF=adhoc

# Optional E15-22 workbench evidence overrides (service mode is opt-in):
# Never commit a real key — copy this file to .env.local (gitignored) before filling values.
# ACX_E2E_ENSURE_SERVICE_MODE=1
# ACX_E2E_RECOGNITION_URL=https://api.altcontext.com
# ACX_E2E_RECOGNITION_API_KEY=
