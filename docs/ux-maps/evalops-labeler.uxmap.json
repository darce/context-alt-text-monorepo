{
  "schema_version": 1,
  "map_ref": "evalops-labeler",
  "product": "Private finding review",
  "goals": [
    "Record defect validity separately from action-scoped blocking disposition with durable history",
    "Record human annotation provenance and exposure without claiming independent gold"
  ],
  "jobs": [
    {
      "id": "review",
      "label": "Review evidence and record validity, action disposition and provenance"
    }
  ],
  "screens": [
    {
      "id": "session",
      "kind": "screen",
      "title": "Start a review",
      "purpose": "Identify annotator; explain the frozen rubric, protocol and provenance boundaries",
      "route": "/#session",
      "job_entry": true,
      "deep_link": false,
      "url_params": [],
      "primary_action_id": "start",
      "states": [
        "default",
        "loading",
        "empty",
        "error",
        "offline",
        "first_time",
        "edge_input",
        "degraded"
      ],
      "zones": [
        {
          "id": "identity",
          "label": "Reviewer identity (required)",
          "role": "form",
          "states": [
            "default",
            "loading",
            "empty",
            "error",
            "offline",
            "edge_input"
          ]
        },
        {
          "id": "rubric",
          "label": "Rubric and session purpose",
          "role": "content",
          "states": [
            "default",
            "loading",
            "empty",
            "error",
            "offline",
            "edge_input"
          ]
        }
      ]
    },
    {
      "id": "finding",
      "kind": "screen",
      "title": "Review finding",
