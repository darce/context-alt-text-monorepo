```mermaid
---
title: AssignmentGate Class Diagram (Unified Validation)
---
classDiagram
    direction TB
    
    %% Core Gate Classes
    class AssignmentGate {
        -settings: ClusteringSettings
        -cluster_repository: ClusterRepository
        -checks: list~BaseCheck~
        +evaluate(candidate: AssignmentCandidate) AssignmentDecision
        -_load_cluster_data(cluster_id: UUID) ClusterData
    }

    class AssignmentCandidate {
        +identity: MediaIdentity
        +identity_vector: ndarray
        +cluster_id: UUID
        +discovery_method: DiscoveryMethod
        +discovery_similarity: float
    }

    class AssignmentDecision {
        +outcome: AssignmentOutcome
        +candidate: AssignmentCandidate
        +checks_passed: list~str~
        +checks_failed: list~str~
        +rejection_reason: str?
        +suggestion_confidence: float?
    }

    class AssignmentOutcome {
        <<enumeration>>
        ACCEPT
        SUGGEST
        REJECT
    }

    class DiscoveryMethod {
        <<enumeration>>
        REPRESENTATIVE
        CENTROID
        GRAPH
    }

    %% Check Classes
    class BaseCheck {
        <<abstract>>
        +name: str
        +settings: ClusteringSettings
        +is_enabled() bool
        +evaluate(candidate, cluster_data) CheckResult*
    }

    class CheckResult {
        +passed: bool
        +is_fatal: bool
        +should_reject: bool
        +reason: str?
        +metrics: dict?
    }

    class MaturityCheck {
        +name = "maturity"
        +evaluate(candidate, cluster_data) CheckResult
        -_count_diverse_reps(cluster_data) int
    }

    class CompleteLinkCheck {
        +name = "complete_link"
        +min_floor: float
        +avg_threshold: float
        +evaluate(candidate, cluster_data) CheckResult
        -_compute_similarities(vec, reps) tuple~float,float~
    }

    class MemberDistributionCheck {
        +name = "member_distribution"
        +avg_threshold: float
        +min_floor: float
        +evaluate(candidate, cluster_data) CheckResult
        -_sample_members(cluster_data) list~ndarray~
    }

    class ConfidenceCheck {
        +name = "confidence"
        +high_confidence_threshold: float
        +suggestion_threshold: float
        +evaluate(candidate, cluster_data) CheckResult
    }

    %% Discovery Classes
    class RepresentativeDiscovery {
        +threshold: float
        +discover(identities, reps_by_cluster) list~AssignmentCandidate~
        -_find_best_match(vec, reps) tuple~UUID,float~
    }

    class CentroidDiscovery {
        +threshold: float
        +discover(identities, centroids) list~AssignmentCandidate~
    }

    class GraphDiscovery {
        +threshold: float
        +algorithm: HDBSCAN|ChineseWhispers
        +discover(identities, anchors) list~AssignmentCandidate~
        -_match_to_anchor(members, anchors) tuple~UUID,float~
    }

    %% Writer Classes
    class AssignmentWriter {
        +session: AsyncSession
        +tenant_id: UUID
        +assign(candidate: AssignmentCandidate) None
        +add_representative(cluster_id, identity) None
    }

    %% Relationships
    AssignmentGate --> AssignmentCandidate : evaluates
    AssignmentGate --> AssignmentDecision : returns
    AssignmentGate *-- BaseCheck : contains checks
    AssignmentDecision --> AssignmentOutcome : has outcome
    AssignmentCandidate --> DiscoveryMethod : has method

    BaseCheck <|-- MaturityCheck : extends
    BaseCheck <|-- CompleteLinkCheck : extends
    BaseCheck <|-- MemberDistributionCheck : extends
    BaseCheck <|-- ConfidenceCheck : extends
    BaseCheck --> CheckResult : returns

    RepresentativeDiscovery --> AssignmentCandidate : produces
    CentroidDiscovery --> AssignmentCandidate : produces
    GraphDiscovery --> AssignmentCandidate : produces

    AssignmentWriter --> AssignmentCandidate : persists
```
