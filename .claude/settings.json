{
  "_managed_by": "workbay-bootstrap",
  "extraKnownMarketplaces": {
    "workbay-marketplace": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  },
  "enabledPlugins": {
    "workbay-system@workbay-marketplace": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|apply_patch|create_file|replace_string_in_file|multi_replace_string_in_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-worktree-drift.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|apply_patch|create_file|replace_string_in_file|multi_replace_string_in_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-main-branch.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-bash-main-branch.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-bash-lifecycle-primitives.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-bash-remote-gate-routing.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/hooks/_launch_python.sh\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/_run_guard.py\" --fail-mode=closed --policy-aware \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-codemap-first.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-task-plan-findings.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-generated-render-write.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-network-sourced-authority.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-agent-remote-only-implementation.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__workbay-handoff-mcp__record_event|mcp__workbay-handoff-mcp__close_slice",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-rationale-size.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__workbay-handoff-mcp__record_event|mcp__workbay-handoff-mcp__review_findings|mcp__workbay-handoff-mcp__review_runs",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/validate-mcp-dict-params.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__workbay-handoff-mcp__review_findings",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-review-finding-resolve.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/record-file-touch.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__workbay-handoff-mcp__review_findings",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/ace-detect.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__workbay-handoff-mcp__get_handoff_state|mcp__workbay-handoff-mcp__load_session|mcp__workbay-handoff-mcp__render_handoff",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/slim-handoff-response.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/filter-test-output.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/capture-agent-errors.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/ensure-agent-surfaces.sh\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/advise-worktree-cd.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/coherence-self-check.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/advise-worktree-cd.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push *)",
      "Bash(make task-finish *)",
      "Bash(git branch -D *)",
      "Bash(git worktree remove *)",
      "Bash(git reset --hard *)",
      "Bash(make lane-reap *)"
    ],
    "ask": [
      "Bash(make release-* *)",
      "Bash(scripts/release.sh *)",
      "Bash(make slice-start *)",
      "mcp__workbay-handoff-mcp__archive",
      "mcp__workbay-handoff-mcp__import_handoff_state",
      "mcp__workbay-handoff-mcp__set_handoff_state"
    ],
    "allow": [
      "mcp__workbay-handoff-mcp__get_handoff_state",
      "mcp__workbay-handoff-mcp__integrity_check",
      "mcp__workbay-handoff-mcp__export_handoff_state",
      "mcp__workbay-handoff-mcp__get_verified_tests",
      "mcp__workbay-handoff-mcp__load_session",
      "mcp__workbay-handoff-mcp__audit_decision_ids",
      "mcp__workbay-handoff-mcp__list_handoff_rows",
      "mcp__workbay-handoff-mcp__validate",
      "mcp__workbay-handoff-mcp__search_handoff",
      "mcp__workbay-handoff-mcp__find_related_prior_work",
      "mcp__workbay-handoff-mcp__list_tool_domains",
      "mcp__workbay-handoff-mcp__record_event",
      "mcp__workbay-handoff-mcp__review_findings",
      "mcp__workbay-handoff-mcp__close_slice",
      "mcp__workbay-orchestrator-mcp__get_latest_slice_review_packet",
      "mcp__workbay-orchestrator-mcp__get_review_findings_summary",
      "mcp__workbay-orchestrator-mcp__list_worktree_lanes",
      "mcp__workbay-orchestrator-mcp__get_lane_activity",
      "mcp__workbay-orchestrator-mcp__list_lane_messages",
      "mcp__workbay-orchestrator-mcp__list_lane_briefs",
      "mcp__workbay-orchestrator-mcp__list_worker_reports",
      "mcp__workbay-orchestrator-mcp__get_plan_cursor",
      "mcp__workbay-orchestrator-mcp__list_plan_cursors",
      "mcp__workbay-orchestrator-mcp__list_turn_metrics",
      "mcp__workbay-orchestrator-mcp__get_turn_metrics_summary",
      "mcp__workbay-orchestrator-mcp__orchestrator_status",
      "mcp__workbay-orchestrator-mcp__worker_status",
      "mcp__workbay-orchestrator-mcp__worker_event_history",
      "mcp__workbay-orchestrator-mcp__list_available_backends",
      "mcp__workbay-orchestrator-mcp__lane_dag",
      "mcp__workbay-orchestrator-mcp__get_metrics_summary",
      "mcp__workbay-orchestrator-mcp__list_tool_domains",
      "Bash(make context)",
      "Bash(make tasks)",
      "Bash(make slice-commit)",
      "Bash(make check-agent-workflows)",
      "Bash(make check-all)",
      "Bash(make check-bootstrap)",
      "Bash(make check-claude-settings-pin)",
      "Bash(make check-consumer-install)",
      "Bash(make check-dev-editables)",
      "Bash(make check-disk-space)",
      "Bash(make check-duplicate-test-basenames)",
      "Bash(make check-git-overlay-install)",
      "Bash(make check-handoff)",
      "Bash(make check-harness-coherence)",
      "Bash(make check-harness-sync)",
      "Bash(make check-hook-twin-parity)",
      "Bash(make check-hooks)",
      "Bash(make check-legacy-overlay-guard)",
      "Bash(make check-make-version)",
      "Bash(make check-mcp-pins)",
      "Bash(make check-overlay-drift)",
      "Bash(make check-overlay-gates)",
      "Bash(make check-protocol)",
      "Bash(make check-release-manifest)",
      "Bash(make check-release-tag-provenance)",
      "Bash(make check-release-version-drift)",
      "Bash(make check-remote)",
      "Bash(make check-review-pipeline)",
      "Bash(make check-runtime-state)",
      "Bash(make check-system)",
      "Bash(make check-system-integration)",
      "Bash(make check-telemetry-fresh)",
      "Bash(make check-uvlock-current)",
      "Bash(make check-workbay)",
      "Bash(make test-bridge)",
      "Bash(make test-contract)",
      "Bash(make test-handoff)",
      "Bash(make test-orchestrator)",
      "Bash(make test-rehearsal)",
      "Bash(make test-tier-e2e)",
      "Bash(make test-tier-fast)"
    ]
  }
}
